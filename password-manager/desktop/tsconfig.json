{
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"composite": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"checkJs": true,
		"types": [
			"svelte"
		],
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@osvauld/password-manager-common": [
				"../../common"
			],
			"@osvauld/password-manager-common/*": [
				"../../common/*"
			]
		},
		"allowJs": true,
		"isolatedModules": true
	},
	"include": [
		"components/**/*.ts",
		"components/**/*.svelte",
		"store/*.ts",
		"*.ts",
		"*.svelte",
		"../common/**/*.ts",
		"../common/**/*.svelte"
	],
	"exclude": [
		"node_modules/*",
	],
	"references": [
		{
			"path": "../../common"
		}
	]
}
