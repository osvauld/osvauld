{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "libremot",
  "version": "0.1.0",
  "identifier": "com.libremot.app",
  "build": {
    "beforeDevCommand": "cd ./frontend/desktop && pnpm dev",
    "beforeBuildCommand": "cd ./frontend/desktop && pnpm build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../frontend/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "libremot",
        "width": 1920,
        "height": 1080,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "signingIdentity": "XXXX",
      "providerShortName": "XXX",
      "entitlements": "./Entitlements.plist",
      "exceptionDomain": "",
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "13"
    }
  }
}
