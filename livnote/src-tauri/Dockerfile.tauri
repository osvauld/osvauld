FROM ghcr.io/cross-rs/armv7-unknown-linux-gnueabihf:edge

# Install Node.js 18 for frontend builds
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Install Rust and Cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Add ARM target
RUN rustup target add armv7-unknown-linux-gnueabihf

# Install Tauri CLI
RUN cargo install tauri-cli --version ^2.0

# Install ARM development libraries for Tauri
RUN dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y \
    libglib2.0-dev:armhf \
    libgtk-3-dev:armhf \
    libwebkit2gtk-4.0-dev:armhf \
    libappindicator3-dev:armhf \
    librsvg2-dev:armhf \
    libssl-dev:armhf \
    libayatana-appindicator3-dev:armhf \
    libxdo-dev:armhf \
    libsoup2.4-dev:armhf \
    pkg-config \
    build-essential

# Configure environment for cross-compilation
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_PATH="/usr/lib/arm-linux-gnueabihf/pkgconfig:/usr/share/pkgconfig"
ENV PKG_CONFIG_SYSROOT_DIR="/usr/arm-linux-gnueabihf"
ENV CC_armv7_unknown_linux_gnueabihf="arm-linux-gnueabihf-gcc"
ENV CXX_armv7_unknown_linux_gnueabihf="arm-linux-gnueabihf-g++"
ENV AR_armv7_unknown_linux_gnueabihf="arm-linux-gnueabihf-ar"
ENV STRIP_armv7_unknown_linux_gnueabihf="arm-linux-gnueabihf-strip"

# Set working directory
WORKDIR /workspace

# Default command
CMD ["bash"]
