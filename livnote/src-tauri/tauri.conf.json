{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "livnote",
  "version": "0.1.0",
  "identifier": "com.livnote.app",
  "build": {
    "beforeDevCommand": "cd ./frontend/desktop && pnpm dev",
    "beforeBuildCommand": "cd ./frontend/desktop && pnpm build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../frontend/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "livnote",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
