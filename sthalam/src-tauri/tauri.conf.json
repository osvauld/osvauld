{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "sthalam",
  "version": "0.1.0",
  "identifier": "com.sthalam.app",
  "build": {
    "beforeDevCommand": "cd ./frontend/desktop && pnpm dev",
    "beforeBuildCommand": "cd ./frontend/desktop && pnpm build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../frontend/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sthalam",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost http://localhost:1422; script-src 'self' 'wasm-unsafe-eval' asset: https://asset.localhost http://localhost:1422; style-src 'self' 'unsafe-inline' http://localhost:1422; img-src 'self' data: blob: asset: https://asset.localhost http://localhost:1422; media-src * blob: data: 'self' 'unsafe-inline'; connect-src 'self' asset: https://asset.localhost http://localhost:1422 ws://localhost:1422",
      "assetProtocol": {
        "scope": {
          "allow": ["**"]
        },
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../frontend/desktop/dist/cel_eval.js",
      "../frontend/desktop/dist/cel_wasm.bc.wasm.js",
      "../frontend/desktop/dist/cel_wasm.bc.wasm.assets",
      "../frontend/desktop/dist/huml_parser.js",
      "../frontend/desktop/dist/parser_wasm.bc.wasm.js",
      "../frontend/desktop/dist/parser_wasm.bc.wasm.assets",
      "../frontend/desktop/dist/pixelated-tree.svg",
      "../frontend/desktop/dist/vite.svg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
