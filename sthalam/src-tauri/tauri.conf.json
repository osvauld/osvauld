{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "sthalam",
  "version": "0.1.0",
  "identifier": "com.sthalam.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ./frontend/desktop && pnpm build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../frontend/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sthalam",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:1422; script-src 'self' 'wasm-unsafe-eval' http://localhost:1422; style-src 'self' 'unsafe-inline' http://localhost:1422; img-src 'self' data: asset: https://asset.localhost http://localhost:1422; connect-src 'self' asset: https://asset.localhost http://localhost:1422 ws://localhost:1422",
      "assetProtocol": {
        "scope": {
          "allow": ["**"]
        },
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
