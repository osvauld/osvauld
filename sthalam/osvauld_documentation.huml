name: "Osvauld Documentation"

screens::
  - ::
    id: "home"
    name: "Home"
    isEntryPoint: true
    css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 0; margin: 0; font-family: system-ui, -apple-system, sans-serif;"
    children::
      # Navigation Bar
      - ::
        type: "section-container"
        name: "Navigation Bar"
        css: "background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100;"
        children::
          - ::
            type: "heading"
            content: "Osvauld"
            css: "color: white; font-size: 28px; font-weight: 700; margin: 0;"
          - ::
            type: "section-container"
            name: "Nav Links"
            css: "display: flex; gap: 20px;"
            children::
              - ::
                type: "nav-button"
                content: "Docs"
                targetContainerId: "home"
                css: "background: transparent; color: white; padding: 8px 16px; border: 1px solid rgba(255,255,255,0.3); border-radius: 6px; font-size: 14px; cursor: pointer; transition: all 0.3s;"
              - ::
                type: "nav-button"
                content: "GitHub"
                targetContainerId: "home"
                css: "background: rgba(255,255,255,0.2); color: white; padding: 8px 16px; border: none; border-radius: 6px; font-size: 14px; cursor: pointer; transition: all 0.3s;"

      # Hero Section
      - ::
        type: "section-container"
        name: "Hero Section"
        css: "max-width: 1200px; margin: 0 auto; padding: 80px 40px; text-align: center;"
        children::
          - ::
            type: "heading"
            content: "Osvauld"
            css: "color: white; font-size: 64px; font-weight: 800; margin-bottom: 20px; letter-spacing: -1px;"
          - ::
            type: "text"
            content: "Guides, resources, and API references to help you build with osvauld."
            css: "color: rgba(255,255,255,0.95); font-size: 22px; margin-bottom: 50px; line-height: 1.6; max-width: 700px; margin-left: auto; margin-right: auto;"

          # Action Buttons Grid
          - ::
            type: "section-container"
            name: "Action Buttons"
            css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; max-width: 900px; margin: 0 auto 60px auto;"
            children::
              - ::
                type: "nav-button"
                content: "📖 Manifesto"
                targetContainerId: "manifesto"
                css: "background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: white; padding: 20px 30px; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center;"
              - ::
                type: "nav-button"
                content: "🔍 What Makes This Possible"
                targetContainerId: "what-makes-possible"
                css: "background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: white; padding: 20px 30px; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center;"
              - ::
                type: "nav-button"
                content: "🌐 Website"
                targetContainerId: "home"
                css: "background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: white; padding: 20px 30px; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center;"
              - ::
                type: "nav-button"
                content: "📱 Community"
                targetContainerId: "home"
                css: "background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); color: white; padding: 20px 30px; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center;"

          # Main Documentation Sections
          - ::
            type: "section-container"
            name: "Documentation Sections"
            css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; margin-top: 60px;"
            children::
              - ::
                type: "section-container"
                name: "Sthalam Card"
                css: "background: white; border-radius: 16px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); transition: transform 0.3s; cursor: pointer;"
                children::
                  - ::
                    type: "heading"
                    content: "Project Sthalam"
                    css: "color: #667eea; font-size: 28px; font-weight: 700; margin-bottom: 15px;"
                  - ::
                    type: "text"
                    content: "A sovereign publishing platform for creating and distributing content without intermediaries. Build websites, micro-blogs, and newsletters."
                    css: "color: #4a5568; font-size: 16px; line-height: 1.6; margin-bottom: 25px;"
                  - ::
                    type: "nav-button"
                    content: "Learn More →"
                    targetContainerId: "sthalam-intro"
                    css: "background: #667eea; color: white; padding: 12px 28px; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; width: 100%;"

              - ::
                type: "section-container"
                name: "Livnote Card"
                css: "background: white; border-radius: 16px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); transition: transform 0.3s; cursor: pointer;"
                children::
                  - ::
                    type: "heading"
                    content: "Livnote"
                    css: "color: #667eea; font-size: 28px; font-weight: 700; margin-bottom: 15px;"
                  - ::
                    type: "text"
                    content: "Peer-to-peer collaborative note-taking with real-time synchronization. Create your identity and connect with peers securely."
                    css: "color: #4a5568; font-size: 16px; line-height: 1.6; margin-bottom: 25px;"
                  - ::
                    type: "nav-button"
                    content: "Learn More →"
                    targetContainerId: "livnote-intro"
                    css: "background: #667eea; color: white; padding: 12px 28px; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; width: 100%;"

              - ::
                type: "section-container"
                name: "Sovereign Node Card"
                css: "background: white; border-radius: 16px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); transition: transform 0.3s; cursor: pointer;"
                children::
                  - ::
                    type: "heading"
                    content: "Sovereign Node"
                    css: "color: #667eea; font-size: 28px; font-weight: 700; margin-bottom: 15px;"
                  - ::
