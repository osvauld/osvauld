  # Sthalam Forms Screen
  - ::
    id: "sthalam-forms"
    name: "Forms & Submissions"
    css: "background: #f7fafc; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;"
    children::
      - ::
        type: "section-container"
