name: "Tech Conference 2025 Registration System"

# Form metadata - defining all three registration forms
forms::
  - ::
    id: "form-student"
    name: "Student Registration Form"
    description: "Registration for students with educational discounts"
    submitButtonText: "Complete Student Registration"
    submissionMessage: "Thank you! Your student registration is confirmed."

  - ::
    id: "form-professional"
    name: "Professional Registration Form"
    description: "Registration for professional attendees"
    submitButtonText: "Complete Professional Registration"
    submissionMessage: "Thank you! Your professional registration is confirmed."

  - ::
    id: "form-workshop"
    name: "Workshop Leader Registration Form"
    description: "Registration for workshop leaders and speakers"
    submitButtonText: "Complete Workshop Leader Registration"
    submissionMessage: "Thank you! Your workshop leader registration is confirmed."

screens::
  - ::
    id: "main"
    name: "Tech Conference 2025"
    isEntryPoint: true
    children::
      # Main welcome screen
      - ::
        id: "welcome-section"
        type: "section-container"
        name: "Welcome Section"
        css: "background: #1e1e2e; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 40px 20px;"
        children::
          - ::
            type: "heading"
            content: "🎯 Tech Conference 2025"
            css: "color: #cdd6f4; font-size: 48px; font-weight: 800; margin-bottom: 20px; text-align: center;"

          - ::
            type: "text"
            content: "March 15-17, 2025 • San Francisco, CA"
            css: "color: #89b4fa; font-size: 24px; margin-bottom: 15px; text-align: center;"

          - ::
            type: "text"
            content: "Select your registration type to get started:"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 40px; text-align: center;"

          # Registration type selection buttons with gradients
          - ::
            type: "section-container"
            name: "Registration Type Buttons"
            css: "display: flex; flex-direction: column; gap: 20px; max-width: 500px; width: 100%;"
            children::
              - ::
                type: "nav-button"
                content: "🎓 Student Registration (Discounted)"
                targetContainerId: "student-screen-1"
                css: "background: linear-gradient(135deg, #89b4fa 0%, #b4befe 100%); color: #1e1e2e; padding: 20px 40px; border-radius: 12px; font-size: 18px; font-weight: 700; border: none; cursor: pointer; transition: transform 0.2s; box-shadow: 0 4px 15px rgba(137, 180, 250, 0.3);"

              - ::
                type: "nav-button"
                content: "💼 Professional Registration (Full Access)"
                targetContainerId: "professional-screen-1"
                css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 20px 40px; border-radius: 12px; font-size: 18px; font-weight: 700; border: none; cursor: pointer; transition: transform 0.2s; box-shadow: 0 4px 15px rgba(166, 227, 161, 0.3);"

              - ::
                type: "nav-button"
                content: "🎤 Workshop Leader (Free + Benefits)"
                targetContainerId: "workshop-screen-1"
                css: "background: linear-gradient(135deg, #f9e2af 0%, #fab387 100%); color: #1e1e2e; padding: 20px 40px; border-radius: 12px; font-size: 18px; font-weight: 700; border: none; cursor: pointer; transition: transform 0.2s; box-shadow: 0 4px 15px rgba(249, 226, 175, 0.3);"

      # ============================================
      # STUDENT REGISTRATION FLOW (3 screens)
      # ============================================

      # Student Screen 1: Basic Info
      - ::
        id: "student-screen-1"
        type: "section-container"
        name: "Student Basic Info"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎓 Student Registration - Step 1 of 3"
            css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Basic Information"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Student Form Fields"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "student_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-student"
                fieldName: "student_email"
                label: "Email Address"
                placeholder: "your.email@university.edu"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "student_university"
                label: "University Name"
                placeholder: "Your university or college"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "student_id"
                label: "Student ID Number"
                placeholder: "Your student identification number"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Student Screen 1 Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "welcome-section"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next: T-Shirt Size →"
                    targetContainerId: "student-screen-2"
                    css: "background: #89b4fa; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

      # Student Screen 2: T-Shirt Size
      - ::
        id: "student-screen-2"
        type: "section-container"
        name: "Student T-Shirt Selection"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎓 Student Registration - Step 2 of 3"
            css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Choose Your T-Shirt Size"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "T-Shirt Size Options"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "text"
                content: "Select your preferred t-shirt size:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 20px;"

              - ::
                type: "section-container"
                name: "T-Shirt Size Buttons"
                css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "S"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "S"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-size: 18px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "M"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "M"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-size: 18px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "L"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "L"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-size: 18px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "XL"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "XL"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-size: 18px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "2XL"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "2XL"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-size: 18px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; transition: all 0.2s;"

              - ::
                type: "nav-button"
                content: "← Back to Basic Info"
                targetContainerId: "student-screen-1"
                css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; width: 100%;"

      # Student Screen 3: Dietary Restrictions & Submit
      - ::
        id: "student-screen-3"
        type: "section-container"
        name: "Student Final Details"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎓 Student Registration - Step 3 of 3"
            css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Final Details"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Student Dietary Form"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "form-field-textarea"
                formId: "form-student"
                fieldName: "dietary_restrictions"
                label: "Dietary Restrictions or Preferences"
                placeholder: "Please let us know about any dietary restrictions, allergies, or food preferences..."
                required: false
                css: "margin-bottom: 30px; min-height: 120px;"

              - ::
                type: "section-container"
                name: "Student Final Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back to T-Shirt"
                    targetContainerId: "student-screen-2"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Submit Registration ✓"
                    formId: "form-student"
                    targetContainerId: "confirmation"
                    css: "background: #89b4fa; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 700; border: none; cursor: pointer; flex: 2;"

      # ============================================
      # PROFESSIONAL REGISTRATION FLOW (3 screens)
      # ============================================

      # Professional Screen 1: Basic Info
      - ::
        id: "professional-screen-1"
        type: "section-container"
        name: "Professional Basic Info"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "💼 Professional Registration - Step 1 of 3"
            css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Professional Information"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Professional Form Fields"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "professional_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-professional"
                fieldName: "professional_email"
                label: "Email Address"
                placeholder: "your.email@company.com"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "company"
                label: "Company Name"
                placeholder: "Your company or organization"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "job_title"
                label: "Job Title"
                placeholder: "Your current position"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Professional Screen 1 Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "welcome-section"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next: Interests →"
                    targetContainerId: "professional-screen-2"
                    css: "background: #a6e3a1; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

      # Professional Screen 2: Interest Areas
      - ::
        id: "professional-screen-2"
        type: "section-container"
        name: "Professional Interest Selection"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "💼 Professional Registration - Step 2 of 3"
            css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Select Your Interest Areas"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Interest Areas Form"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "text"
                content: "Choose all topics that interest you:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_ai"
                label: "🤖 Artificial Intelligence & Machine Learning"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_webdev"
                label: "🌐 Web Development & Frontend Technologies"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_cloud"
                label: "☁️ Cloud Computing & Infrastructure"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_security"
                label: "🔒 Cybersecurity & Privacy"
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Professional Screen 2 Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back to Info"
                    targetContainerId: "professional-screen-1"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next: Networking →"
                    targetContainerId: "professional-screen-3"
                    css: "background: #a6e3a1; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

      # Professional Screen 3: Networking Preferences & Submit
      - ::
        id: "professional-screen-3"
        type: "section-container"
        name: "Professional Networking Preferences"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "💼 Professional Registration - Step 3 of 3"
            css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Networking Preferences"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Networking Preference Form"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "text"
                content: "Would you like to participate in our networking events and be included in the attendee directory?"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px; line-height: 1.6;"

              - ::
                type: "section-container"
                name: "Networking Choice Buttons"
                css: "display: flex; gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "✓ Yes, I'm open to networking"
                    formId: "form-professional"
                    fieldName: "networking_preference"
                    value: "yes"
                    targetContainerId: "professional-screen-3"
                    css: "background: #a6e3a1; color: #1e1e2e; padding: 15px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "✗ No, keep me private"
                    formId: "form-professional"
                    fieldName: "networking_preference"
                    value: "no"
                    targetContainerId: "professional-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 15px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1; transition: all 0.2s;"

              - ::
                type: "section-container"
                name: "Professional Final Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back to Interests"
                    targetContainerId: "professional-screen-2"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Submit Registration ✓"
                    formId: "form-professional"
                    targetContainerId: "confirmation"
                    css: "background: #a6e3a1; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 700; border: none; cursor: pointer; flex: 2;"

      # ============================================
      # WORKSHOP LEADER REGISTRATION FLOW (4 screens)
      # ============================================

      # Workshop Screen 1: Basic Info
      - ::
        id: "workshop-screen-1"
        type: "section-container"
        name: "Workshop Leader Basic Info"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎤 Workshop Leader Registration - Step 1 of 4"
            css: "color: #f9e2af; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Speaker Information"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Workshop Leader Form Fields"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "workshop_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-workshop"
                fieldName: "workshop_email"
                label: "Email Address"
                placeholder: "your.email@example.com"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "workshop_phone"
                label: "Phone Number"
                placeholder: "Your contact number"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Workshop Screen 1 Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "welcome-section"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next: Workshop Details →"
                    targetContainerId: "workshop-screen-2"
                    css: "background: #f9e2af; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

      # Workshop Screen 2: Workshop Details
      - ::
        id: "workshop-screen-2"
        type: "section-container"
        name: "Workshop Details Form"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎤 Workshop Leader Registration - Step 2 of 4"
            css: "color: #f9e2af; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Workshop Details"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Workshop Details Fields"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "workshop_title"
                label: "Workshop Title"
                placeholder: "Give your workshop a compelling title"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-textarea"
                formId: "form-workshop"
                fieldName: "workshop_description"
                label: "Workshop Description"
                placeholder: "Describe what attendees will learn and the format of your workshop..."
                required: true
                css: "margin-bottom: 30px; min-height: 150px;"

              - ::
                type: "section-container"
                name: "Workshop Screen 2 Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back to Info"
                    targetContainerId: "workshop-screen-1"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next: Topic Category →"
                    targetContainerId: "workshop-screen-3"
                    css: "background: #f9e2af; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

      # Workshop Screen 3: Topic Category
      - ::
        id: "workshop-screen-3"
        type: "section-container"
        name: "Workshop Topic Selection"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎤 Workshop Leader Registration - Step 3 of 4"
            css: "color: #f9e2af; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Choose Workshop Category"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Workshop Category Options"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "text"
                content: "Select the primary category for your workshop:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px;"

              - ::
                type: "section-container"
                name: "Workshop Category Buttons"
                css: "display: flex; flex-direction: column; gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "🤖 Artificial Intelligence & Machine Learning"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "AI"
                    targetContainerId: "workshop-screen-4"
                    css: "background: #45475a; color: #cdd6f4; padding: 18px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; text-align: left; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "🌐 Web Development & Frontend"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Web Dev"
                    targetContainerId: "workshop-screen-4"
                    css: "background: #45475a; color: #cdd6f4; padding: 18px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; text-align: left; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "☁️ Cloud Computing & Infrastructure"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Cloud"
                    targetContainerId: "workshop-screen-4"
                    css: "background: #45475a; color: #cdd6f4; padding: 18px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; text-align: left; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "🔒 Cybersecurity & Privacy"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Security"
                    targetContainerId: "workshop-screen-4"
                    css: "background: #45475a; color: #cdd6f4; padding: 18px 25px; border-radius: 8px; font-size: 16px; font-weight: 600; border: 2px solid #45475a; cursor: pointer; text-align: left; transition: all 0.2s;"

              - ::
                type: "nav-button"
                content: "← Back to Details"
                targetContainerId: "workshop-screen-2"
                css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; width: 100%;"

      # Workshop Screen 4: Equipment Needs & Submit
      - ::
        id: "workshop-screen-4"
        type: "section-container"
        name: "Workshop Equipment Needs"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center;"
        children::
          - ::
            type: "heading"
            content: "🎤 Workshop Leader Registration - Step 4 of 4"
            css: "color: #f9e2af; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

          - ::
            type: "text"
            content: "Equipment & Technical Requirements"
            css: "color: #bac2de; font-size: 18px; margin-bottom: 30px; text-align: center;"

          - ::
            type: "section-container"
            name: "Workshop Equipment Form"
            css: "background: #313244; padding: 40px; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "text"
                content: "Select all equipment and technical support you'll need:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_projector"
                label: "📽️ Projector and Screen"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_microphone"
                label: "🎤 Microphone (wireless preferred)"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_whiteboard"
                label: "📝 Whiteboard or Flip Chart"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_laptop"
                label: "💻 Laptop Connection (HDMI/USB-C)"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_wifi"
                label: "📡 High-Speed WiFi Access"
                css: "margin-bottom: 25px;"

              - ::
                type: "form-field-textarea"
                formId: "form-workshop"
                fieldName: "equipment_other"
                label: "Other Requirements"
                placeholder: "Any additional equipment or special setup needs..."
                required: false
                css: "margin-bottom: 30px; min-height: 100px;"

              - ::
                type: "section-container"
                name: "Workshop Final Navigation"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back to Category"
                    targetContainerId: "workshop-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Submit Registration ✓"
                    formId: "form-workshop"
                    targetContainerId: "confirmation"
                    css: "background: #f9e2af; color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 700; border: none; cursor: pointer; flex: 2;"

      # ============================================
      # CONFIRMATION SCREEN (shared by all flows)
      # ============================================

      - ::
        id: "confirmation"
        type: "section-container"
        name: "Registration Confirmation"
        css: "background: linear-gradient(135deg, #1e1e2e 0%, #313244 100%); min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; justify-content: center; align-items: center;"
        children::
          - ::
            type: "section-container"
            name: "Confirmation Card"
            css: "background: #313244; padding: 50px 40px; border-radius: 20px; max-width: 700px; width: 100%; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5); border: 2px solid #45475a;"
            children::
              - ::
                type: "heading"
                content: "✅ Registration Confirmed!"
                css: "color: #a6e3a1; font-size: 42px; font-weight: 800; margin-bottom: 20px; text-align: center;"

              - ::
                type: "text"
                content: "Thank you for registering for Tech Conference 2025!"
                css: "color: #cdd6f4; font-size: 20px; margin-bottom: 30px; text-align: center; line-height: 1.6;"

              - ::
                type: "section-container"
                name: "Event Details Box"
                css: "background: #1e1e2e; padding: 30px; border-radius: 12px; margin-bottom: 30px; border-left: 4px solid #89b4fa;"
                children::
                  - ::
                    type: "heading"
                    content: "📅 Event Details"
                    css: "color: #89b4fa; font-size: 24px; font-weight: 700; margin-bottom: 20px;"

                  - ::
                    type: "text"
                    content: "📆 Dates: March 15-17, 2025"
                    css: "color: #cdd6f4; font-size: 18px; margin-bottom: 12px; line-height: 1.8;"

                  - ::
                    type: "text"
                    content: "📍 Location: Moscone Center, San Francisco, CA"
                    css: "color: #cdd6f4; font-size: 18px; margin-bottom: 12px; line-height: 1.8;"

                  - ::
                    type: "text"
                    content: "⏰ Hours: 9:00 AM - 6:00 PM daily"
                    css: "color: #cdd6f4; font-size: 18px; line-height: 1.8;"

              - ::
                type: "text"
                content: "📧 A confirmation email has been sent to your registered email address with your ticket and additional details."
                css: "color: #bac2de; font-size: 16px; margin-bottom: 30px; text-align: center; line-height: 1.6;"

              - ::
                type: "text"
                content: "We look forward to seeing you at the conference!"
                css: "color: #a6e3a1; font-size: 18px; font-weight: 600; text-align: center; margin-bottom: 30px;"

              - ::
                type: "nav-button"
                content: "← Return to Home"
                targetContainerId: "welcome-section"
                css: "background: #89b4fa; color: #1e1e2e; padding: 15px 40px; border-radius: 8px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; width: 100%; max-width: 300px; margin: 0 auto; display: block;"
