name: "Tech Conference 2025 Registration System"

screens::
  - ::
    id: "home"
    name: "Home"
    isEntryPoint: true
    children::
      # Main container with dark theme
      - ::
        type: "section-container"
        name: "Main Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          # Hero Section
          - ::
            type: "section-container"
            name: "Hero Section"
            css: "text-align: center; max-width: 900px; margin-bottom: 60px;"
            children::
              - ::
                type: "heading"
                content: "🚀 Tech Conference 2025"
                css: "color: #cdd6f4; font-size: 56px; font-weight: 800; margin-bottom: 20px; text-shadow: 0 0 30px rgba(137, 180, 250, 0.5);"

              - ::
                type: "text"
                content: "March 15-17, 2025 • San Francisco, CA"
                css: "color: #89b4fa; font-size: 24px; font-weight: 600; margin-bottom: 15px;"

              - ::
                type: "text"
                content: "Join us for three days of cutting-edge technology talks, hands-on workshops, and networking with industry leaders."
                css: "color: #a6adc8; font-size: 18px; line-height: 1.6; max-width: 700px; margin: 0 auto;"

          # Registration Type Selection
          - ::
            type: "section-container"
            name: "Registration Type Selection"
            css: "width: 100%; max-width: 900px;"
            children::
              - ::
                type: "heading"
                content: "Choose Your Registration Type"
                css: "color: #cdd6f4; font-size: 32px; font-weight: 700; text-align: center; margin-bottom: 40px;"

              # Student Registration Button
              - ::
                type: "section-container"
                name: "Student Registration Card"
                css: "background: linear-gradient(135deg, #89b4fa 0%, #74c7ec 100%); border-radius: 16px; padding: 30px; margin-bottom: 20px; cursor: pointer; transition: transform 0.3s;"
                children::
                  - ::
                    type: "heading"
                    content: "🎓 Student Registration"
                    css: "color: #1e1e2e; font-size: 28px; font-weight: 700; margin-bottom: 15px;"

                  - ::
                    type: "text"
                    content: "Discounted ticket for students • Valid student ID required"
                    css: "color: #11111b; font-size: 16px; margin-bottom: 20px;"

                  - ::
                    type: "nav-button"
                    content: "Register as Student"
                    targetContainerId: "student-screen-1"
                    css: "background: #1e1e2e; color: #89b4fa; padding: 15px 40px; border-radius: 8px; font-weight: 600; font-size: 18px; border: none; cursor: pointer; width: 100%; max-width: 300px;"

              # Professional Registration Button
              - ::
                type: "section-container"
                name: "Professional Registration Card"
                css: "background: linear-gradient(135deg, #cba6f7 0%, #f5c2e7 100%); border-radius: 16px; padding: 30px; margin-bottom: 20px; cursor: pointer; transition: transform 0.3s;"
                children::
                  - ::
                    type: "heading"
                    content: "💼 Professional Registration"
                    css: "color: #1e1e2e; font-size: 28px; font-weight: 700; margin-bottom: 15px;"

                  - ::
                    type: "text"
                    content: "Full conference access • All workshops included"
                    css: "color: #11111b; font-size: 16px; margin-bottom: 20px;"

                  - ::
                    type: "nav-button"
                    content: "Register as Professional"
                    targetContainerId: "professional-screen-1"
                    css: "background: #1e1e2e; color: #cba6f7; padding: 15px 40px; border-radius: 8px; font-weight: 600; font-size: 18px; border: none; cursor: pointer; width: 100%; max-width: 300px;"

              # Workshop Leader Registration Button
              - ::
                type: "section-container"
                name: "Workshop Leader Registration Card"
                css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); border-radius: 16px; padding: 30px; cursor: pointer; transition: transform 0.3s;"
                children::
                  - ::
                    type: "heading"
                    content: "🎤 Workshop Leader Registration"
                    css: "color: #1e1e2e; font-size: 28px; font-weight: 700; margin-bottom: 15px;"

                  - ::
                    type: "text"
                    content: "Free admission • Speaker benefits included"
                    css: "color: #11111b; font-size: 16px; margin-bottom: 20px;"

                  - ::
                    type: "nav-button"
                    content: "Register as Workshop Leader"
                    targetContainerId: "workshop-screen-1"
                    css: "background: #1e1e2e; color: #a6e3a1; padding: 15px 40px; border-radius: 8px; font-weight: 600; font-size: 18px; border: none; cursor: pointer; width: 100%; max-width: 300px;"

  # STUDENT REGISTRATION FLOW
  # Student Screen 1: Basic Info
  - ::
    id: "student-screen-1"
    name: "Student Registration - Basic Info"
    children::
      - ::
        type: "form"
        formId: "form-student"
        submitEndpoint: "https://formspree.io/f/YOUR_FORM_ID"

      - ::
        type: "section-container"
        name: "Student Form Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Student Form Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🎓 Student Registration"
                css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 1 of 3: Basic Information"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "student_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-student"
                fieldName: "student_email"
                label: "Email Address"
                placeholder: "your.email@university.edu"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "university"
                label: "University Name"
                placeholder: "Enter your university"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-student"
                fieldName: "student_id"
                label: "Student ID"
                placeholder: "Enter your student ID"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Student Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "home"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    formId: "form-student"
                    targetContainerId: "student-screen-2"
                    css: "background: linear-gradient(135deg, #89b4fa 0%, #74c7ec 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

  # Student Screen 2: T-Shirt Size
  - ::
    id: "student-screen-2"
    name: "Student Registration - T-Shirt Size"
    children::
      - ::
        type: "section-container"
        name: "Student T-Shirt Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Student T-Shirt Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "👕 Choose Your T-Shirt Size"
                css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 2 of 3: Conference Merchandise"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "text"
                content: "Select your preferred t-shirt size for the conference swag:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px; text-align: center;"

              - ::
                type: "section-container"
                name: "T-Shirt Size Buttons"
                css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "S"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "S"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; font-size: 18px; border: 2px solid #45475a; cursor: pointer; transition: all 0.3s; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "M"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "M"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; font-size: 18px; border: 2px solid #45475a; cursor: pointer; transition: all 0.3s; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "L"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "L"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; font-size: 18px; border: 2px solid #45475a; cursor: pointer; transition: all 0.3s; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "XL"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "XL"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; font-size: 18px; border: 2px solid #45475a; cursor: pointer; transition: all 0.3s; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "2XL"
                    formId: "form-student"
                    fieldName: "tshirt_size"
                    value: "2XL"
                    targetContainerId: "student-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; font-size: 18px; border: 2px solid #45475a; cursor: pointer; transition: all 0.3s; text-align: center;"

              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "student-screen-1"
                css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; width: 100%;"

  # Student Screen 3: Dietary Restrictions
  - ::
    id: "student-screen-3"
    name: "Student Registration - Final"
    children::
      - ::
        type: "section-container"
        name: "Student Final Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Student Final Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🍽️ Dietary Preferences"
                css: "color: #89b4fa; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 3 of 3: Final Details"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "form-field-textarea"
                formId: "form-student"
                fieldName: "dietary_restrictions"
                label: "Dietary Restrictions or Allergies"
                placeholder: "Let us know if you have any dietary restrictions, allergies, or special meal requirements..."
                required: false
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Student Final Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "student-screen-2"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Complete Registration ✓"
                    formId: "form-student"
                    targetContainerId: "confirmation"
                    css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

  # PROFESSIONAL REGISTRATION FLOW
  # Professional Screen 1: Basic Info
  - ::
    id: "professional-screen-1"
    name: "Professional Registration - Basic Info"
    children::
      - ::
        type: "form"
        formId: "form-professional"
        submitEndpoint: "https://formspree.io/f/YOUR_FORM_ID"

      - ::
        type: "section-container"
        name: "Professional Form Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Professional Form Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "💼 Professional Registration"
                css: "color: #cba6f7; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 1 of 3: Basic Information"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "professional_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-professional"
                fieldName: "professional_email"
                label: "Email Address"
                placeholder: "your.email@company.com"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "company"
                label: "Company Name"
                placeholder: "Enter your company"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-professional"
                fieldName: "job_title"
                label: "Job Title"
                placeholder: "Enter your job title"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Professional Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "home"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    formId: "form-professional"
                    targetContainerId: "professional-screen-2"
                    css: "background: linear-gradient(135deg, #cba6f7 0%, #f5c2e7 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

  # Professional Screen 2: Interest Areas
  - ::
    id: "professional-screen-2"
    name: "Professional Registration - Interest Areas"
    children::
      - ::
        type: "section-container"
        name: "Professional Interest Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Professional Interest Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🎯 Select Your Interest Areas"
                css: "color: #cba6f7; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 2 of 3: Choose Topics"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "text"
                content: "Select all topics you're interested in (multiple selections allowed):"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_ai"
                label: "Artificial Intelligence & Machine Learning"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_webdev"
                label: "Web Development & Frontend Technologies"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_cloud"
                label: "Cloud Computing & DevOps"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-professional"
                fieldName: "interest_security"
                label: "Cybersecurity & Privacy"
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Professional Interest Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "professional-screen-1"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    formId: "form-professional"
                    targetContainerId: "professional-screen-3"
                    css: "background: linear-gradient(135deg, #cba6f7 0%, #f5c2e7 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

  # Professional Screen 3: Networking Preferences
  - ::
    id: "professional-screen-3"
    name: "Professional Registration - Networking"
    children::
      - ::
        type: "section-container"
        name: "Professional Networking Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Professional Networking Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🤝 Networking Preferences"
                css: "color: #cba6f7; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 3 of 3: Connect with Others"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "text"
                content: "Would you like to be included in our networking directory and receive connection opportunities?"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px; text-align: center; line-height: 1.6;"

              - ::
                type: "section-container"
                name: "Networking Choice Buttons"
                css: "display: flex; gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "✓ Yes, I'm open to networking"
                    formId: "form-professional"
                    fieldName: "networking"
                    value: "yes"
                    targetContainerId: "confirmation"
                    css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "✗ No, thank you"
                    formId: "form-professional"
                    fieldName: "networking"
                    value: "no"
                    targetContainerId: "confirmation"
                    css: "background: #45475a; color: #cdd6f4; padding: 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1; text-align: center;"

              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "professional-screen-2"
                css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; width: 100%;"

  # WORKSHOP LEADER REGISTRATION FLOW
  # Workshop Screen 1: Basic Info
  - ::
    id: "workshop-screen-1"
    name: "Workshop Leader Registration - Basic Info"
    children::
      - ::
        type: "form"
        formId: "form-workshop"
        submitEndpoint: "https://formspree.io/f/YOUR_FORM_ID"

      - ::
        type: "section-container"
        name: "Workshop Form Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Workshop Form Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🎤 Workshop Leader Registration"
                css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 1 of 4: Basic Information"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "workshop_leader_name"
                label: "Full Name"
                placeholder: "Enter your full name"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                formId: "form-workshop"
                fieldName: "workshop_leader_email"
                label: "Email Address"
                placeholder: "your.email@example.com"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "phone"
                label: "Phone Number"
                placeholder: "Enter your phone number"
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Workshop Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "home"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    formId: "form-workshop"
                    targetContainerId: "workshop-screen-2"
                    css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

  # Workshop Screen 2: Workshop Details
  - ::
    id: "workshop-screen-2"
    name: "Workshop Leader Registration - Workshop Details"
    children::
      - ::
        type: "section-container"
        name: "Workshop Details Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Workshop Details Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "📝 Workshop Details"
                css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 2 of 4: Tell Us About Your Workshop"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "form-field-text"
                formId: "form-workshop"
                fieldName: "workshop_title"
                label: "Workshop Title"
                placeholder: "Enter your workshop title"
                required: true
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-textarea"
                formId: "form-workshop"
                fieldName: "workshop_description"
                label: "Workshop Description"
                placeholder: "Provide a detailed description of your workshop, including learning objectives and target audience..."
                required: true
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Workshop Details Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "workshop-screen-1"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    formId: "form-workshop"
                    targetContainerId: "workshop-screen-3"
                    css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

  # Workshop Screen 3: Topic Category
  - ::
    id: "workshop-screen-3"
    name: "Workshop Leader Registration - Topic Category"
    children::
      - ::
        type: "section-container"
        name: "Workshop Topic Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Workshop Topic Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🏷️ Choose Topic Category"
                css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 3 of 4: Select Primary Topic"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "text"
                content: "Select the primary topic category for your workshop:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px; text-align: center;"

              - ::
                type: "section-container"
                name: "Topic Category Buttons"
                css: "display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "🤖 AI & Machine Learning"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "AI"
                    targetContainerId: "workshop-screen-4"
                    css: "background: linear-gradient(135deg, #89b4fa 0%, #74c7ec 100%); color: #1e1e2e; padding: 25px 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "🌐 Web Development"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Web Dev"
                    targetContainerId: "workshop-screen-4"
                    css: "background: linear-gradient(135deg, #cba6f7 0%, #f5c2e7 100%); color: #1e1e2e; padding: 25px 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "☁️ Cloud Computing"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Cloud"
                    targetContainerId: "workshop-screen-4"
                    css: "background: linear-gradient(135deg, #f9e2af 0%, #fab387 100%); color: #1e1e2e; padding: 25px 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; text-align: center;"

                  - ::
                    type: "nav-button"
                    content: "🔒 Cybersecurity"
                    formId: "form-workshop"
                    fieldName: "workshop_category"
                    value: "Security"
                    targetContainerId: "workshop-screen-4"
                    css: "background: linear-gradient(135deg, #f38ba8 0%, #eba0ac 100%); color: #1e1e2e; padding: 25px 20px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; text-align: center;"

              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "workshop-screen-2"
                css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; width: 100%;"

  # Workshop Screen 4: Equipment Needs
  - ::
    id: "workshop-screen-4"
    name: "Workshop Leader Registration - Equipment"
    children::
      - ::
        type: "section-container"
        name: "Workshop Equipment Container"
        css: "background: #1e1e2e; min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Workshop Equipment Card"
            css: "background: #313244; border-radius: 16px; padding: 40px; max-width: 600px; width: 100%; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);"
            children::
              - ::
                type: "heading"
                content: "🎛️ Equipment Requirements"
                css: "color: #a6e3a1; font-size: 32px; font-weight: 700; margin-bottom: 10px; text-align: center;"

              - ::
                type: "text"
                content: "Step 4 of 4: Technical Setup"
                css: "color: #a6adc8; font-size: 16px; margin-bottom: 30px; text-align: center;"

              - ::
                type: "text"
                content: "Please let us know what equipment you'll need for your workshop:"
                css: "color: #cdd6f4; font-size: 16px; margin-bottom: 25px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_projector"
                label: "Projector / Large Display Screen"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_microphone"
                label: "Microphone (handheld or lapel)"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_whiteboard"
                label: "Whiteboard / Flip Chart"
                css: "margin-bottom: 15px;"

              - ::
                type: "form-field-checkbox"
                formId: "form-workshop"
                fieldName: "equipment_hdmi"
                label: "HDMI / USB-C Adapters"
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-textarea"
                formId: "form-workshop"
                fieldName: "equipment_other"
                label: "Other Equipment or Special Requirements"
                placeholder: "List any additional equipment or setup requirements..."
                required: false
                css: "margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Workshop Equipment Navigation Buttons"
                css: "display: flex; gap: 15px; justify-content: space-between;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    targetContainerId: "workshop-screen-3"
                    css: "background: #45475a; color: #cdd6f4; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 1;"

                  - ::
                    type: "nav-button"
                    content: "Complete Registration ✓"
                    formId: "form-workshop"
                    targetContainerId: "confirmation"
                    css: "background: linear-gradient(135deg, #a6e3a1 0%, #94e2d5 100%); color: #1e1e2e; padding: 12px 30px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; flex: 2;"

  # CONFIRMATION SCREEN (shared by all registration types)
  - ::
    id: "confirmation"
    name: "Registration Confirmation"
    children::
      - ::
        type: "section-container"
        name: "Confirmation Container"
        css: "background: linear-gradient(135deg, #1e1e2e 0%, #313244 100%); min-height: 100vh; padding: 40px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;"
        children::
          - ::
            type: "section-container"
            name: "Confirmation Card"
            css: "background: #45475a; border-radius: 16px; padding: 50px 40px; max-width: 700px; width: 100%; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5); text-align: center;"
            children::
              - ::
                type: "heading"
                content: "✅ Registration Confirmed!"
                css: "color: #a6e3a1; font-size: 48px; font-weight: 800; margin-bottom: 20px;"

              - ::
                type: "text"
                content: "Thank you for registering for Tech Conference 2025!"
                css: "color: #cdd6f4; font-size: 22px; font-weight: 600; margin-bottom: 15px;"

              - ::
                type: "section-container"
                name: "Event Details Box"
                css: "background: #313244; border-radius: 12px; padding: 30px; margin: 30px 0; border-left: 4px solid #a6e3a1;"
                children::
                  - ::
                    type: "heading"
                    content: "📅 Event Details"
                    css: "color: #89b4fa; font-size: 24px; font-weight: 700; margin-bottom: 20px;"

                  - ::
                    type: "text"
                    content: "📆 Dates: March 15-17, 2025"
                    css: "color: #cdd6f4; font-size: 18px; margin-bottom: 10px;"

                  - ::
                    type: "text"
                    content: "📍 Location: San Francisco, California"
                    css: "color: #cdd6f4; font-size: 18px; margin-bottom: 10px;"

                  - ::
                    type: "text"
                    content: "🏨 Venue: Moscone Center, 747 Howard St"
                    css: "color: #cdd6f4; font-size: 18px;"

              - ::
                type: "text"
                content: "A confirmation email has been sent to your registered email address with your ticket and additional details."
                css: "color: #a6adc8; font-size: 16px; line-height: 1.6; margin-bottom: 30px;"

              - ::
                type: "section-container"
                name: "Next Steps Box"
                css: "background: #1e1e2e; border-radius: 12px; padding: 25px; margin-bottom: 30px; text-align: left;"
                children::
                  - ::
                    type: "heading"
                    content: "📋 Next Steps"
                    css: "color: #f9e2af; font-size: 20px; font-weight: 700; margin-bottom: 15px;"

                  - ::
                    type: "text"
                    content: "1. Check your email for confirmation and ticket details\n2. Book your accommodation early (group rates available)\n3. Review the conference schedule (coming soon)\n4. Join our community Discord server\n5. Follow us on social media for updates"
                    css: "color: #bac2de; font-size: 16px; line-height: 2; white-space: pre-line;"

              - ::
                type: "nav-button"
                content: "Return to Home"
                targetContainerId: "home"
                css: "background: linear-gradient(135deg, #89b4fa 0%, #74c7ec 100%); color: #1e1e2e; padding: 15px 40px; border-radius: 8px; font-weight: 600; font-size: 18px; border: none; cursor: pointer; margin-top: 20px;"
