name: "File Manager"
version: "v1.0.0"

documents::
  contentDoc::
    files::
      - ::
        id::
          type: "string"
          initial: ""
        fileId::
          type: "string"
          initial: ""
        filename::
          type: "string"
          initial: ""
        size::
          type: "number"
          initial: 0
        uploadedAt::
          type: "number"
          initial: 0

  publisherState::
    uploadedFileId::
      type: "string"
      initial: ""
    uploadedFilename::
      type: "string"
      initial: ""
    uploadedFileSize::
      type: "number"
      initial: 0
    uploading::
      type: "boolean"
      initial: false
    allowedTypes::
      type: "array"
      initial::
        - "pdf"
        - "txt"
        - "doc"
        - "docx"
        - "csv"

  publisherComputed::
    fileCount: "${ size(files) }"
    hasFiles: "${ size(files) > 0 }"
    isUploading: "${ uploading == true }"
    hasUploadedFile: "${ size(uploadedFileId) > 0 }"

ui::
  publisher::
    - ::
      type: "screen"
      id: "manager"
      name: "manager"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); min-height: 100vh;"
      blocks::
        # Header
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "📁 File Manager"
              css: "margin: 0 0 0.5rem 0; color: #0ea5e9; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"

            - ::
              type: "text"
              content: "Upload and manage documents. Files are stored in staticAssets (non-CRDT) with IDs in contentDoc (CRDT). File types are configurable."
              css: "color: #6b7280; margin: 0 0 1rem 0; line-height: 1.6;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "align-items: center;"
              blocks::
                - ::
                  type: "text"
                  content: "📊 Total Files: {{fileCount}}"
                  css: "padding: 0.5rem 1rem; background: #dbeafe; border-radius: 8px; color: #1e40af; font-weight: 600;"

                - ::
                  type: "text"
                  content: "✅ Using OCaml-generated asset IDs"
                  css: "padding: 0.5rem 1rem; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 0.875rem;"

        # Upload Section
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "📤 Upload New File"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # Upload Button (not uploading)
            - ::
              type: "button"
              content: "📄 Choose File"
              action: "uploadFile"
              params::
                stateField: "uploadedFileId"
              when: "${ !isUploading }"
              css: "padding: 1rem 2rem; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 1rem; box-shadow: 0 4px 12px rgba(79, 172, 254, 0.4); transition: transform 0.2s; &:hover { transform: translateY(-2px); }"

            # Uploading State
            - ::
              type: "container"
              when: "${ isUploading }"
              css: "padding: 1rem; background: #dbeafe; border-radius: 8px; border: 2px solid #60a5fa;"
              blocks::
                - ::
                  type: "text"
                  content: "⏳ Uploading to staticAssets..."
                  css: "color: #1e40af; font-weight: 600; margin: 0;"

            # Just Uploaded Success
            - ::
              type: "container"
              when: "${ hasUploadedFile }"
              css: "margin-top: 1.5rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
              blocks::
                - ::
                  type: "text"
                  content: "✅ File uploaded! Click 'Add to Files' to save it."
                  css: "color: #065f46; font-weight: 600; margin-bottom: 1rem;"

                - ::
                  type: "text"
                  content: "Asset ID: {{uploadedFileId}}"
                  css: "color: #047857; font-size: 0.75rem; font-family: monospace; margin-bottom: 0.5rem;"

                - ::
                  type: "text"
                  content: "Filename: {{uploadedFilename}}"
                  css: "color: #047857; font-size: 0.875rem; margin-bottom: 0.5rem;"

                - ::
                  type: "button"
                  content: "➕ Add to Files"
                  action: "setState"
                  stateUpdates::
                    files: "${ files + [{\"id\": string(now()), \"fileId\": uploadedFileId, \"filename\": uploadedFilename, \"size\": uploadedFileSize, \"uploadedAt\": now()}] }"
                    uploadedFileId: ""
                    uploadedFilename: ""
                    uploadedFileSize: 0
                  css: "padding: 0.75rem 1.5rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

        # File List
        - ::
          type: "section"
          when: "${ hasFiles }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "📂 Your Files ({{fileCount}})"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # File List
            - ::
              type: "container"
              forEach: "files"
              css: "display: flex; flex-direction: column; gap: 1rem;"
              blocks::
                - ::
                  type: "file"
                  src: "{{item.fileId}}"
                  css: "border: 2px solid #e5e7eb; border-radius: 8px; padding: 1rem; background: #f9fafb;"

        # Empty State
        - ::
          type: "section"
          when: "${ !hasFiles }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "📄 No Files Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first file to get started! Files will be stored in staticAssets with IDs persisted in contentDoc."
              css: "color: #9ca3af; margin: 0; line-height: 1.6;"

        # File Type Configuration Section
        - ::
          type: "section"
          css: "background: rgba(255,255,255,0.9); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; backdrop-filter: blur(10px);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "⚙️ Configurable File Types"
              css: "margin: 0 0 1rem 0; color: #0ea5e9; font-size: 1rem;"

            - ::
              type: "text"
              content: "Current allowed types: pdf, txt, doc, docx, csv"
              css: "color: #374151; margin-bottom: 1rem; font-size: 0.875rem;"

            - ::
              type: "text"
              content: "You can configure allowed file types by calling the setFileTypes action with an array of extensions."
              css: "color: #6b7280; margin-bottom: 1rem; font-size: 0.875rem; font-style: italic;"

        # Technical Info Footer
        - ::
          type: "section"
          css: "background: rgba(255,255,255,0.9); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; backdrop-filter: blur(10px);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🔧 Technical Details"
              css: "margin: 0 0 1rem 0; color: #0ea5e9; font-size: 1rem;"

            - ::
              type: "text"
              content: "✨ Asset IDs generated by OCaml WASM (generateAssetId)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ File binaries stored in staticAssets Map (non-CRDT)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ File IDs & metadata stored in contentDoc (CRDT, syncs to viewers)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ State persists across app restarts via publisherState"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Download button creates blob URL and triggers browser download"
              css: "color: #374151; font-size: 0.875rem; padding-left: 1rem;"
