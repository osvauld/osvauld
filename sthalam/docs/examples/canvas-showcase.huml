name: "Canvas Pattern Showcase"
version: "v2.0.0"

documents::
  # Pattern selection state
  selectedBasicPattern::
    type: "string"
    initial: "wave"
    document: "user_content_doc"

  selectedInteractivePattern::
    type: "string"
    initial: "mouseRipple"
    document: "user_content_doc"

  selectedMathPattern::
    type: "string"
    initial: "interference"
    document: "user_content_doc"

  selectedKaleidoPattern::
    type: "string"
    initial: "spiral"
    document: "user_content_doc"

  # Interactive controls
  animationSpeed::
    type: "number"
    initial: 1.0
    document: "user_content_doc"

  zoom::
    type: "number"
    initial: 1.0
    document: "user_content_doc"

computed::
  speedLabel::
    expr: "${ string(animationSpeed) + 'x' }"
    deps::
      - "animationSpeed"

  zoomLabel::
    expr: "${ string(zoom) + 'x' }"
    deps::
      - "zoom"

ui::
  publisher::
    # Home Screen - Gallery Overview
    - ::
      type: "screen"
      id: "home"
      name: "Canvas Gallery"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1400px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.05); padding: 2rem; border-radius: 16px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "🎨 GPU Canvas Pattern Showcase"
              css: "margin: 0 0 0.5rem 0; background: linear-gradient(to right, #60a5fa, #a78bfa, #f472b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 3rem;"

            - ::
              type: "text"
              content: "Mathematical expressions compiled to GPU shaders for real-time rendering at 60+ FPS"
              css: "color: #94a3b8; margin: 0 0 1.5rem 0; font-size: 1.1rem; line-height: 1.6;"

            - ::
              type: "text"
              content: "Powered by OCaml CEL → GLSL compiler | WebGL2 GPU acceleration"
              css: "color: #64748b; font-size: 0.9rem; font-style: italic;"

        - ::
          type: "container"
          css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;"
          blocks::
            # Basic Patterns Card
            - ::
              type: "container"
              css: "background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(59, 130, 246, 0.4); cursor: pointer; transition: transform 0.2s;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "🌊 Basic Patterns"
                  css: "margin: 0 0 1rem 0; color: white; font-size: 1.5rem;"

                - ::
                  type: "text"
                  content: "Wave, Ripple, Spiral, Plasma"
                  css: "color: rgba(255,255,255,0.9); margin-bottom: 1.5rem;"

                - ::
                  type: "button"
                  content: "Explore →"
                  action: "navigate"
                  targetScreen: "basic"
                  css: "width: 100%; padding: 0.75rem; background: white; color: #1d4ed8; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            # Interactive Patterns Card
            - ::
              type: "container"
              css: "background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(139, 92, 246, 0.4); cursor: pointer; transition: transform 0.2s;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "✨ Interactive Shaders"
                  css: "margin: 0 0 1rem 0; color: white; font-size: 1.5rem;"

                - ::
                  type: "text"
                  content: "Mouse-driven GPU effects"
                  css: "color: rgba(255,255,255,0.9); margin-bottom: 1.5rem;"

                - ::
                  type: "button"
                  content: "Explore →"
                  action: "navigate"
                  targetScreen: "interactive"
                  css: "width: 100%; padding: 0.75rem; background: white; color: #6d28d9; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            # Mathematical Patterns Card
            - ::
              type: "container"
              css: "background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(236, 72, 153, 0.4); cursor: pointer; transition: transform 0.2s;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "🔢 Mathematical Art"
                  css: "margin: 0 0 1rem 0; color: white; font-size: 1.5rem;"

                - ::
                  type: "text"
                  content: "Interference, Mandelbrot, Moiré"
                  css: "color: rgba(255,255,255,0.9); margin-bottom: 1.5rem;"

                - ::
                  type: "button"
                  content: "Explore →"
                  action: "navigate"
                  targetScreen: "mathematical"
                  css: "width: 100%; padding: 0.75rem; background: white; color: #be185d; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            # Kaleidoscope Card
            - ::
              type: "container"
              css: "background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(245, 158, 11, 0.4); cursor: pointer; transition: transform 0.2s;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "🔆 Kaleidoscope"
                  css: "margin: 0 0 1rem 0; color: white; font-size: 1.5rem;"

                - ::
                  type: "text"
                  content: "Symmetrical generative art"
                  css: "color: rgba(255,255,255,0.9); margin-bottom: 1.5rem;"

                - ::
                  type: "button"
                  content: "Explore →"
                  action: "navigate"
                  targetScreen: "kaleidoscope"
                  css: "width: 100%; padding: 0.75rem; background: white; color: #d97706; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.05); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; border: 1px solid rgba(255,255,255,0.1);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "💡 How It Works"
              css: "margin: 0 0 1rem 0; color: #60a5fa;"

            - ::
              type: "text"
              content: "1. HUML defines patterns as CEL expressions (e.g., sin(x * 0.1 + time))"
              css: "color: #cbd5e1; margin-bottom: 0.5rem; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "2. OCaml compiler transpiles CEL to optimized GLSL shader code"
              css: "color: #cbd5e1; margin-bottom: 0.5rem; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "3. WebGL2 runs shaders on GPU, evaluating 10,000+ pixels in parallel"
              css: "color: #cbd5e1; margin-bottom: 0.5rem; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "4. Real-time animation at 60 FPS (GPU can render 500+ FPS)"
              css: "color: #cbd5e1; font-size: 0.95rem;"

    # Basic Patterns Screen
    - ::
      type: "screen"
      id: "basic"
      name: "Basic Patterns"
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.95); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🌊 Basic GPU Patterns"
                  css: "margin: 0; color: #1e40af;"

                - ::
                  type: "button"
                  content: "← Gallery Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "container"
              css: "display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;"
              blocks::
                - ::
                  type: "button"
                  content: "Wave"
                  action: "setState"
                  stateUpdates::
                    selectedBasicPattern: "wave"
                  css: "padding: 0.75rem 1.5rem; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Ripple"
                  action: "setState"
                  stateUpdates::
                    selectedBasicPattern: "ripple"
                  css: "padding: 0.75rem 1.5rem; background: #8b5cf6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Spiral"
                  action: "setState"
                  stateUpdates::
                    selectedBasicPattern: "spiral"
                  css: "padding: 0.75rem 1.5rem; background: #ec4899; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Plasma"
                  action: "setState"
                  stateUpdates::
                    selectedBasicPattern: "plasma"
                  css: "padding: 0.75rem 1.5rem; background: #f59e0b; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(x * 0.1 + time)"
              when: "${ selectedBasicPattern == 'wave' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(distance(x, y, 50, 50) * 0.3 - time * 2)"
              when: "${ selectedBasicPattern == 'ripple' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 5 + distance(x, y, 50, 50) * 0.2 - time)"
              when: "${ selectedBasicPattern == 'spiral' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(x * 0.1) * cos(y * 0.1) + sin(time)"
              when: "${ selectedBasicPattern == 'plasma' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "container"
              css: "margin-top: 2rem; padding: 1.5rem; background: #f9fafb; border-radius: 8px;"
              blocks::
                - ::
                  type: "heading"
                  level: 3
                  content: "Current: {{selectedBasicPattern}}"
                  css: "margin: 0 0 1rem 0; color: #374151;"

                - ::
                  type: "text"
                  content: "Expression: sin(x * 0.1 + time)"
                  when: "${ selectedBasicPattern == 'wave' }"
                  css: "color: #6b7280; font-family: monospace; font-size: 0.875rem;"

                - ::
                  type: "text"
                  content: "Expression: sin(distance(x, y, 50, 50) * 0.3 - time * 2)"
                  when: "${ selectedBasicPattern == 'ripple' }"
                  css: "color: #6b7280; font-family: monospace; font-size: 0.875rem;"

                - ::
                  type: "text"
                  content: "Expression: sin(atan2(y-50, x-50) * 5 + distance(...) * 0.2 - time)"
                  when: "${ selectedBasicPattern == 'spiral' }"
                  css: "color: #6b7280; font-family: monospace; font-size: 0.875rem;"

                - ::
                  type: "text"
                  content: "Expression: sin(x * 0.1) * cos(y * 0.1) + sin(time)"
                  when: "${ selectedBasicPattern == 'plasma' }"
                  css: "color: #6b7280; font-family: monospace; font-size: 0.875rem;"

    # Interactive Patterns Screen
    - ::
      type: "screen"
      id: "interactive"
      name: "Interactive"
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #581c87 0%, #8b5cf6 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.95); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "✨ Interactive GPU Shaders"
                  css: "margin: 0; color: #7c3aed;"

                - ::
                  type: "button"
                  content: "← Gallery Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "text"
              content: "Move your mouse over the canvas to interact with the patterns in real-time! Mouse coordinates (mouseX, mouseY) are GPU uniforms updated every frame."
              css: "color: #6b7280; margin-bottom: 2rem; line-height: 1.6;"

            - ::
              type: "container"
              css: "display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap;"
              blocks::
                - ::
                  type: "button"
                  content: "🌊 Ripple"
                  action: "setState"
                  stateUpdates::
                    selectedInteractivePattern: "ripple"
                  css: "padding: 0.75rem 1.5rem; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "🌀 Vortex"
                  action: "setState"
                  stateUpdates::
                    selectedInteractivePattern: "vortex"
                  css: "padding: 0.75rem 1.5rem; background: #ec4899; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "⚡ Lightning"
                  action: "setState"
                  stateUpdates::
                    selectedInteractivePattern: "lightning"
                  css: "padding: 0.75rem 1.5rem; background: #f59e0b; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "🔥 Heat Wave"
                  action: "setState"
                  stateUpdates::
                    selectedInteractivePattern: "heatWave"
                  css: "padding: 0.75rem 1.5rem; background: #ef4444; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(distance(x, y, mouseX / 6, mouseY / 6) * 0.3 - time * 2)"
              when: "${ selectedInteractivePattern == 'ripple' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px; cursor: crosshair;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - mouseY / 6, x - mouseX / 6) * 8 - distance(x, y, mouseX / 6, mouseY / 6) * 0.1 + time * 2)"
              when: "${ selectedInteractivePattern == 'vortex' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px; cursor: crosshair;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin((x - mouseX / 6) * 0.2 + time * 3) * cos((y - mouseY / 6) * 0.2 - time * 2)"
              when: "${ selectedInteractivePattern == 'lightning' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px; cursor: crosshair;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(distance(x, y, mouseX / 6, mouseY / 6) * 0.2 + time) + sin(x * 0.1 - mouseX / 60) * cos(y * 0.1 - mouseY / 60)"
              when: "${ selectedInteractivePattern == 'heatWave' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px; cursor: crosshair;"

    # Mathematical Patterns Screen
    - ::
      type: "screen"
      id: "mathematical"
      name: "Mathematical"
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #831843 0%, #ec4899 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.95); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🔢 Mathematical Art"
                  css: "margin: 0; color: #9f1239;"

                - ::
                  type: "button"
                  content: "← Gallery Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "text"
              content: "Pure mathematics rendered in real-time on your GPU"
              css: "color: #6b7280; margin-bottom: 2rem;"

            - ::
              type: "container"
              css: "display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap;"
              blocks::
                - ::
                  type: "button"
                  content: "Interference"
                  action: "setState"
                  stateUpdates::
                    selectedMathPattern: "interference"
                  css: "padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Moiré"
                  action: "setState"
                  stateUpdates::
                    selectedMathPattern: "moire"
                  css: "padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Polar Grid"
                  action: "setState"
                  stateUpdates::
                    selectedMathPattern: "polarGrid"
                  css: "padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Fibonacci"
                  action: "setState"
                  stateUpdates::
                    selectedMathPattern: "fibonacci"
                  css: "padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(distance(x, y, 30, 30) * 0.5 - time) + sin(distance(x, y, 70, 70) * 0.5 - time)"
              when: "${ selectedMathPattern == 'interference' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(x * 0.3 + time) * sin(y * 0.3 + time)"
              when: "${ selectedMathPattern == 'moire' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 12 + time)"
              when: "${ selectedMathPattern == 'polarGrid' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 21 + distance(x, y, 50, 50) * 0.382 - time)"
              when: "${ selectedMathPattern == 'fibonacci' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

    # Kaleidoscope Screen
    - ::
      type: "screen"
      id: "kaleidoscope"
      name: "Kaleidoscope"
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #92400e 0%, #f59e0b 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.95); padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🔆 Kaleidoscope"
                  css: "margin: 0; color: #92400e;"

                - ::
                  type: "button"
                  content: "← Gallery Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "text"
              content: "Symmetrical generative art patterns"
              css: "color: #6b7280; margin-bottom: 2rem;"

            - ::
              type: "container"
              css: "display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap;"
              blocks::
                - ::
                  type: "button"
                  content: "6-Fold"
                  action: "setState"
                  stateUpdates::
                    selectedKaleidoPattern: "sixfold"
                  css: "padding: 0.75rem 1.5rem; background: #f59e0b; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "8-Fold"
                  action: "setState"
                  stateUpdates::
                    selectedKaleidoPattern: "eightfold"
                  css: "padding: 0.75rem 1.5rem; background: #d97706; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Mandala"
                  action: "setState"
                  stateUpdates::
                    selectedKaleidoPattern: "mandala"
                  css: "padding: 0.75rem 1.5rem; background: #ea580c; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 6 + distance(x, y, 50, 50) * 0.3 - time)"
              when: "${ selectedKaleidoPattern == 'sixfold' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 8 + distance(x, y, 50, 50) * 0.3 - time)"
              when: "${ selectedKaleidoPattern == 'eightfold' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"

            - ::
              type: "canvas"
              renderMode: "gpu"
              width: 600
              height: 600
              gridSize: 100
              pattern: "sin(atan2(y - 50, x - 50) * 12) * cos(distance(x, y, 50, 50) * 0.4 - time)"
              when: "${ selectedKaleidoPattern == 'mandala' }"
              autoplay: true
              fps: 60
              css: "box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px;"
