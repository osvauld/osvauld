name: "Counter Demo"
version: "v1.0.0"

documents::
  count::
    type: "number"
    initial: 0
    document: "content_doc"

  message::
    type: "string"
    initial: "Hello, HUML!"
    document: "content_doc"

computed::
  isPositive::
    expr: "${ count > 0 }"
    deps::
      - "count"

  isNegative::
    expr: "${ count < 0 }"
    deps::
      - "count"

  countStatus::
    expr: "${ count == 0 ? 'zero' : (count > 0 ? 'positive' : 'negative') }"
    deps::
      - "count"

ui::
  publisher::
    - ::
      type: "screen"
      id: "main"
      name: "Counter Demo"
      isEntryPoint: true
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "Counter Demo"

        - ::
          type: "text"
          content: "A simple demo of Vello rendering HUML templates"

        - ::
          type: "section"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Current Count: {{count}}"

            - ::
              type: "text"
              content: "The count is positive!"
              when: "${ isPositive }"

            - ::
              type: "text"
              content: "The count is negative!"
              when: "${ isNegative }"

            - ::
              type: "text"
              content: "The count is zero."
              when: "${ count == 0 }"

            - ::
              type: "container"
              blocks::
                - ::
                  type: "button"
                  content: "Increment (+1)"
                  action: "setState"
                  stateUpdates::
                    count: "${ count + 1 }"

                - ::
                  type: "button"
                  content: "Decrement (-1)"
                  action: "setState"
                  stateUpdates::
                    count: "${ count - 1 }"

                - ::
                  type: "button"
                  content: "Reset"
                  action: "setState"
                  stateUpdates::
                    count: "${ 0 }"

        - ::
          type: "section"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Message"

            - ::
              type: "input"
              name: "message"
              placeholder: "Type a message..."

            - ::
              type: "text"
              content: "You typed: {{message}}"

  viewer::
    - ::
      type: "screen"
      id: "viewer_main"
      name: "Viewer"
      isEntryPoint: true
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "View Counter"

        - ::
          type: "text"
          content: "Current count: {{count}}"

        - ::
          type: "text"
          content: "Message: {{message}}"
