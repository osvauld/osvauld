name: "Viewer Navigation Test"
version: "v1.0.0"

ui::
  viewer::
    - ::
      type: "screen"
      id: "home"
      name: "Home"
      isEntryPoint: true
      css: "padding: 3rem; background: linear-gradient(135deg, #1e1e2e 0%, #0d0e13 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "max-width: 800px; margin: 0 auto;"
          blocks::
            - ::
              type: "heading"
              content: "Welcome to Viewer Mode"
              level: 1
              css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "This is a test template for the Sthalam viewer. Click the button below to navigate to Page 2."
              css: "font-size: 18px; color: #cdd6f4; text-align: center; margin-bottom: 2rem; line-height: 1.6;"

            - ::
              type: "button"
              content: "Go to Page 2 →"
              action: "navigate"
              targetScreen: "page2"
              css: "display: block; margin: 0 auto; padding: 1rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s;"

    - ::
      type: "screen"
      id: "page2"
      name: "Page 2"
      css: "padding: 3rem; background: linear-gradient(135deg, #2e1e3e 0%, #1d0e23 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "max-width: 800px; margin: 0 auto;"
          blocks::
            - ::
              type: "heading"
              content: "Page 2"
              level: 1
              css: "font-size: 42px; color: #f5c2e7; text-align: center; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "You've successfully navigated to page 2! This demonstrates screen navigation in viewer mode."
              css: "font-size: 18px; color: #cdd6f4; text-align: center; margin-bottom: 2rem; line-height: 1.6;"

            - ::
              type: "container"
              css: "display: flex; gap: 1rem; justify-content: center;"
              blocks::
                - ::
                  type: "button"
                  content: "← Back to Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 1rem 2rem; background: #f5c2e7; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s;"

                - ::
                  type: "button"
                  content: "Go to Page 3 →"
                  action: "navigate"
                  targetScreen: "page3"
                  css: "padding: 1rem 2rem; background: #94e2d5; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s;"

    - ::
      type: "screen"
      id: "page3"
      name: "Page 3"
      css: "padding: 3rem; background: linear-gradient(135deg, #1e3e2e 0%, #0d230e 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "max-width: 800px; margin: 0 auto;"
          blocks::
            - ::
              type: "heading"
              content: "Page 3 - Final Page"
              level: 1
              css: "font-size: 42px; color: #94e2d5; text-align: center; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "This is the final page in our test template. Multi-screen navigation is working perfectly!"
              css: "font-size: 18px; color: #cdd6f4; text-align: center; margin-bottom: 1.5rem; line-height: 1.6;"

            - ::
              type: "section"
              css: "background: rgba(148, 226, 213, 0.1); padding: 2rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid #94e2d5;"
              blocks::
                - ::
                  type: "heading"
                  content: "✓ Test Complete"
                  level: 3
                  css: "color: #94e2d5; margin-bottom: 1rem; font-size: 24px;"

                - ::
                  type: "text"
                  content: "If you can see this page and navigate between all three screens, the viewer rendering is working correctly!"
                  css: "color: #cdd6f4; font-size: 16px; line-height: 1.6;"

            - ::
              type: "button"
              content: "← Back to Home"
              action: "navigate"
              targetScreen: "home"
              css: "display: block; margin: 0 auto; padding: 1rem 2rem; background: #94e2d5; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s;"
