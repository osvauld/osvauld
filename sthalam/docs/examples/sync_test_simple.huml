name: "Sync Test Simple"
version: "v1.0.0"

documents::
  publisherState::
    title::
      type: "string"
      initial: "Welcome"

  collaborativeState::
    counter::
      type: "number"
      initial: 0
    newComment::
      type: "string"
      initial: ""
    comments::
      - ::
        id::
          type: "string"
        content::
          type: "string"
        author::
          type: "string"
        timestamp::
          type: "number"

ui::
  publisher::
    - ::
      type: "screen"
      id: "home"
      name: "home"
      isEntryPoint: true
      css: "padding: 2rem; font-family: system-ui; max-width: 600px; margin: 0 auto;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "Publisher: {{title}}"
          css: "color: #2563eb; margin-bottom: 2rem;"

        - ::
          type: "text"
          content: "Counter (Collaborative): {{counter}}"
          css: "font-size: 2rem; color: #10b981; margin-bottom: 2rem;"

        - ::
          type: "button"
          content: "Increment Counter"
          action: "setState"
          stateUpdates::
            counter: "${ counter + 1 }"
          css: "padding: 1rem 2rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; margin-bottom: 2rem;"

        - ::
          type: "section"
          css: "border: 2px solid #10b981; padding: 1.5rem; border-radius: 8px; margin-top: 2rem;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Comments (Collaborative)"
              css: "color: #10b981; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "Total: {{size(comments)}}"
              css: "color: #6b7280; margin-bottom: 1rem; font-size: 0.875rem;"

            - ::
              type: "container"
              layout: "flex"
              direction: "column"
              gap: "0.5rem"
              css: "margin-bottom: 1rem;"
              blocks::
                - ::
                  type: "container"
                  forEach: "${ comments }"
                  as: "item"
                  key: "id"
                  css: "padding: 0.75rem; background: #f3f4f6; border-radius: 4px;"
                  blocks::
                    - ::
                      type: "text"
                      content: "{{item.content}}"
                      css: "color: #1f2937; font-weight: 500;"
                    - ::
                      type: "text"
                      content: "— {{item.author}}"
                      css: "color: #6b7280; font-size: 0.75rem; margin-top: 0.25rem;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "0.5rem"
              blocks::
                - ::
                  type: "input"
                  name: "newComment"
                  inputType: "text"
                  placeholder: "Add a comment as Publisher..."
                  css: "flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;"

                - ::
                  type: "button"
                  content: "Add"
                  action: "setState"
                  stateUpdates::
                    comments: "${ comments + [{\"id\": string(now()), \"content\": newComment, \"author\": \"Publisher\", \"timestamp\": now()}] }"
                    newComment: ""
                  css: "padding: 0.5rem 1rem; background: #10b981; color: white; border: none; border-radius: 4px; cursor: pointer;"

  viewer::
    - ::
      type: "screen"
      id: "home"
      name: "home"
      isEntryPoint: true
      css: "padding: 2rem; font-family: system-ui; max-width: 600px; margin: 0 auto;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "Viewer: {{title}}"
          css: "color: #8b5cf6; margin-bottom: 2rem;"

        - ::
          type: "text"
          content: "Counter (Collaborative): {{counter}}"
          css: "font-size: 2rem; color: #10b981; margin-bottom: 2rem;"

        - ::
          type: "button"
          content: "Increment Counter"
          action: "setState"
          stateUpdates::
            counter: "${ counter + 1 }"
          css: "padding: 1rem 2rem; background: #8b5cf6; color: white; border: none; border-radius: 8px; cursor: pointer; margin-bottom: 2rem;"

        - ::
          type: "section"
          css: "border: 2px solid #8b5cf6; padding: 1.5rem; border-radius: 8px; margin-top: 2rem;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Comments (Collaborative)"
              css: "color: #8b5cf6; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "Total: {{size(comments)}}"
              css: "color: #6b7280; margin-bottom: 1rem; font-size: 0.875rem;"

            - ::
              type: "container"
              layout: "flex"
              direction: "column"
              gap: "0.5rem"
              css: "margin-bottom: 1rem;"
              blocks::
                - ::
                  type: "container"
                  forEach: "${ comments }"
                  as: "item"
                  key: "id"
                  css: "padding: 0.75rem; background: #f3f4f6; border-radius: 4px;"
                  blocks::
                    - ::
                      type: "text"
                      content: "{{item.content}}"
                      css: "color: #1f2937; font-weight: 500;"
                    - ::
                      type: "text"
                      content: "— {{item.author}}"
                      css: "color: #6b7280; font-size: 0.75rem; margin-top: 0.25rem;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "0.5rem"
              blocks::
                - ::
                  type: "input"
                  name: "newComment"
                  inputType: "text"
                  placeholder: "Add a comment as Viewer..."
                  css: "flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;"

                - ::
                  type: "button"
                  content: "Add"
                  action: "setState"
                  stateUpdates::
                    comments: "${ comments + [{\"id\": string(now()), \"content\": newComment, \"author\": \"Viewer\", \"timestamp\": now()}] }"
                    newComment: ""
                  css: "padding: 0.5rem 1rem; background: #8b5cf6; color: white; border: none; border-radius: 4px; cursor: pointer;"
