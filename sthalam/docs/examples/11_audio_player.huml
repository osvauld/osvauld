name: "Audio Player & Library"
version: "v1.0.0"

documents::
  contentDoc::
    audios::
      - ::
        id::
          type: "string"
          initial: ""
        audioId::
          type: "string"
          initial: ""
        title::
          type: "string"
          initial: ""
        artist::
          type: "string"
          initial: ""
        uploadedAt::
          type: "number"
          initial: 0

  publisherState::
    # Audio upload state
    audioTitle::
      type: "string"
      initial: ""
    audioArtist::
      type: "string"
      initial: ""
    uploadedAudioId::
      type: "string"
      initial: ""
    uploadingAudio::
      type: "boolean"
      initial: false

  publisherComputed::
    audioCount: "${ size(audios) }"
    hasAudios: "${ size(audios) > 0 }"
    hasUploadedAudio: "${ size(uploadedAudioId) > 0 }"
    canAddAudio: "${ size(uploadedAudioId) > 0 && size(audioTitle) > 0 }"

ui::
  publisher::
    - ::
      type: "screen"
      id: "player"
      name: "player"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;"
      blocks::
        # Main Header
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "🎵 Audio Player"
              css: "margin: 0 0 0.5rem 0; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"

            - ::
              type: "text"
              content: "Upload and manage your audio library. Audio files are stored in staticAssets with metadata in contentDoc."
              css: "color: #6b7280; margin: 0 0 1rem 0; line-height: 1.6;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "align-items: center;"
              blocks::
                - ::
                  type: "text"
                  content: "🎶 Total Tracks: {{audioCount}}"
                  css: "padding: 0.5rem 1rem; background: #dbeafe; border-radius: 8px; color: #1e40af; font-weight: 600;"

                - ::
                  type: "text"
                  content: "✅ Using OCaml-generated asset IDs"
                  css: "padding: 0.5rem 1rem; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 0.875rem;"

        # Upload Section
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "📤 Upload New Track"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # Track Title Input
            - ::
              type: "input"
              name: "audioTitle"
              placeholder: "Track title..."
              css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 0.75rem; font-size: 0.95rem;"

            # Artist Name Input
            - ::
              type: "input"
              name: "audioArtist"
              placeholder: "Artist name..."
              css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 1rem; font-size: 0.95rem;"

            # Upload Button
            - ::
              type: "button"
              content: "🎵 Choose Audio File"
              action: "uploadAudio"
              params::
                stateField: "uploadedAudioId"
              when: "${ !uploadingAudio }"
              css: "width: 100%; padding: 1rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 1rem; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4); transition: transform 0.2s; &:hover { transform: translateY(-2px); }"

            # Uploading State
            - ::
              type: "text"
              content: "⏳ Uploading to staticAssets..."
              when: "${ uploadingAudio }"
              css: "padding: 1rem; background: #dbeafe; border-radius: 8px; color: #1e40af; text-align: center; font-weight: 600;"

            # Just Uploaded Success
            - ::
              type: "container"
              when: "${ hasUploadedAudio }"
              css: "margin-top: 1.5rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
              blocks::
                - ::
                  type: "text"
                  content: "✅ Audio file uploaded! Click 'Add to Library' to save it."
                  css: "color: #065f46; font-weight: 600; margin-bottom: 1rem;"

                - ::
                  type: "text"
                  content: "Asset ID: {{uploadedAudioId}}"
                  css: "color: #047857; font-size: 0.75rem; font-family: monospace; margin-bottom: 1rem; word-break: break-all;"

                - ::
                  type: "button"
                  content: "➕ Add to Library"
                  action: "setState"
                  when: "${ canAddAudio }"
                  stateUpdates::
                    audios: "${ audios + [{\"id\": string(now()), \"audioId\": uploadedAudioId, \"title\": audioTitle, \"artist\": audioArtist, \"uploadedAt\": now()}] }"
                    audioTitle: ""
                    audioArtist: ""
                    uploadedAudioId: ""
                  css: "width: 100%; padding: 0.75rem 1.5rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

                - ::
                  type: "text"
                  content: "⚠️ Enter track title first"
                  when: "${ !canAddAudio }"
                  css: "color: #92400e; text-align: center; font-size: 0.875rem;"

        # Audio Library
        - ::
          type: "section"
          when: "${ hasAudios }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "🎶 Audio Library ({{audioCount}} tracks)"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # Audio List
            - ::
              type: "container"
              forEach: "audios"
              key: "id"
              css: "display: flex; flex-direction: column; gap: 1rem;"
              blocks::
                - ::
                  type: "container"
                  css: "border: 2px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #f9fafb;"
                  blocks::
                    # Track Info
                    - ::
                      type: "container"
                      css: "padding: 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
                      blocks::
                        - ::
                          type: "text"
                          content: "{{item.title}}"
                          css: "font-weight: 700; color: white; font-size: 1.1rem; margin-bottom: 0.25rem;"

                        - ::
                          type: "text"
                          content: "{{item.artist}}"
                          when: "${ size(item.artist) > 0 }"
                          css: "color: rgba(255, 255, 255, 0.9); font-size: 0.9rem;"

                    # Audio Player
                    - ::
                      type: "audio"
                      src: "{{item.audioId}}"
                      controls: true
                      css: "padding: 1rem;"

        # Empty State
        - ::
          type: "section"
          when: "${ !hasAudios }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🎵 No Audio Tracks Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first audio file to start building your library! Supports MP3, OGG, AAC, FLAC, and M4A formats."
              css: "color: #9ca3af; margin: 0; line-height: 1.6;"

        # Technical Info Footer
        - ::
          type: "section"
          css: "background: rgba(255,255,255,0.9); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; backdrop-filter: blur(10px);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🔧 Technical Details"
              css: "margin: 0 0 1rem 0; color: #667eea; font-size: 1rem;"

            - ::
              type: "text"
              content: "✨ Asset IDs generated by OCaml WASM (generateAssetId)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Audio binaries stored in staticAssets Map (non-CRDT)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Audio IDs & metadata stored in contentDoc (CRDT, syncs to viewers)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ HTML5 audio player with controls (play/pause/seek/volume)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Supported formats: MP3, OGG, AAC, FLAC, M4A"
              css: "color: #374151; font-size: 0.875rem; padding-left: 1rem;"
