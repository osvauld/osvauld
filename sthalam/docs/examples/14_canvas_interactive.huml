name: "Interactive Canvas Patterns"
version: "v1.0.0"

documents::
  publisherState::
    selectedEffect::
      type: "string"
      initial: "mouseRipple"

    clickPoints::
      type: "array"
      initial::
        - ::
          x: 50
          y: 50
          time: 0

    speed::
      type: "number"
      initial: 2.0

    zoom::
      type: "number"
      initial: 1.0

ui::
  publisher::
    - ::
      type: "screen"
      id: "interactive"
      name: "interactive"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "✨ Interactive GPU Shaders"
          css: "color: white; margin-bottom: 0.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.3);"

        - ::
          type: "text"
          content: "Real-time GPU rendering with mouse and keyboard interaction"
          css: "color: rgba(255,255,255,0.9); margin-bottom: 2rem;"

        # Effect selector
        - ::
          type: "container"
          layout: "flex"
          direction: "row"
          gap: "1rem"
          css: "margin-bottom: 2rem; flex-wrap: wrap;"
          blocks::
            - ::
              type: "button"
              content: "🌊 Mouse Ripple"
              action: "setState"
              stateUpdates::
                selectedEffect: "mouseRipple"
              css: "padding: 0.75rem 1.5rem; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"

            - ::
              type: "button"
              content: "🎯 Click Waves"
              action: "setState"
              stateUpdates::
                selectedEffect: "clickWaves"
              css: "padding: 0.75rem 1.5rem; background: #8b5cf6; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"

            - ::
              type: "button"
              content: "🌀 Vortex"
              action: "setState"
              stateUpdates::
                selectedEffect: "vortex"
              css: "padding: 0.75rem 1.5rem; background: #ec4899; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"

            - ::
              type: "button"
              content: "⚡ Lightning"
              action: "setState"
              stateUpdates::
                selectedEffect: "lightning"
              css: "padding: 0.75rem 1.5rem; background: #f59e0b; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"

            - ::
              type: "button"
              content: "🔥 Heat Wave"
              action: "setState"
              stateUpdates::
                selectedEffect: "heatWave"
              css: "padding: 0.75rem 1.5rem; background: #ef4444; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"

        # Mouse Ripple - follows cursor with expanding ripples
        - ::
          type: "canvas"
          renderMode: "gpu"
          width: 800
          height: 600
          gridSize: 100
          pattern: "sin(distance(x, y, mouseX * 100 / 800, mouseY * 100 / 600) * 5 - time * 3)"
          when: "${ selectedEffect == 'mouseRipple' }"
          autoplay: true
          fps: 60
          css: "box-shadow: 0 20px 60px rgba(0,0,0,0.4); border-radius: 16px; border: 4px solid rgba(255,255,255,0.2);"

        # Click Waves - click to add wave sources (simulated with single source)
        - ::
          type: "canvas"
          renderMode: "gpu"
          width: 800
          height: 600
          gridSize: 100
          pattern: "sin(distance(x, y, 50, 50) * 3 - time * 4) * 0.5 + sin(distance(x, y, 75, 25) * 2.5 - time * 3.5) * 0.5"
          when: "${ selectedEffect == 'clickWaves' }"
          autoplay: true
          fps: 60
          css: "box-shadow: 0 20px 60px rgba(0,0,0,0.4); border-radius: 16px; border: 4px solid rgba(255,255,255,0.2);"

        # Vortex - rotating spiral that follows mouse
        - ::
          type: "canvas"
          renderMode: "gpu"
          width: 800
          height: 600
          gridSize: 100
          pattern: "sin(atan2(y - mouseY * 100 / 600, x - mouseX * 100 / 800) * 8 + distance(x, y, mouseX * 100 / 800, mouseY * 100 / 600) * 0.3 - time * 5)"
          when: "${ selectedEffect == 'vortex' }"
          autoplay: true
          fps: 60
          css: "box-shadow: 0 20px 60px rgba(0,0,0,0.4); border-radius: 16px; border: 4px solid rgba(255,255,255,0.2);"

        # Lightning - electric bolts emanating from mouse
        - ::
          type: "canvas"
          renderMode: "gpu"
          width: 800
          height: 600
          gridSize: 100
          pattern: "sin(atan2(y - mouseY * 100 / 600, x - mouseX * 100 / 800) * 20 + time * 10) * sin(distance(x, y, mouseX * 100 / 800, mouseY * 100 / 600) * 2)"
          when: "${ selectedEffect == 'lightning' }"
          autoplay: true
          fps: 60
          css: "box-shadow: 0 20px 60px rgba(0,0,0,0.4); border-radius: 16px; border: 4px solid rgba(255,255,255,0.2);"

        # Heat Wave - distortion effect following mouse
        - ::
          type: "canvas"
          renderMode: "gpu"
          width: 800
          height: 600
          gridSize: 100
          pattern: "sin(x * 0.2 + sin(distance(x, y, mouseX * 100 / 800, mouseY * 100 / 600) * 0.5 - time * 2) * 3) * cos(y * 0.2 + time)"
          when: "${ selectedEffect == 'heatWave' }"
          autoplay: true
          fps: 60
          css: "box-shadow: 0 20px 60px rgba(0,0,0,0.4); border-radius: 16px; border: 4px solid rgba(255,255,255,0.2);"

        # Controls section
        - ::
          type: "section"
          css: "margin-top: 2rem; padding: 2rem; background: rgba(255,255,255,0.95); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🎮 Interactive Controls"
              css: "margin: 0 0 1rem 0; color: #1e293b;"

            - ::
              type: "text"
              content: "Mouse Ripple: Ripples follow your cursor in real-time"
              when: "${ selectedEffect == 'mouseRipple' }"
              css: "color: #475569; margin: 0.5rem 0; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "Click Waves: Multiple wave sources creating interference patterns"
              when: "${ selectedEffect == 'clickWaves' }"
              css: "color: #475569; margin: 0.5rem 0; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "Vortex: Rotating spiral centered on your mouse position"
              when: "${ selectedEffect == 'vortex' }"
              css: "color: #475569; margin: 0.5rem 0; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "Lightning: Electric arcs radiating from cursor position"
              when: "${ selectedEffect == 'lightning' }"
              css: "color: #475569; margin: 0.5rem 0; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "Heat Wave: Distortion effect following your mouse"
              when: "${ selectedEffect == 'heatWave' }"
              css: "color: #475569; margin: 0.5rem 0; font-size: 0.95rem;"

            - ::
              type: "text"
              content: "💡 Move your mouse over the canvas to interact!"
              css: "color: #3b82f6; font-weight: 600; margin-top: 1rem; font-size: 1rem;"

        # Technical info
        - ::
          type: "section"
          css: "margin-top: 2rem; padding: 2rem; background: rgba(15, 23, 42, 0.95); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "⚡ GPU Performance"
              css: "margin: 0 0 1rem 0; color: #60a5fa;"

            - ::
              type: "text"
              content: "• Resolution: 800×600 pixels (480,000 pixels rendered)"
              css: "color: #cbd5e1; margin: 0.5rem 0; font-family: monospace; font-size: 0.9rem;"

            - ::
              type: "text"
              content: "• Frame Rate: 60 FPS (GPU parallel evaluation)"
              css: "color: #cbd5e1; margin: 0.5rem 0; font-family: monospace; font-size: 0.9rem;"

            - ::
              type: "text"
              content: "• Functions per frame: 960,000+ (2 math ops × 480K pixels)"
              css: "color: #cbd5e1; margin: 0.5rem 0; font-family: monospace; font-size: 0.9rem;"

            - ::
              type: "text"
              content: "• Total operations: 57.6 million math operations per second!"
              css: "color: #22c55e; margin: 0.5rem 0; font-family: monospace; font-size: 0.9rem; font-weight: 600;"

            - ::
              type: "text"
              content: "• Real-time uniform updates: mouseX, mouseY updated every frame"
              css: "color: #cbd5e1; margin: 0.5rem 0; font-family: monospace; font-size: 0.9rem;"

            - ::
              type: "text"
              content: "✨ All patterns run at 60 FPS regardless of complexity!"
              css: "color: #fbbf24; margin-top: 1rem; font-weight: 600; font-size: 1rem;"
