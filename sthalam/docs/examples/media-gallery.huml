name: "Media Gallery Showcase"
version: "v2.0.0"

types::
  MediaItem::
    id::
      type: "string"
    assetId::
      type: "string"
    title::
      type: "string"
    uploadedAt::
      type: "number"

  AudioTrack::
    id::
      type: "string"
    assetId::
      type: "string"
    title::
      type: "string"
    artist::
      type: "string"
    uploadedAt::
      type: "number"

documents::
  # Persistent media collections (CRDT synced)
  videos::
    type: "array"
    items: "MediaItem"
    initial:: []
    document: "content_doc"

  images::
    type: "array"
    items: "MediaItem"
    initial:: []
    document: "content_doc"

  audios::
    type: "array"
    items: "AudioTrack"
    initial:: []
    document: "content_doc"

  # Upload state (per-user, non-collaborative)
  currentVideoTitle::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadedVideoId::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadingVideo::
    type: "boolean"
    initial: false
    document: "user_content_doc"

  currentImageTitle::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadedImageId::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadingImage::
    type: "boolean"
    initial: false
    document: "user_content_doc"

  currentAudioTitle::
    type: "string"
    initial: ""
    document: "user_content_doc"

  currentAudioArtist::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadedAudioId::
    type: "string"
    initial: ""
    document: "user_content_doc"

  uploadingAudio::
    type: "boolean"
    initial: false
    document: "user_content_doc"

computed::
  # Video computed values
  videoCount::
    expr: "${ size(videos) }"
    deps::
      - "videos"

  hasVideos::
    expr: "${ size(videos) > 0 }"
    deps::
      - "videos"

  hasUploadedVideo::
    expr: "${ size(uploadedVideoId) > 0 }"
    deps::
      - "uploadedVideoId"

  canAddVideo::
    expr: "${ hasUploadedVideo && size(currentVideoTitle) > 0 }"
    deps::
      - "hasUploadedVideo"
      - "currentVideoTitle"

  # Image computed values
  imageCount::
    expr: "${ size(images) }"
    deps::
      - "images"

  hasImages::
    expr: "${ size(images) > 0 }"
    deps::
      - "images"

  hasUploadedImage::
    expr: "${ size(uploadedImageId) > 0 }"
    deps::
      - "uploadedImageId"

  canAddImage::
    expr: "${ hasUploadedImage && size(currentImageTitle) > 0 }"
    deps::
      - "hasUploadedImage"
      - "currentImageTitle"

  # Audio computed values
  audioCount::
    expr: "${ size(audios) }"
    deps::
      - "audios"

  hasAudios::
    expr: "${ size(audios) > 0 }"
    deps::
      - "audios"

  hasUploadedAudio::
    expr: "${ size(uploadedAudioId) > 0 }"
    deps::
      - "uploadedAudioId"

  canAddAudio::
    expr: "${ hasUploadedAudio && size(currentAudioTitle) > 0 }"
    deps::
      - "hasUploadedAudio"
      - "currentAudioTitle"

  # Total media count
  totalMediaCount::
    expr: "${ videoCount + imageCount + audioCount }"
    deps::
      - "videoCount"
      - "imageCount"
      - "audioCount"

ui::
  publisher::
    # Home Screen
    - ::
      type: "screen"
      id: "home"
      name: "Media Library"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "📚 Media Library"
              css: "margin: 0 0 0.5rem 0; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"

            - ::
              type: "text"
              content: "Manage all your media in one place - videos, images, and audio files."
              css: "color: #6b7280; margin: 0 0 1.5rem 0; line-height: 1.6;"

            - ::
              type: "container"
              css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "container"
                  css: "padding: 1rem; background: #dbeafe; border-radius: 8px; text-align: center;"
                  blocks::
                    - ::
                      type: "text"
                      content: "🎬 Videos"
                      css: "font-weight: 600; color: #1e40af; margin-bottom: 0.5rem;"

                    - ::
                      type: "text"
                      content: "{{videoCount}}"
                      css: "font-size: 2rem; font-weight: 700; color: #2563eb;"

                - ::
                  type: "container"
                  css: "padding: 1rem; background: #fce7f3; border-radius: 8px; text-align: center;"
                  blocks::
                    - ::
                      type: "text"
                      content: "🖼️ Images"
                      css: "font-weight: 600; color: #9f1239; margin-bottom: 0.5rem;"

                    - ::
                      type: "text"
                      content: "{{imageCount}}"
                      css: "font-size: 2rem; font-weight: 700; color: #db2777;"

                - ::
                  type: "container"
                  css: "padding: 1rem; background: #f0fdf4; border-radius: 8px; text-align: center;"
                  blocks::
                    - ::
                      type: "text"
                      content: "🎵 Audio"
                      css: "font-weight: 600; color: #14532d; margin-bottom: 0.5rem;"

                    - ::
                      type: "text"
                      content: "{{audioCount}}"
                      css: "font-size: 2rem; font-weight: 700; color: #16a34a;"

            - ::
              type: "container"
              css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;"
              blocks::
                - ::
                  type: "button"
                  content: "🎬 Video Library"
                  action: "navigate"
                  targetScreen: "videos"
                  css: "padding: 1.5rem; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 1.1rem; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);"

                - ::
                  type: "button"
                  content: "🖼️ Image Gallery"
                  action: "navigate"
                  targetScreen: "images"
                  css: "padding: 1.5rem; background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 1.1rem; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);"

                - ::
                  type: "button"
                  content: "🎵 Audio Player"
                  action: "navigate"
                  targetScreen: "audios"
                  css: "padding: 1.5rem; background: linear-gradient(135deg, #22c55e 0%, #15803d 100%); color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 1.1rem; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.4);"

        - ::
          type: "container"
          css: "background: rgba(255,255,255,0.9); padding: 1.5rem; border-radius: 12px; backdrop-filter: blur(10px);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "✨ Features"
              css: "margin: 0 0 1rem 0; color: #111827;"

            - ::
              type: "text"
              content: "• Upload and manage videos, images, and audio files"
              css: "color: #374151; margin-bottom: 0.5rem;"

            - ::
              type: "text"
              content: "• Media binaries stored in static_assets (efficient storage)"
              css: "color: #374151; margin-bottom: 0.5rem;"

            - ::
              type: "text"
              content: "• Metadata syncs via content_doc (CRDT collaboration)"
              css: "color: #374151; margin-bottom: 0.5rem;"

            - ::
              type: "text"
              content: "• OCaml-generated unique asset IDs"
              css: "color: #374151;"

    # Video Library Screen
    - ::
      type: "screen"
      id: "videos"
      name: "Videos"
      css: "padding: 2rem; max-width: 1400px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🎬 Video Library"
                  css: "margin: 0; color: #1e40af;"

                - ::
                  type: "button"
                  content: "← Back to Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "text"
                  content: "Total Videos: {{videoCount}}"
                  css: "color: #6b7280; font-size: 1.1rem; font-weight: 600;"

                - ::
                  type: "button"
                  content: "🗑️ Clear All"
                  action: "setState"
                  when: "${ hasVideos }"
                  stateUpdates::
                    videos: "${ [] }"
                  css: "padding: 0.5rem 1rem; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.875rem; font-weight: 600;"

            # Upload Section
            - ::
              type: "container"
              css: "padding: 1.5rem; background: #f9fafb; border-radius: 12px; margin-bottom: 2rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "📤 Upload New Video"
                  css: "margin: 0 0 1rem 0; color: #111827; font-size: 1.25rem;"

                - ::
                  type: "input"
                  name: "currentVideoTitle"
                  placeholder: "Enter video title..."
                  css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 1rem; font-size: 1rem;"

                - ::
                  type: "button"
                  content: "🎬 Choose Video File"
                  action: "uploadVideo"
                  params::
                    stateField: "uploadedVideoId"
                  when: "${ !uploadingVideo }"
                  css: "width: 100%; padding: 1rem; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);"

                - ::
                  type: "text"
                  content: "⏳ Uploading video..."
                  when: "${ uploadingVideo }"
                  css: "padding: 1rem; background: #dbeafe; border-radius: 8px; color: #1e40af; text-align: center; font-weight: 600;"

                - ::
                  type: "container"
                  when: "${ hasUploadedVideo }"
                  css: "margin-top: 1rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
                  blocks::
                    - ::
                      type: "text"
                      content: "✅ Video uploaded! Asset ID: {{uploadedVideoId}}"
                      css: "color: #065f46; font-weight: 600; margin-bottom: 1rem; word-break: break-all; font-size: 0.875rem;"

                    - ::
                      type: "button"
                      content: "➕ Add to Library"
                      action: "setState"
                      when: "${ canAddVideo }"
                      stateUpdates::
                        videos: "${ videos + [{\"id\": string(now()), \"assetId\": uploadedVideoId, \"title\": currentVideoTitle, \"uploadedAt\": now()}] }"
                        currentVideoTitle: ""
                        uploadedVideoId: ""
                      css: "width: 100%; padding: 0.75rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

                    - ::
                      type: "text"
                      content: "⚠️ Enter a title first"
                      when: "${ !canAddVideo }"
                      css: "color: #92400e; text-align: center; font-size: 0.875rem;"

        # Video Grid
        - ::
          type: "container"
          when: "${ hasVideos }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "📹 Your Videos"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            - ::
              type: "loop"
              each: "${ videos }"
              as: "video"
              key: "id"
              blocks::
                - ::
                  type: "container"
                  css: "border: 2px solid #e5e7eb; border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; background: #f9fafb;"
                  blocks::
                    - ::
                      type: "video"
                      src: "{{video.assetId}}"
                      controls: true
                      muted: true
                      width: "100%"
                      css: "display: block;"

                    - ::
                      type: "container"
                      css: "padding: 1rem;"
                      blocks::
                        - ::
                          type: "heading"
                          level: 3
                          content: "{{video.title}}"
                          css: "margin: 0 0 0.5rem 0; color: #111827; font-size: 1.1rem;"

                        - ::
                          type: "text"
                          content: "Asset ID: {{video.assetId}}"
                          css: "font-size: 0.75rem; color: #6b7280; font-family: monospace; word-break: break-all;"

        # Empty State
        - ::
          type: "container"
          when: "${ !hasVideos }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "📹 No Videos Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first video to get started! Supported formats: MP4, WebM, OGG"
              css: "color: #9ca3af; margin: 0;"

    # Image Gallery Screen
    - ::
      type: "screen"
      id: "images"
      name: "Images"
      css: "padding: 2rem; max-width: 1400px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🖼️ Image Gallery"
                  css: "margin: 0; color: #9f1239;"

                - ::
                  type: "button"
                  content: "← Back to Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "text"
              content: "Total Images: {{imageCount}}"
              css: "color: #6b7280; margin-bottom: 1.5rem; font-size: 1.1rem; font-weight: 600;"

            # Upload Section
            - ::
              type: "container"
              css: "padding: 1.5rem; background: #f9fafb; border-radius: 12px; margin-bottom: 2rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "📤 Upload New Image"
                  css: "margin: 0 0 1rem 0; color: #111827; font-size: 1.25rem;"

                - ::
                  type: "input"
                  name: "currentImageTitle"
                  placeholder: "Enter image title..."
                  css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 1rem; font-size: 1rem;"

                - ::
                  type: "button"
                  content: "🖼️ Choose Image File"
                  action: "uploadImage"
                  params::
                    stateField: "uploadedImageId"
                  when: "${ !uploadingImage }"
                  css: "width: 100%; padding: 1rem; background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);"

                - ::
                  type: "text"
                  content: "⏳ Uploading image..."
                  when: "${ uploadingImage }"
                  css: "padding: 1rem; background: #fce7f3; border-radius: 8px; color: #9f1239; text-align: center; font-weight: 600;"

                - ::
                  type: "container"
                  when: "${ hasUploadedImage }"
                  css: "margin-top: 1rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
                  blocks::
                    - ::
                      type: "text"
                      content: "✅ Image uploaded! Asset ID: {{uploadedImageId}}"
                      css: "color: #065f46; font-weight: 600; margin-bottom: 1rem; word-break: break-all; font-size: 0.875rem;"

                    - ::
                      type: "button"
                      content: "➕ Add to Gallery"
                      action: "setState"
                      when: "${ canAddImage }"
                      stateUpdates::
                        images: "${ images + [{\"id\": string(now()), \"assetId\": uploadedImageId, \"title\": currentImageTitle, \"uploadedAt\": now()}] }"
                        currentImageTitle: ""
                        uploadedImageId: ""
                      css: "width: 100%; padding: 0.75rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

                    - ::
                      type: "text"
                      content: "⚠️ Enter a title first"
                      when: "${ !canAddImage }"
                      css: "color: #92400e; text-align: center; font-size: 0.875rem;"

        # Image Grid
        - ::
          type: "container"
          when: "${ hasImages }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "🎨 Your Images"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            - ::
              type: "container"
              css: "display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;"
              blocks::
                - ::
                  type: "loop"
                  each: "${ images }"
                  as: "image"
                  key: "id"
                  blocks::
                    - ::
                      type: "container"
                      css: "border: 2px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #f9fafb;"
                      blocks::
                        - ::
                          type: "image"
                          src: "{{image.assetId}}"
                          alt: "{{image.title}}"
                          width: "100%"
                          css: "display: block; aspect-ratio: 1/1; object-fit: cover;"

                        - ::
                          type: "container"
                          css: "padding: 1rem;"
                          blocks::
                            - ::
                              type: "heading"
                              level: 3
                              content: "{{image.title}}"
                              css: "margin: 0 0 0.5rem 0; color: #111827; font-size: 1.1rem;"

                            - ::
                              type: "text"
                              content: "{{image.assetId}}"
                              css: "font-size: 0.75rem; color: #6b7280; font-family: monospace; word-break: break-all;"

        # Empty State
        - ::
          type: "container"
          when: "${ !hasImages }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🖼️ No Images Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first image to get started! Supported formats: PNG, JPG, GIF, WebP"
              css: "color: #9ca3af; margin: 0;"

    # Audio Player Screen
    - ::
      type: "screen"
      id: "audios"
      name: "Audio"
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #22c55e 0%, #15803d 100%); min-height: 100vh;"
      blocks::
        - ::
          type: "container"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); margin-bottom: 2rem;"
          blocks::
            - ::
              type: "container"
              css: "display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 1
                  content: "🎵 Audio Library"
                  css: "margin: 0; color: #14532d;"

                - ::
                  type: "button"
                  content: "← Back to Home"
                  action: "navigate"
                  targetScreen: "home"
                  css: "padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            - ::
              type: "text"
              content: "Total Tracks: {{audioCount}}"
              css: "color: #6b7280; margin-bottom: 1.5rem; font-size: 1.1rem; font-weight: 600;"

            # Upload Section
            - ::
              type: "container"
              css: "padding: 1.5rem; background: #f9fafb; border-radius: 12px; margin-bottom: 2rem;"
              blocks::
                - ::
                  type: "heading"
                  level: 2
                  content: "📤 Upload New Track"
                  css: "margin: 0 0 1rem 0; color: #111827; font-size: 1.25rem;"

                - ::
                  type: "input"
                  name: "currentAudioTitle"
                  placeholder: "Track title..."
                  css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 0.75rem; font-size: 1rem;"

                - ::
                  type: "input"
                  name: "currentAudioArtist"
                  placeholder: "Artist name..."
                  css: "width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; margin-bottom: 1rem; font-size: 1rem;"

                - ::
                  type: "button"
                  content: "🎵 Choose Audio File"
                  action: "uploadAudio"
                  params::
                    stateField: "uploadedAudioId"
                  when: "${ !uploadingAudio }"
                  css: "width: 100%; padding: 1rem; background: linear-gradient(135deg, #22c55e 0%, #15803d 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.4);"

                - ::
                  type: "text"
                  content: "⏳ Uploading audio..."
                  when: "${ uploadingAudio }"
                  css: "padding: 1rem; background: #f0fdf4; border-radius: 8px; color: #14532d; text-align: center; font-weight: 600;"

                - ::
                  type: "container"
                  when: "${ hasUploadedAudio }"
                  css: "margin-top: 1rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
                  blocks::
                    - ::
                      type: "text"
                      content: "✅ Audio uploaded! Asset ID: {{uploadedAudioId}}"
                      css: "color: #065f46; font-weight: 600; margin-bottom: 1rem; word-break: break-all; font-size: 0.875rem;"

                    - ::
                      type: "button"
                      content: "➕ Add to Library"
                      action: "setState"
                      when: "${ canAddAudio }"
                      stateUpdates::
                        audios: "${ audios + [{\"id\": string(now()), \"assetId\": uploadedAudioId, \"title\": currentAudioTitle, \"artist\": currentAudioArtist, \"uploadedAt\": now()}] }"
                        currentAudioTitle: ""
                        currentAudioArtist: ""
                        uploadedAudioId: ""
                      css: "width: 100%; padding: 0.75rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

                    - ::
                      type: "text"
                      content: "⚠️ Enter a title first"
                      when: "${ !canAddAudio }"
                      css: "color: #92400e; text-align: center; font-size: 0.875rem;"

        # Audio List
        - ::
          type: "container"
          when: "${ hasAudios }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "🎶 Your Tracks"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            - ::
              type: "loop"
              each: "${ audios }"
              as: "track"
              key: "id"
              blocks::
                - ::
                  type: "container"
                  css: "border: 2px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #f9fafb; margin-bottom: 1rem;"
                  blocks::
                    - ::
                      type: "container"
                      css: "padding: 1rem; background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);"
                      blocks::
                        - ::
                          type: "text"
                          content: "{{track.title}}"
                          css: "font-weight: 700; color: white; font-size: 1.1rem; margin-bottom: 0.25rem;"

                        - ::
                          type: "text"
                          content: "{{track.artist}}"
                          when: "${ size(track.artist) > 0 }"
                          css: "color: rgba(255, 255, 255, 0.9); font-size: 0.9rem;"

                    - ::
                      type: "audio"
                      src: "{{track.assetId}}"
                      controls: true
                      css: "padding: 1rem; width: 100%; box-sizing: border-box;"

        # Empty State
        - ::
          type: "container"
          when: "${ !hasAudios }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🎵 No Audio Tracks Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first audio file to start building your library! Supported formats: MP3, OGG, AAC, FLAC, M4A"
              css: "color: #9ca3af; margin: 0;"
