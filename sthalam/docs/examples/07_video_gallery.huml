name: "Video Gallery"
version: "v1.0.0"

documents::
  contentDoc::
    videos::
      - ::
        id::
          type: "string"
          initial: ""
        videoId::
          type: "string"
          initial: ""
        title::
          type: "string"
          initial: ""
        uploadedAt::
          type: "number"
          initial: 0

  publisherState::
    currentTitle::
      type: "string"
      initial: ""
    uploadedVideoId::
      type: "string"
      initial: ""
    uploadedVideoFilename::
      type: "string"
      initial: ""
    uploadedVideoSize::
      type: "number"
      initial: 0
    uploading::
      type: "boolean"
      initial: false

  publisherComputed::
    videoCount: "${ size(videos) }"
    hasVideos: "${ size(videos) > 0 }"
    isUploading: "${ uploading == true }"
    hasUploadedVideo: "${ size(uploadedVideoId) > 0 }"

ui::
  publisher::
    - ::
      type: "screen"
      id: "gallery"
      name: "gallery"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: system-ui; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;"
      blocks::
        # Header
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "🎬 Video Gallery"
              css: "margin: 0 0 0.5rem 0; color: #667eea; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"

            - ::
              type: "text"
              content: "Upload videos and manage your personal collection. Videos are stored in staticAssets (non-CRDT) with IDs in contentDoc (CRDT)."
              css: "color: #6b7280; margin: 0 0 1rem 0; line-height: 1.6;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "align-items: center;"
              blocks::
                - ::
                  type: "text"
                  content: "📊 Total Videos: {{videoCount}}"
                  css: "padding: 0.5rem 1rem; background: #eff6ff; border-radius: 8px; color: #1e40af; font-weight: 600;"

                - ::
                  type: "text"
                  content: "✅ Using OCaml-generated asset IDs"
                  css: "padding: 0.5rem 1rem; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 0.875rem;"

        # Upload Section
        - ::
          type: "section"
          css: "background: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "📤 Upload New Video"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # Title Input
            - ::
              type: "input"
              name: "currentTitle"
              placeholder: "Enter video title..."
              css: "width: 100%; padding: 0.75rem 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; margin-bottom: 1rem;"

            # Upload Button (not uploading)
            - ::
              type: "button"
              content: "🎬 Choose Video File"
              action: "uploadVideo"
              params::
                stateField: "uploadedVideoId"
              when: "${ !isUploading }"
              css: "padding: 1rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 1rem; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4); transition: transform 0.2s; &:hover { transform: translateY(-2px); }"

            # Uploading State
            - ::
              type: "container"
              when: "${ isUploading }"
              css: "padding: 1rem; background: #eff6ff; border-radius: 8px; border: 2px solid #3b82f6;"
              blocks::
                - ::
                  type: "text"
                  content: "⏳ Uploading to staticAssets..."
                  css: "color: #1e40af; font-weight: 600; margin: 0;"

            # Just Uploaded Success
            - ::
              type: "container"
              when: "${ hasUploadedVideo && size(currentTitle) > 0 }"
              css: "margin-top: 1.5rem; padding: 1rem; background: #d1fae5; border-radius: 8px; border: 2px solid #10b981;"
              blocks::
                - ::
                  type: "text"
                  content: "✅ Video uploaded! Click 'Add to Gallery' to save it."
                  css: "color: #065f46; font-weight: 600; margin-bottom: 1rem;"

                - ::
                  type: "text"
                  content: "Asset ID: {{uploadedVideoId}}"
                  css: "color: #047857; font-size: 0.75rem; font-family: monospace; margin-bottom: 0.5rem;"

                - ::
                  type: "button"
                  content: "➕ Add to Gallery"
                  action: "setState"
                  stateUpdates::
                    videos: "${ videos + [{\"id\": string(now()), \"videoId\": uploadedVideoId, \"title\": currentTitle, \"uploadedAt\": now()}] }"
                    currentTitle: ""
                    uploadedVideoId: ""
                    uploadedVideoFilename: ""
                    uploadedVideoSize: 0
                  css: "padding: 0.75rem 1.5rem; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;"

            # Need Title Warning
            - ::
              type: "container"
              when: "${ hasUploadedVideo && size(currentTitle) == 0 }"
              css: "margin-top: 1.5rem; padding: 1rem; background: #fef3c7; border-radius: 8px; border: 2px dashed #f59e0b;"
              blocks::
                - ::
                  type: "text"
                  content: "⚠️ Please enter a title for your video"
                  css: "color: #92400e; font-weight: 600; margin: 0;"

        # Video Gallery Grid
        - ::
          type: "section"
          when: "${ hasVideos }"
          css: "background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "🎞️ Your Videos ({{videoCount}})"
              css: "margin: 0 0 1.5rem 0; color: #111827;"

            # Video Grid
            - ::
              type: "container"
              forEach: "videos"
              css: "display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem;"
              blocks::
                - ::
                  type: "container"
                  css: "border: 2px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #f9fafb; transition: transform 0.2s, box-shadow 0.2s; &:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }"
                  blocks::
                    # Video Player
                    - ::
                      type: "video"
                      src: "{{item.videoId}}"
                      controls: true
                      muted: true
                      width: "100%"
                      css: "display: block; background: #000; aspect-ratio: 16/9; object-fit: contain;"

                    # Video Info
                    - ::
                      type: "container"
                      css: "padding: 1rem;"
                      blocks::
                        - ::
                          type: "heading"
                          level: 3
                          content: "{{item.title}}"
                          css: "margin: 0 0 0.5rem 0; color: #111827; font-size: 1.1rem;"

                        - ::
                          type: "text"
                          content: "Asset ID: {{item.videoId}}"
                          css: "font-size: 0.75rem; color: #6b7280; font-family: monospace; word-break: break-all; margin: 0;"

        # Empty State
        - ::
          type: "section"
          when: "${ !hasVideos }"
          css: "background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); text-align: center;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "📹 No Videos Yet"
              css: "margin: 0 0 1rem 0; color: #6b7280; font-size: 1.5rem;"

            - ::
              type: "text"
              content: "Upload your first video to get started! Videos will be stored in staticAssets with IDs persisted in contentDoc."
              css: "color: #9ca3af; margin: 0; line-height: 1.6;"

        # Technical Info Footer
        - ::
          type: "section"
          css: "background: rgba(255,255,255,0.9); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; backdrop-filter: blur(10px);"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "🔧 Technical Details"
              css: "margin: 0 0 1rem 0; color: #667eea; font-size: 1rem;"

            - ::
              type: "text"
              content: "✨ Asset IDs generated by OCaml WASM (generateAssetId)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Video binaries stored in staticAssets Map (non-CRDT)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Video IDs & metadata stored in contentDoc (CRDT, syncs to viewers)"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ State persists across app restarts via publisherState"
              css: "color: #374151; margin-bottom: 0.5rem; font-size: 0.875rem; padding-left: 1rem;"

            - ::
              type: "text"
              content: "✨ Blob URLs created from staticAssets for HTML5 video playback"
              css: "color: #374151; font-size: 0.875rem; padding-left: 1rem;"
