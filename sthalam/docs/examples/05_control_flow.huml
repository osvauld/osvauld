name: "Control Flow Test"
version: "v1.0.0"

documents::
  publisherState::
    counter::
      type: "number"
      initial: 5
    viewMode::
      type: "string"
      initial: "grid"
    showAdvanced::
      type: "boolean"
      initial: false
    items::
      type: "array"
      initial::
        - ::
          id: 1
          title: "First Item"
          price: 10
        - ::
          id: 2
          title: "Second Item"
          price: 20
        - ::
          id: 3
          title: "Third Item"
          price: 30

  publisherComputed::
    isPositive: "${ counter > 0 }"
    isNegative: "${ counter < 0 }"
    itemCount: "${ size(items) }"

ui::
  publisher::
    - ::
      type: "screen"
      id: "control_flow_test"
      name: "control_flow_test"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 1000px; margin: 0 auto; font-family: system-ui;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "Control Flow Tests"
          css: "color: #2563eb; margin-bottom: 2rem;"

        # ======================
        # IF/ELSE CONTROL FLOW
        # ======================
        - ::
          type: "section"
          css: "background: #f0f9ff; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 2px solid #0ea5e9;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "1. If/Else Control Flow"
              css: "margin: 0 0 1rem 0; color: #0c4a6e;"

            - ::
              type: "text"
              content: "Current counter: {{counter}}"
              css: "font-size: 1.1rem; color: #334155; margin-bottom: 1rem; font-weight: 600;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "button"
                  content: "Increment"
                  action: "setState"
                  stateUpdates::
                    counter: "${ counter + 1 }"
                  css: "padding: 0.5rem 1rem; background: #10b981; color: white; border: none; border-radius: 6px; cursor: pointer;"

                - ::
                  type: "button"
                  content: "Decrement"
                  action: "setState"
                  stateUpdates::
                    counter: "${ counter - 1 }"
                  css: "padding: 0.5rem 1rem; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer;"

                - ::
                  type: "button"
                  content: "Reset to 0"
                  action: "setState"
                  stateUpdates::
                    counter: 0
                  css: "padding: 0.5rem 1rem; background: #6b7280; color: white; border: none; border-radius: 6px; cursor: pointer;"

            # If/Else block
            - ::
              if: "${ counter > 0 }"
              then::
                - ::
                  type: "text"
                  content: "✅ Counter is POSITIVE ({{counter}})"
                  css: "padding: 1rem; background: #d1fae5; color: #065f46; border-radius: 6px; font-weight: 500;"
              else::
                - ::
                  if: "${ counter < 0 }"
                  then::
                    - ::
                      type: "text"
                      content: "⚠️ Counter is NEGATIVE ({{counter}})"
                      css: "padding: 1rem; background: #fee2e2; color: #991b1b; border-radius: 6px; font-weight: 500;"
                  else::
                    - ::
                      type: "text"
                      content: "⭕ Counter is ZERO ({{counter}})"
                      css: "padding: 1rem; background: #e0e7ff; color: #3730a3; border-radius: 6px; font-weight: 500;"

        # ======================
        # MATCH/CASES CONTROL FLOW
        # ======================
        - ::
          type: "section"
          css: "background: #fef3c7; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 2px solid #eab308;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "2. Match/Cases Control Flow"
              css: "margin: 0 0 1rem 0; color: #713f12;"

            - ::
              type: "text"
              content: "Current view mode: {{viewMode}}"
              css: "font-size: 1.1rem; color: #78716c; margin-bottom: 1rem; font-weight: 600;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "button"
                  content: "Grid View"
                  action: "setState"
                  stateUpdates::
                    viewMode: "grid"
                  css: "padding: 0.5rem 1rem; background: #eab308; color: white; border: none; border-radius: 6px; cursor: pointer;"

                - ::
                  type: "button"
                  content: "List View"
                  action: "setState"
                  stateUpdates::
                    viewMode: "list"
                  css: "padding: 0.5rem 1rem; background: #f59e0b; color: white; border: none; border-radius: 6px; cursor: pointer;"

                - ::
                  type: "button"
                  content: "Table View"
                  action: "setState"
                  stateUpdates::
                    viewMode: "table"
                  css: "padding: 0.5rem 1rem; background: #d97706; color: white; border: none; border-radius: 6px; cursor: pointer;"

                - ::
                  type: "button"
                  content: "Unknown View"
                  action: "setState"
                  stateUpdates::
                    viewMode: "unknown"
                  css: "padding: 0.5rem 1rem; background: #6b7280; color: white; border: none; border-radius: 6px; cursor: pointer;"

            # Match/Cases block
            - ::
              match: "${ viewMode }"
              cases::
                - ::
                  value: "grid"
                  blocks::
                    - ::
                      type: "text"
                      content: "📊 Grid View Selected"
                      css: "padding: 1rem; background: #dbeafe; color: #1e40af; border-radius: 6px; font-weight: 500; font-size: 1.1rem;"
                    - ::
                      type: "text"
                      content: "Showing items in a grid layout with thumbnails"
                      css: "color: #475569; margin-top: 0.5rem;"

                - ::
                  value: "list"
                  blocks::
                    - ::
                      type: "text"
                      content: "📋 List View Selected"
                      css: "padding: 1rem; background: #fce7f3; color: #831843; border-radius: 6px; font-weight: 500; font-size: 1.1rem;"
                    - ::
                      type: "text"
                      content: "Showing items in a vertical list with details"
                      css: "color: #475569; margin-top: 0.5rem;"

                - ::
                  value: "table"
                  blocks::
                    - ::
                      type: "text"
                      content: "📑 Table View Selected"
                      css: "padding: 1rem; background: #f0fdf4; color: #14532d; border-radius: 6px; font-weight: 500; font-size: 1.1rem;"
                    - ::
                      type: "text"
                      content: "Showing items in a sortable table format"
                      css: "color: #475569; margin-top: 0.5rem;"

                - ::
                  default: true
                  blocks::
                    - ::
                      type: "text"
                      content: "❓ Unknown View Mode: {{viewMode}}"
                      css: "padding: 1rem; background: #fee2e2; color: #991b1b; border-radius: 6px; font-weight: 500; font-size: 1.1rem;"
                    - ::
                      type: "text"
                      content: "This view mode is not recognized. Please select a valid option."
                      css: "color: #475569; margin-top: 0.5rem;"

        # ======================
        # FOREACH ITERATION
        # ======================
        - ::
          type: "section"
          css: "background: #f0fdf4; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 2px solid #22c55e;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "3. ForEach Iteration"
              css: "margin: 0 0 1rem 0; color: #14532d;"

            - ::
              type: "text"
              content: "Total items: {{itemCount}}"
              css: "font-size: 1.1rem; color: #166534; margin-bottom: 1.5rem; font-weight: 600;"

            # ForEach with container
            - ::
              type: "container"
              layout: "flex"
              direction: "column"
              gap: "0.75rem"
              forEach: "${ items }"
              as: "item"
              key: "id"
              blocks::
                - ::
                  type: "container"
                  layout: "flex"
                  direction: "row"
                  gap: "1rem"
                  css: "padding: 1rem; background: white; border: 1px solid #d1d5db; border-radius: 6px; align-items: center;"
                  blocks::
                    - ::
                      type: "text"
                      content: "#{{itemIndex + 1}}"
                      css: "font-weight: 700; color: #6b7280; min-width: 3rem;"

                    - ::
                      type: "container"
                      layout: "flex"
                      direction: "column"
                      gap: "0.25rem"
                      css: "flex: 1;"
                      blocks::
                        - ::
                          type: "text"
                          content: "{{item.title}}"
                          css: "font-weight: 600; color: #1f2937;"

                        - ::
                          type: "text"
                          content: "ID: {{item.id}}"
                          css: "font-size: 0.875rem; color: #6b7280;"

                    - ::
                      type: "text"
                      content: "${{item.price}}"
                      css: "font-weight: 700; color: #059669; font-size: 1.1rem; min-width: 5rem; text-align: right;"

            - ::
              type: "text"
              content: "The forEach loop above iterates over the items array and displays each item with its index and properties."
              css: "color: #6b7280; margin-top: 1rem; font-style: italic; font-size: 0.875rem;"

        # ======================
        # WHEN CONDITIONAL
        # ======================
        - ::
          type: "section"
          css: "background: #faf5ff; padding: 1.5rem; border-radius: 8px; border: 2px solid #a855f7;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "4. When Conditional (Visibility)"
              css: "margin: 0 0 1rem 0; color: #581c87;"

            - ::
              type: "text"
              content: "Toggle advanced mode to see conditional content"
              css: "color: #78716c; margin-bottom: 1rem;"

            - ::
              type: "button"
              content: "{{showAdvanced ? \"Hide Advanced\" : \"Show Advanced\"}}"
              action: "setState"
              stateUpdates::
                showAdvanced: "${ !showAdvanced }"
              css: "padding: 0.75rem 1.5rem; background: #a855f7; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; margin-bottom: 1.5rem;"

            - ::
              type: "text"
              content: "🔓 Advanced mode is now enabled!"
              when: "${ showAdvanced }"
              css: "padding: 1rem; background: #e9d5ff; color: #581c87; border-radius: 6px; font-weight: 500; margin-bottom: 1rem;"

            - ::
              type: "container"
              layout: "flex"
              direction: "column"
              gap: "0.5rem"
              when: "${ showAdvanced }"
              blocks::
                - ::
                  type: "text"
                  content: "⚙️ Advanced Setting 1: Enabled"
                  css: "padding: 0.75rem; background: white; border: 1px solid #d8b4fe; border-radius: 4px; color: #6b21a8;"

                - ::
                  type: "text"
                  content: "⚙️ Advanced Setting 2: Enabled"
                  css: "padding: 0.75rem; background: white; border: 1px solid #d8b4fe; border-radius: 4px; color: #6b21a8;"

                - ::
                  type: "text"
                  content: "⚙️ Advanced Setting 3: Enabled"
                  css: "padding: 0.75rem; background: white; border: 1px solid #d8b4fe; border-radius: 4px; color: #6b21a8;"

            - ::
              type: "text"
              content: "🔒 Advanced mode is currently disabled"
              when: "${ !showAdvanced }"
              css: "padding: 1rem; background: #f3f4f6; color: #6b7280; border-radius: 6px;"
