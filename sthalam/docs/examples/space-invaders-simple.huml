name: "Space Invaders Simple"
version: "v1.0.0"

documents::
  playerX::
    type: "number"
    initial: 45
    document: "user_content_doc"

  score::
    type: "number"
    initial: 0
    document: "user_content_doc"

  gameStarted::
    type: "boolean"
    initial: false
    document: "user_content_doc"

ui::
  publisher::
    - ::
      type: "screen"
      id: "game"
      name: "Space Invaders"
      isEntryPoint: true
      css: "height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #000428 0%, #004e92 100%); font-family: 'Courier New', monospace;"
      blocks::
        # Header
        - ::
          type: "container"
          css: "padding: 1rem 2rem; background: rgba(0,0,0,0.5); border-bottom: 2px solid #00ff00;"
          blocks::
            - ::
              type: "heading"
              level: 1
              content: "👾 SPACE INVADERS"
              css: "margin: 0; color: #00ff00; font-size: 2rem; text-shadow: 0 0 10px #00ff00;"

            - ::
              type: "text"
              content: "Score: {{score}}"
              css: "color: #ffffff; font-size: 1.5rem; margin-top: 0.5rem;"

        # Start Screen
        - ::
          type: "container"
          when: "${ !gameStarted }"
          css: "flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "SPACE INVADERS"
              css: "color: #00ff00; font-size: 3rem; margin-bottom: 2rem; text-shadow: 0 0 20px #00ff00;"

            - ::
              type: "button"
              content: "START GAME"
              action: "setState"
              stateUpdates::
                gameStarted: true
                score: 0
                playerX: 45
              css: "background: #00ff00; color: #000000; border: none; padding: 1.5rem 4rem; font-size: 1.5rem; font-weight: bold; border-radius: 8px; cursor: pointer; box-shadow: 0 0 20px #00ff00;"

        # Game Area
        - ::
          type: "container"
          when: "${ gameStarted }"
          css: "flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;"
          blocks::
            - ::
              type: "text"
              content: "🚀"
              css: "font-size: 4rem; filter: drop-shadow(0 0 20px #00ff00);"

            - ::
              type: "text"
              content: "Use the controls below to play!"
              css: "color: #ffffff; font-size: 1.25rem; margin-top: 2rem;"

        # Controls
        - ::
          type: "container"
          when: "${ gameStarted }"
          css: "padding: 2rem; background: rgba(0,0,0,0.7); border-top: 2px solid #00ff00; display: flex; justify-content: center; gap: 1rem;"
          blocks::
            - ::
              type: "button"
              content: "◀ LEFT"
              action: "setState"
              stateUpdates::
                playerX: "${ playerX > 0 ? playerX - 5 : playerX }"
              css: "background: #667eea; color: white; border: 2px solid #00ff00; padding: 1.5rem 3rem; font-size: 1.25rem; font-weight: bold; border-radius: 12px; cursor: pointer; box-shadow: 0 0 15px rgba(0,255,0,0.5);"

            - ::
              type: "button"
              content: "🔥 FIRE"
              action: "setState"
              stateUpdates::
                score: "${ score + 10 }"
              css: "background: #f5576c; color: white; border: 3px solid #ff0000; padding: 1.5rem 4rem; font-size: 1.5rem; font-weight: bold; border-radius: 12px; cursor: pointer; box-shadow: 0 0 20px rgba(255,0,0,0.7);"

            - ::
              type: "button"
              content: "RIGHT ▶"
              action: "setState"
              stateUpdates::
                playerX: "${ playerX < 90 ? playerX + 5 : playerX }"
              css: "background: #667eea; color: white; border: 2px solid #00ff00; padding: 1.5rem 3rem; font-size: 1.25rem; font-weight: bold; border-radius: 12px; cursor: pointer; box-shadow: 0 0 15px rgba(0,255,0,0.5);"
