// Chat App - Rune Script Example
//
// This is a chat application using the rune_runtime widget system.
// Apps must export: init(), view(state_json), update(state_json, msg_json)

// Message IDs for UI events
const MSG_DRAFT_CHANGED = 1;
const MSG_SEND = 2;
const MSG_DRAFT_SUBMIT = 3;

/// Initialize app state (returns JSON string)
pub fn init() {
    "{\"draft\": \"\", \"username\": \"You\", \"message_counter\": 0, \"messages\": []}"
}

/// Render the UI (returns Widget)
pub fn view(state_json) {
    // Parse state from JSON
    let state = match json::from_string(state_json) {
        Ok(s) => s,
        Err(_) => return text("Error parsing state"),
    };

    let draft = state["draft"];
    let messages = state["messages"];

    // Build message list
    let message_widgets = [];
    for msg in messages {
        let author = msg["author"];
        let content = msg["content"];
        message_widgets.push(
            row([
                text_colored(format!("{}: ", author), 0x9CA3AF),
                text(content),
            ])
        );
    }

    let message_list = if message_widgets.is_empty() {
        text_colored("No messages yet. Send the first one!", 0x6B7280)
    } else {
        scrollable(column(message_widgets))
    };

    // Build full UI
    column([
        // Header
        h1("Sthalam Chat"),
        text_colored(format!("{} message(s)", messages.len()), 0x9CA3AF),
        vertical_space(8.0),
        rule(),

        // Messages
        vertical_space(8.0),
        message_list,

        // Input area
        vertical_space(16.0),
        rule(),
        vertical_space(8.0),
        row([
            text_input_with_submit(
                "draft",
                draft,
                "Type a message...",
                MSG_DRAFT_CHANGED,
                MSG_DRAFT_SUBMIT,
            ),
            button("Send", MSG_SEND),
        ]),
    ])
}

/// Handle messages (returns new state JSON string)
pub fn update(state_json, msg_json) {
    // Parse state and message
    let state = match json::from_string(state_json) {
        Ok(s) => s,
        Err(_) => return state_json,
    };
    let msg = match json::from_string(msg_json) {
        Ok(m) => m,
        Err(_) => return state_json,
    };

    let msg_type = msg["type"];

    if msg_type == "text_input" {
        let on_change_id = msg["on_change_id"];
        if on_change_id == MSG_DRAFT_CHANGED {
            state["draft"] = msg["value"];
        }
    } else if msg_type == "text_input_submit" {
        let on_submit_id = msg["on_submit_id"];
        if on_submit_id == MSG_DRAFT_SUBMIT {
            send_message(state);
        }
    } else if msg_type == "button" {
        let msg_id = msg["msg_id"];
        if msg_id == MSG_SEND {
            send_message(state);
        }
    }

    // Return updated state
    match json::to_string(state) {
        Ok(s) => s,
        Err(_) => state_json,
    }
}

/// Handle data changes from Scribe
pub fn on_data(state_json, layer, data_json) {
    let state = match json::from_string(state_json) {
        Ok(s) => s,
        Err(_) => return state_json,
    };

    // If we receive messages layer data, update our messages
    if layer == "messages" {
        let data = match json::from_string(data_json) {
            Ok(d) => d,
            Err(_) => return state_json,
        };
        state["messages"] = data;
    }

    match json::to_string(state) {
        Ok(s) => s,
        Err(_) => state_json,
    }
}

/// Define what data we want to subscribe to
pub fn subscriptions() {
    [subscribe("messages", "messages")]
}

// Helper function to send a message
fn send_message(state) {
    let content = state["draft"];
    if content == "" {
        return;
    }

    // Create message (Scribe push will happen via host)
    state["message_counter"] = state["message_counter"] + 1;
    let new_msg = #{
        id: format!("msg_{}", state["message_counter"]),
        author: state["username"],
        content: content,
        timestamp: state["message_counter"],
    };

    // Add locally for immediate feedback
    state["messages"].push(new_msg);

    // Clear draft
    state["draft"] = "";
}
