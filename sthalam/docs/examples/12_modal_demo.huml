name: "Modal Demo"
version: "v1.0.0"

documents::
  publisherState::
    showDialog::
      type: "boolean"
      initial: false
    showDrawer::
      type: "boolean"
      initial: false
    showPopover::
      type: "boolean"
      initial: false
    confirmed::
      type: "boolean"
      initial: false
    userName::
      type: "string"
      initial: "Guest"

ui::
  publisher::
    - ::
      type: "screen"
      id: "modalDemo"
      name: "modalDemo"
      isEntryPoint: true
      css: "padding: 2rem; font-family: system-ui; max-width: 800px; margin: 0 auto;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "Modal Component Demo"
          css: "color: #1f2937; margin-bottom: 0.5rem;"

        - ::
          type: "text"
          content: "Demonstrations of dialog, drawer, and popover modal types."
          css: "color: #6b7280; margin-bottom: 2rem;"

        # Dialog Modal Section
        - ::
          type: "heading"
          level: 2
          content: "Dialog Modal"
          css: "color: #374151; margin-top: 2rem; margin-bottom: 1rem;"

        - ::
          type: "text"
          content: "Centered modal with backdrop overlay. Click the button to open."
          css: "color: #6b7280; margin-bottom: 1rem;"

        - ::
          type: "button"
          content: "Open Dialog"
          action: "setState"
          stateUpdates::
            showDialog: "${ true }"
          css: "padding: 0.75rem 1.5rem; background: #2563eb; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

        - ::
          type: "text"
          content: "Status: {{confirmed ? \"Confirmed ✓\" : \"Not confirmed\"}}"
          css: "{{confirmed ? \"color: #10b981;\" : \"color: #6b7280;\"}} margin-top: 1rem; font-weight: 500;"

        # Drawer Modal Section
        - ::
          type: "heading"
          level: 2
          content: "Drawer Modal"
          css: "color: #374151; margin-top: 2rem; margin-bottom: 1rem;"

        - ::
          type: "text"
          content: "Side panel that slides in from the right. Perfect for settings or navigation."
          css: "color: #6b7280; margin-bottom: 1rem;"

        - ::
          type: "button"
          content: "Open Settings Drawer"
          action: "setState"
          stateUpdates::
            showDrawer: "${ true }"
          css: "padding: 0.75rem 1.5rem; background: #7c3aed; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

        # Popover Modal Section
        - ::
          type: "heading"
          level: 2
          content: "Popover Modal"
          css: "color: #374151; margin-top: 2rem; margin-bottom: 1rem;"

        - ::
          type: "text"
          content: "Small tooltip-style popup anchored to a button. Click the ? button below."
          css: "color: #6b7280; margin-bottom: 1rem;"

        - ::
          type: "button"
          id: "helpButton"
          content: "?"
          action: "setState"
          stateUpdates::
            showPopover: "${ !showPopover }"
          css: "width: 32px; height: 32px; padding: 0; background: #f59e0b; color: white; border: none; border-radius: 50%; cursor: pointer; font-weight: bold; font-size: 18px;"

        # Dialog Modal Component
        - ::
          type: "modal"
          name: "confirmDialog"
          visible: "${ showDialog }"
          modalType: "dialog"
          size: "medium"
          backdrop: true
          closeOnBackdropClick: true
          closeOnEscape: true
          closable: true
          onClose: "setState"
          closeParams::
            stateUpdates::
              showDialog: "${ false }"
          css: "font-family: system-ui;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Confirm Action"
              css: "color: #1f2937; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "Are you sure you want to proceed? This action will mark the confirmation status."
              css: "color: #6b7280; margin-bottom: 1.5rem; line-height: 1.6;"

            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "justify-content: flex-end;"
              blocks::
                - ::
                  type: "button"
                  content: "Cancel"
                  action: "setState"
                  stateUpdates::
                    showDialog: "${ false }"
                  css: "padding: 0.75rem 1.5rem; background: #e5e7eb; color: #374151; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

                - ::
                  type: "button"
                  content: "Confirm"
                  action: "setState"
                  stateUpdates::
                    showDialog: "${ false }"
                    confirmed: "${ true }"
                  css: "padding: 0.75rem 1.5rem; background: #2563eb; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500;"

        # Drawer Modal Component
        - ::
          type: "modal"
          name: "settingsDrawer"
          visible: "${ showDrawer }"
          modalType: "drawer"
          position: "right"
          width: "400px"
          backdrop: true
          closeOnBackdropClick: true
          closeOnEscape: true
          closable: true
          onClose: "setState"
          closeParams::
            stateUpdates::
              showDrawer: "${ false }"
          css: "font-family: system-ui;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Settings"
              css: "color: #1f2937; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #e5e7eb;"

            - ::
              type: "heading"
              level: 3
              content: "User Profile"
              css: "color: #374151; font-size: 1.125rem; margin-bottom: 1rem;"

            - ::
              type: "label"
              for: "userName"
              content: "Name"
              css: "display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;"

            - ::
              type: "input"
              name: "userName"
              inputType: "text"
              placeholder: "Enter your name"
              css: "width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 1.5rem;"

            - ::
              type: "heading"
              level: 3
              content: "Preferences"
              css: "color: #374151; font-size: 1.125rem; margin-bottom: 1rem;"

            - ::
              type: "text"
              content: "Current user: {{userName}}"
              css: "color: #6b7280; margin-bottom: 1.5rem; padding: 0.75rem; background: #f3f4f6; border-radius: 6px;"

            - ::
              type: "button"
              content: "Save Settings"
              action: "setState"
              stateUpdates::
                showDrawer: "${ false }"
              css: "width: 100%; padding: 0.75rem 1.5rem; background: #7c3aed; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; margin-top: 2rem;"

        # Popover Modal Component
        - ::
          type: "modal"
          name: "helpPopover"
          visible: "${ showPopover }"
          modalType: "popover"
          anchorId: "helpButton"
          placement: "top"
          closable: true
          onClose: "setState"
          closeParams::
            stateUpdates::
              showPopover: "${ false }"
          css: "font-family: system-ui;"
          blocks::
            - ::
              type: "heading"
              level: 3
              content: "Help"
              css: "color: #1f2937; font-size: 1rem; margin-bottom: 0.5rem;"

            - ::
              type: "text"
              content: "This is a popover component. It can display helpful information anchored to any element with an ID."
              css: "color: #6b7280; font-size: 0.875rem; line-height: 1.5;"

            - ::
              type: "text"
              content: "Click outside or press Escape to close."
              css: "color: #9ca3af; font-size: 0.75rem; margin-top: 0.5rem;"
