    css: "background: #fafafa; min-height: 100vh; padding: 0; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;"
    children::
      # Navigation Header
