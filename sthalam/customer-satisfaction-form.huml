name: "Customer Satisfaction Survey"

screens::
  # Welcome Screen
  - ::
    id: "welcome"
    name: "Welcome"
    isEntryPoint: true
    css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center;"
    children::
      - ::
        type: "heading"
        content: "Customer Satisfaction Survey"
        css: "color: white; font-size: 42px; margin-bottom: 20px; text-align: center; font-weight: 700;"

      - ::
        type: "text"
        content: "We value your feedback! Please take a moment to share your experience with us."
        css: "color: rgba(255,255,255,0.95); font-size: 20px; margin-bottom: 40px; text-align: center; max-width: 600px;"

      - ::
        type: "nav-button"
        content: "Start Survey"
        targetContainerId: "survey"
        css: "background: white; color: #667eea; padding: 18px 50px; border-radius: 10px; font-size: 18px; font-weight: 600; box-shadow: 0 4px 15px rgba(0,0,0,0.2); cursor: pointer; border: none;"

  # Survey Form Screen
  - ::
    id: "survey"
    name: "Survey"
    css: "background: #f8f9fa; padding: 40px 20px; min-height: 100vh; display: flex; justify-content: center; align-items: center;"
    children::
      # Form Metadata
      - ::
        type: "form"
        formId: "satisfaction-form"
        submitEndpoint: "https://submit-form.com/your-endpoint"

      # Form Container
      - ::
        type: "section-container"
        css: "background: white; padding: 40px; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); max-width: 700px; width: 100%;"
        children::
          - ::
            type: "heading"
            content: "How satisfied are you with our service?"
            css: "color: #2d3748; font-size: 28px; margin-bottom: 30px; text-align: center;"

          # Name Field
          - ::
            type: "form-field-text"
            formId: "satisfaction-form"
            fieldName: "customer_name"
            label: "Your Name"
            placeholder: "Enter your name"
            required: true
            css: "margin-bottom: 25px;"

          # Email Field
          - ::
            type: "form-field-email"
            formId: "satisfaction-form"
            fieldName: "customer_email"
            label: "Email Address"
            placeholder: "your.email@example.com"
            required: true
            css: "margin-bottom: 25px;"

          # Rating Field
          - ::
            type: "text"
            content: "Overall Satisfaction"
            css: "font-weight: 600; color: #2d3748; margin-bottom: 15px; display: block;"

          # Rating Buttons Container
          - ::
            type: "section-container"
            css: "display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap; justify-content: center;"
            children::
              - ::
                type: "nav-button"
                content: "😞 Very Unsatisfied"
                formId: "satisfaction-form"
                fieldName: "satisfaction_rating"
                value: "1"
                targetContainerId: "feedback"
                css: "background: #ef4444; color: white; padding: 15px 25px; border-radius: 8px; font-weight: 600; flex: 1; min-width: 150px; text-align: center;"

              - ::
                type: "nav-button"
                content: "😕 Unsatisfied"
                formId: "satisfaction-form"
                fieldName: "satisfaction_rating"
                value: "2"
                targetContainerId: "feedback"
                css: "background: #f97316; color: white; padding: 15px 25px; border-radius: 8px; font-weight: 600; flex: 1; min-width: 150px; text-align: center;"

              - ::
                type: "nav-button"
                content: "😐 Neutral"
                formId: "satisfaction-form"
                fieldName: "satisfaction_rating"
                value: "3"
                targetContainerId: "feedback"
                css: "background: #eab308; color: white; padding: 15px 25px; border-radius: 8px; font-weight: 600; flex: 1; min-width: 150px; text-align: center;"

              - ::
                type: "nav-button"
                content: "🙂 Satisfied"
                formId: "satisfaction-form"
                fieldName: "satisfaction_rating"
                value: "4"
                targetContainerId: "feedback"
                css: "background: #84cc16; color: white; padding: 15px 25px; border-radius: 8px; font-weight: 600; flex: 1; min-width: 150px; text-align: center;"

              - ::
                type: "nav-button"
                content: "😄 Very Satisfied"
                formId: "satisfaction-form"
                fieldName: "satisfaction_rating"
                value: "5"
                targetContainerId: "feedback"
                css: "background: #22c55e; color: white; padding: 15px 25px; border-radius: 8px; font-weight: 600; flex: 1; min-width: 150px; text-align: center;"

  # Feedback Screen
  - ::
    id: "feedback"
    name: "Additional Feedback"
    css: "background: #f8f9fa; padding: 40px 20px; min-height: 100vh; display: flex; justify-content: center; align-items: center;"
    children::
      - ::
        type: "section-container"
        css: "background: white; padding: 40px; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); max-width: 700px; width: 100%;"
        children::
          - ::
            type: "heading"
            content: "Additional Comments"
            css: "color: #2d3748; font-size: 28px; margin-bottom: 20px; text-align: center;"

          - ::
            type: "text"
            content: "Is there anything else you'd like to share about your experience?"
            css: "color: #64748b; font-size: 16px; margin-bottom: 30px; text-align: center;"

          # Feedback Textarea
          - ::
            type: "form-field-textarea"
            formId: "satisfaction-form"
            fieldName: "additional_comments"
            label: "Your Feedback (Optional)"
            placeholder: "Tell us more about your experience..."
            required: false
            css: "margin-bottom: 25px; min-height: 150px;"

          # Contact Permission Checkbox
          - ::
            type: "form-field-checkbox"
            formId: "satisfaction-form"
            fieldName: "allow_contact"
            label: "You may contact me about my feedback"
            css: "margin-bottom: 30px;"

          # Submit Button
          - ::
            type: "nav-button"
            content: "Submit Survey"
            formId: "satisfaction-form"
            targetContainerId: "thankyou"
            css: "background: #667eea; color: white; padding: 18px 40px; border-radius: 8px; font-size: 18px; font-weight: 600; width: 100%; cursor: pointer;"

  # Thank You Screen
  - ::
    id: "thankyou"
    name: "Thank You"
    css: "background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); padding: 40px; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;"
    children::
      - ::
        type: "heading"
        content: "✅ Thank You!"
        css: "color: white; font-size: 48px; margin-bottom: 20px; font-weight: 800;"

      - ::
        type: "text"
        content: "Your feedback has been successfully submitted. We truly appreciate you taking the time to share your thoughts with us!"
        css: "color: rgba(255,255,255,0.95); font-size: 20px; max-width: 600px; margin-bottom: 40px; line-height: 1.6;"

      - ::
        type: "text"
        content: "Have a wonderful day! 🌟"
        css: "color: white; font-size: 24px; font-weight: 600;"
