---
metadata:
  version: "1.0"
  eventName: "event_registration_submission"

forms:
  - formId: "eventRegistrationForm"
    eventName: "event_registration_submission"

thread:
  --thread-primary-bg: "#1a1a2e"
  --thread-secondary-bg: "#16213e"
  --thread-accent: "#0f3460"
  --thread-highlight: "#533483"
  --thread-success: "#00b894"
  --thread-text-primary: "#ffffff"
  --thread-text-secondary: "#a0a0a0"
  --thread-border: "#2d3561"

screens:
  - id: "welcome_screen"
    default: true
    section-container:
      name: "welcome_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
        display: "flex"
        flexDirection: "column"
        alignItems: "center"
        justifyContent: "center"
      components:
        - text:
            content: "🎉 Tech Innovation Summit 2025"
            style:
              fontSize: "36px"
              fontWeight: "bold"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "20px"
        - text:
            content: "Join us for three days of innovation, networking, and learning"
            style:
              fontSize: "18px"
              color: "var(--thread-text-secondary)"
              textAlign: "center"
              marginBottom: "40px"
        - text:
            content: "Select Your Registration Type"
            style:
              fontSize: "24px"
              fontWeight: "600"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "30px"
        - section-container:
            name: "registration_type_buttons"
            style:
              display: "flex"
              flexDirection: "column"
              gap: "20px"
              width: "100%"
              maxWidth: "500px"
            components:
              - nav-button:
                  label: "🎤 Speaker Registration"
                  targetScreenId: "speaker_form"
                  mode: 3
                  formId: "eventRegistrationForm"
                  fieldName: "registrationType"
                  value: "speaker"
                  style:
                    background: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
                    color: "white"
                    padding: "20px"
                    border: "none"
                    borderRadius: "12px"
                    fontSize: "18px"
                    fontWeight: "600"
                    cursor: "pointer"
                    transition: "transform 0.2s"
              - nav-button:
                  label: "👥 Attendee Registration"
                  targetScreenId: "attendee_form"
                  mode: 3
                  formId: "eventRegistrationForm"
                  fieldName: "registrationType"
                  value: "attendee"
                  style:
                    background: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)"
                    color: "white"
                    padding: "20px"
                    border: "none"
                    borderRadius: "12px"
                    fontSize: "18px"
                    fontWeight: "600"
                    cursor: "pointer"
                    transition: "transform 0.2s"
              - nav-button:
                  label: "💼 Sponsor Registration"
                  targetScreenId: "sponsor_form"
                  mode: 3
                  formId: "eventRegistrationForm"
                  fieldName: "registrationType"
                  value: "sponsor"
                  style:
                    background: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)"
                    color: "white"
                    padding: "20px"
                    border: "none"
                    borderRadius: "12px"
                    fontSize: "18px"
                    fontWeight: "600"
                    cursor: "pointer"
                    transition: "transform 0.2s"

  - id: "speaker_form"
    section-container:
      name: "speaker_form_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
      components:
        - text:
            content: "🎤 Speaker Registration"
            style:
              fontSize: "32px"
              fontWeight: "bold"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "10px"
        - text:
            content: "Share your expertise with our community"
            style:
              fontSize: "16px"
              color: "var(--thread-text-secondary)"
              textAlign: "center"
              marginBottom: "40px"
        - section-container:
            name: "speaker_form_container"
            style:
              maxWidth: "600px"
              margin: "0 auto"
              background: "var(--thread-secondary-bg)"
              padding: "30px"
              borderRadius: "12px"
              border: "1px solid var(--thread-border)"
            components:
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "fullName"
                  label: "Full Name"
                  placeholder: "Enter your full name"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-email:
                  formId: "eventRegistrationForm"
                  fieldName: "email"
                  label: "Email Address"
                  placeholder: "your.email@example.com"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "phone"
                  label: "Phone Number"
                  placeholder: "+1 (555) 000-0000"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "talkTitle"
                  label: "Talk Title"
                  placeholder: "What will you be speaking about?"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-textarea:
                  formId: "eventRegistrationForm"
                  fieldName: "speakerBio"
                  label: "Speaker Bio"
                  placeholder: "Tell us about yourself and your expertise (max 500 characters)"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-select:
                  formId: "eventRegistrationForm"
                  fieldName: "topicArea"
                  label: "Topic Area"
                  required: true
                  options::
                    - label: "Select a topic area"
                      value: ""
                    - label: "Artificial Intelligence & Machine Learning"
                      value: "ai_ml"
                    - label: "Web Development & Frontend"
                      value: "web_dev"
                    - label: "Cloud Computing & DevOps"
                      value: "cloud_devops"
                    - label: "Cybersecurity"
                      value: "cybersecurity"
                    - label: "Data Science & Analytics"
                      value: "data_science"
                    - label: "Mobile Development"
                      value: "mobile_dev"
                  style:
                    marginBottom: "20px"
              - form-field-textarea:
                  formId: "eventRegistrationForm"
                  fieldName: "avRequirements"
                  label: "AV Requirements"
                  placeholder: "List any audio/visual equipment you'll need (projector, microphone, laptop connection, etc.)"
                  required: false
                  style:
                    marginBottom: "30px"
              - section-container:
                  name: "speaker_form_buttons"
                  style:
                    display: "flex"
                    gap: "15px"
                    justifyContent: "space-between"
                  components:
                    - nav-button:
                        label: "← Back"
                        targetScreenId: "welcome_screen"
                        mode: 1
                        style:
                          background: "var(--thread-accent)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          cursor: "pointer"
                    - nav-button:
                        label: "Submit Registration →"
                        targetScreenId: "confirmation_screen"
                        mode: 2
                        formId: "eventRegistrationForm"
                        style:
                          background: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          fontWeight: "600"
                          cursor: "pointer"

  - id: "attendee_form"
    section-container:
      name: "attendee_form_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
      components:
        - text:
            content: "👥 Attendee Registration"
            style:
              fontSize: "32px"
              fontWeight: "bold"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "10px"
        - text:
            content: "Join us for an amazing learning experience"
            style:
              fontSize: "16px"
              color: "var(--thread-text-secondary)"
              textAlign: "center"
              marginBottom: "40px"
        - section-container:
            name: "attendee_form_container"
            style:
              maxWidth: "600px"
              margin: "0 auto"
              background: "var(--thread-secondary-bg)"
              padding: "30px"
              borderRadius: "12px"
              border: "1px solid var(--thread-border)"
            components:
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "fullName"
                  label: "Full Name"
                  placeholder: "Enter your full name"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-email:
                  formId: "eventRegistrationForm"
                  fieldName: "email"
                  label: "Email Address"
                  placeholder: "your.email@example.com"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "phone"
                  label: "Phone Number"
                  placeholder: "+1 (555) 000-0000"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "company"
                  label: "Company/Organization"
                  placeholder: "Your company name"
                  required: false
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "jobTitle"
                  label: "Job Title"
                  placeholder: "Your current role"
                  required: false
                  style:
                    marginBottom: "20px"
              - form-field-select:
                  formId: "eventRegistrationForm"
                  fieldName: "tshirtSize"
                  label: "T-Shirt Size"
                  required: true
                  options::
                    - label: "Select your size"
                      value: ""
                    - label: "Small"
                      value: "S"
                    - label: "Medium"
                      value: "M"
                    - label: "Large"
                      value: "L"
                    - label: "Extra Large"
                      value: "XL"
                    - label: "2XL"
                      value: "2XL"
                  style:
                    marginBottom: "20px"
              - form-field-textarea:
                  formId: "eventRegistrationForm"
                  fieldName: "dietaryRestrictions"
                  label: "Dietary Restrictions"
                  placeholder: "Please list any dietary restrictions or allergies"
                  required: false
                  style:
                    marginBottom: "20px"
              - text:
                  content: "Workshop Preferences (Select up to 3)"
                  style:
                    fontSize: "16px"
                    fontWeight: "600"
                    color: "var(--thread-text-primary)"
                    marginBottom: "15px"
                    marginTop: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "workshop_ai"
                  label: "AI & Machine Learning Workshop"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "workshop_cloud"
                  label: "Cloud Architecture Workshop"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "workshop_security"
                  label: "Cybersecurity Essentials"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "workshop_mobile"
                  label: "Mobile App Development"
                  style:
                    marginBottom: "30px"
              - section-container:
                  name: "attendee_form_buttons"
                  style:
                    display: "flex"
                    gap: "15px"
                    justifyContent: "space-between"
                  components:
                    - nav-button:
                        label: "← Back"
                        targetScreenId: "welcome_screen"
                        mode: 1
                        style:
                          background: "var(--thread-accent)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          cursor: "pointer"
                    - nav-button:
                        label: "Submit Registration →"
                        targetScreenId: "confirmation_screen"
                        mode: 2
                        formId: "eventRegistrationForm"
                        style:
                          background: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          fontWeight: "600"
                          cursor: "pointer"

  - id: "sponsor_form"
    section-container:
      name: "sponsor_form_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
      components:
        - text:
            content: "💼 Sponsor Registration"
            style:
              fontSize: "32px"
              fontWeight: "bold"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "10px"
        - text:
            content: "Partner with us to reach innovators and decision-makers"
            style:
              fontSize: "16px"
              color: "var(--thread-text-secondary)"
              textAlign: "center"
              marginBottom: "40px"
        - section-container:
            name: "sponsor_form_container"
            style:
              maxWidth: "600px"
              margin: "0 auto"
              background: "var(--thread-secondary-bg)"
              padding: "30px"
              borderRadius: "12px"
              border: "1px solid var(--thread-border)"
            components:
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "fullName"
                  label: "Contact Person Name"
                  placeholder: "Primary contact name"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-email:
                  formId: "eventRegistrationForm"
                  fieldName: "email"
                  label: "Contact Email"
                  placeholder: "contact@company.com"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "phone"
                  label: "Contact Phone"
                  placeholder: "+1 (555) 000-0000"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "companyName"
                  label: "Company Name"
                  placeholder: "Your company name"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "companyWebsite"
                  label: "Company Website"
                  placeholder: "https://www.company.com"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-select:
                  formId: "eventRegistrationForm"
                  fieldName: "sponsorshipTier"
                  label: "Sponsorship Tier"
                  required: true
                  options::
                    - label: "Select sponsorship level"
                      value: ""
                    - label: "Platinum Sponsor - $50,000"
                      value: "platinum"
                    - label: "Gold Sponsor - $25,000"
                      value: "gold"
                    - label: "Silver Sponsor - $10,000"
                      value: "silver"
                    - label: "Bronze Sponsor - $5,000"
                      value: "bronze"
                  style:
                    marginBottom: "20px"
              - text:
                  content: "Booth Requirements"
                  style:
                    fontSize: "16px"
                    fontWeight: "600"
                    color: "var(--thread-text-primary)"
                    marginBottom: "15px"
                    marginTop: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "booth_electricity"
                  label: "Electrical Outlet Required"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "booth_internet"
                  label: "High-Speed Internet Connection"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "booth_display"
                  label: "Display Screen/Monitor"
                  style:
                    marginBottom: "20px"
              - form-field-textarea:
                  formId: "eventRegistrationForm"
                  fieldName: "additionalRequirements"
                  label: "Additional Requirements"
                  placeholder: "Any other booth setup requirements or special requests"
                  required: false
                  style:
                    marginBottom: "30px"
              - section-container:
                  name: "sponsor_form_buttons"
                  style:
                    display: "flex"
                    gap: "15px"
                    justifyContent: "space-between"
                  components:
                    - nav-button:
                        label: "← Back"
                        targetScreenId: "welcome_screen"
                        mode: 1
                        style:
                          background: "var(--thread-accent)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          cursor: "pointer"
                    - nav-button:
                        label: "Continue →"
                        targetScreenId: "sponsor_details"
                        mode: 1
                        style:
                          background: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          fontWeight: "600"
                          cursor: "pointer"

  - id: "sponsor_details"
    section-container:
      name: "sponsor_details_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
      components:
        - text:
            content: "💼 Sponsorship Details"
            style:
              fontSize: "32px"
              fontWeight: "bold"
              color: "var(--thread-text-primary)"
              textAlign: "center"
              marginBottom: "10px"
        - text:
            content: "Tell us more about your sponsorship goals"
            style:
              fontSize: "16px"
              color: "var(--thread-text-secondary)"
              textAlign: "center"
              marginBottom: "40px"
        - section-container:
            name: "sponsor_details_container"
            style:
              maxWidth: "600px"
              margin: "0 auto"
              background: "var(--thread-secondary-bg)"
              padding: "30px"
              borderRadius: "12px"
              border: "1px solid var(--thread-border)"
            components:
              - form-field-textarea:
                  formId: "eventRegistrationForm"
                  fieldName: "marketingGoals"
                  label: "Marketing Goals"
                  placeholder: "What are your primary goals for sponsoring this event?"
                  required: true
                  style:
                    marginBottom: "20px"
              - form-field-text:
                  formId: "eventRegistrationForm"
                  fieldName: "targetAudience"
                  label: "Target Audience"
                  placeholder: "Who are you hoping to reach?"
                  required: false
                  style:
                    marginBottom: "20px"
              - text:
                  content: "Promotional Materials"
                  style:
                    fontSize: "16px"
                    fontWeight: "600"
                    color: "var(--thread-text-primary)"
                    marginBottom: "15px"
                    marginTop: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "promo_brochures"
                  label: "Brochures/Flyers in Attendee Bags"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "promo_swag"
                  label: "Branded Swag Items"
                  style:
                    marginBottom: "10px"
              - form-field-checkbox:
                  formId: "eventRegistrationForm"
                  fieldName: "promo_demo"
                  label: "Product Demo Session"
                  style:
                    marginBottom: "30px"
              - section-container:
                  name: "sponsor_details_buttons"
                  style:
                    display: "flex"
                    gap: "15px"
                    justifyContent: "space-between"
                  components:
                    - nav-button:
                        label: "← Back"
                        targetScreenId: "sponsor_form"
                        mode: 1
                        style:
                          background: "var(--thread-accent)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          cursor: "pointer"
                    - nav-button:
                        label: "Submit Registration →"
                        targetScreenId: "confirmation_screen"
                        mode: 2
                        formId: "eventRegistrationForm"
                        style:
                          background: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)"
                          color: "white"
                          padding: "15px 30px"
                          border: "none"
                          borderRadius: "8px"
                          fontSize: "16px"
                          fontWeight: "600"
                          cursor: "pointer"

  - id: "confirmation_screen"
    section-container:
      name: "confirmation_section"
      style:
        background: "var(--thread-primary-bg)"
        padding: "40px 20px"
        minHeight: "100vh"
        display: "flex"
        flexDirection: "column"
        alignItems: "center"
        justifyContent: "center"
      components:
        - text:
            content: "✅ Registration Successful!"
            style:
              fontSize: "36px"
              fontWeight: "bold"
              color: "var(--thread-success)"
              textAlign: "center"
              marginBottom: "20px"
        - section-container:
            name: "confirmation_details"
            style:
              maxWidth: "600px"
              background: "var(--thread-secondary-bg)"
              padding: "40px"
              borderRadius: "12px"
              border: "2px solid var(--thread-success)"
              textAlign: "center"
            components:
              - text:
                  content: "Thank you for registering for Tech Innovation Summit 2025!"
                  style:
                    fontSize: "20px"
                    color: "var(--thread-text-primary)"
                    marginBottom: "20px"
              - text:
                  content: "Your registration has been successfully submitted. You will receive a confirmation email shortly with all the event details."
                  style:
                    fontSize: "16px"
                    color: "var(--thread-text-secondary)"
                    lineHeight: "1.6"
                    marginBottom: "30px"
              - section-container:
                  name: "confirmation_info"
                  style:
                    background: "var(--thread-accent)"
                    padding: "20px"
                    borderRadius: "8px"
                    marginBottom: "30px"
                  components:
                    - text:
                        content: "📅 Event Dates: March 15-17, 2025"
                        style:
                          fontSize: "16px"
                          color: "var(--thread-text-primary)"
                          marginBottom: "10px"
                    - text:
                        content: "📍 Location: San Francisco Convention Center"
                        style:
                          fontSize: "16px"
                          color: "var(--thread-text-primary)"
                          marginBottom: "10px"
                    - text:
                        content: "🕐 Check-in: 8:00 AM on Day 1"
                        style:
                          fontSize: "16px"
                          color: "var(--thread-text-primary)"
              - text:
                  content: "What's Next?"
                  style:
                    fontSize: "20px"
                    fontWeight: "600"
                    color: "var(--thread-text-primary)"
                    marginBottom: "15px"
                    marginTop: "20px"
              - text:
                  content: "• Check your email for confirmation and payment instructions\n• Download the event app (link in confirmation email)\n• Review the schedule and plan your sessions\n• Book your accommodation early"
                  style:
                    fontSize: "14px"
                    color: "var(--thread-text-secondary)"
                    lineHeight: "1.8"
                    textAlign: "left"
                    whiteSpace: "pre-line"
                    marginBottom: "30px"
        - section-container:
            name: "confirmation_actions"
            style:
              display: "flex"
              gap: "15px"
              marginTop: "30px"
              flexWrap: "wrap"
              justifyContent: "center"
            components:
              - nav-button:
                  label: "← Back to Home"
                  targetScreenId: "welcome_screen"
                  mode: 1
                  style:
                    background: "var(--thread-accent)"
                    color: "white"
                    padding: "15px 30px"
                    border: "none"
                    borderRadius: "8px"
                    fontSize: "16px"
                    cursor: "pointer"
              - nav-button:
                  label: "Register Another Person"
                  targetScreenId: "welcome_screen"
                  mode: 1
                  style:
                    background: "var(--thread-highlight)"
                    color: "white"
                    padding: "15px 30px"
                    border: "none"
                    borderRadius: "8px"
                    fontSize: "16px"
                    cursor: "pointer"
                