                content: "🎉"
                css: "font-size: 48px; margin-bottom: 15px; display: block;"

              - type: "heading"
                content: "My Code Works and I Don't Know Why"
                css: """
                  font-size: 28px;
                  color: #cba6f7;
                  margin-bottom: 15px;
                  font-weight: 600;
                """

              - type: "text"
                content: "The most terrifying feeling in programming. A tutorial on mysterious bug fixes."
                css: """
                  color: #8b949e;
                  line-height: 1.6;
                  margin-bottom: 20px;
                """

              - type: "section-container"
                css: "display: flex; justify-content: space-between; align-items: center;"
                children::
                  - type: "text"
                    content: "6 min read"
                    css: "color: #6e7681; font-size: 14px;"

                  - type: "nav-button"
                    content: "Read More →"
                    action: "navigate"
                    targetScreen: "post-3"
                    css: """
                      background: linear-gradient(135deg, #89b4fa 0%, #7aa2f7 100%);
                      color: #010409;
                      padding: 12px 24px;
