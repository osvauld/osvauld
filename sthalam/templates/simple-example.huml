# Simple Sthalam Template Example
# This shows the correct HUML syntax for Sthalam

name: "Simple Example"

screens::
  - ::
    id: "home"
    name: "Home"
    css: "padding: 2rem; background: linear-gradient(135deg, #1e1e2e 0%, #0d0e13 100%);"
    children::
      - ::
        type: "heading"
        content: "Welcome to Sthalam"
        css: "font-size: 48px; color: #89b4fa; text-align: center;"

      - ::
        type: "text"
        content: "This is a simple example template"
        css: "color: #c9d1d9; text-align: center; margin-top: 20px;"

      - ::
        type: "section-container"
        css: "display: flex; gap: 20px; margin-top: 40px; justify-content: center;"
        children::
          - ::
            type: "text"
            content: "Box 1"
            css: "background: #0d0e13; padding: 20px; border-radius: 8px;"

          - ::
            type: "text"
            content: "Box 2"
            css: "background: #0d0e13; padding: 20px; border-radius: 8px;"
