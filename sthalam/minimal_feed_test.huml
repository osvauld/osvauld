# Minimal Feed Template - Osvauld Style
name: "Minimal Feed"

screens::
  - ::
    id: "feed"
    name: "Feed"
    isEntryPoint: true
    css: "background: #010409; padding: 40px 20px; min-height: 100vh;"
    children::
      # This is your main container - all styles are here
      # Just add markdown-text blocks and thread blocks inside
      - ::
        type: "section-container"
        name: "Post Container"
        css: "max-width: 700px; margin: 0 auto; background: #0d0e13; border: 1px solid #2f303e; border-radius: 12px; padding: 24px;"
        children::
          # Add your markdown blocks here
          - ::
            type: "markdown-text"
            content: "## Hello World\n\nThis is a **markdown** block. You can add as many of these as you want.\n\n- Item 1\n- Item 2\n- Item 3"
            mode: "markdown"
            css: "color: #c9d1d9; line-height: 1.6; margin-bottom: 20px; font-size: 15px;"

          # Add your thread blocks here
          # With name and description:
          - ::
            type: "thread"
            name: "Discussion"
            mode: "markdown"
            description: "Join the discussion..."
            css: "background: #0d0e13; border: 1px solid #2f303e; border-radius: 8px; padding: 20px; margin: 0;"

          # Without name and description (just omit them):
          - ::
            type: "thread"
            mode: "markdown"
            css: "background: #0d0e13; border: 1px solid #2f303e; border-radius: 8px; padding: 20px; margin: 0; margin-top: 20px;"
