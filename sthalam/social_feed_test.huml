# Social Feed (Twitter-like) - Osvauld Style
name: "Social Feed"

screens::
  # Main feed screen
  - ::
    id: "feed"
    name: "Social Feed"
    isEntryPoint: true
    css: "background: #010409; padding: 40px 20px; min-height: 100vh;"
    children::
      # Header
      - ::
        type: "section-container"
        name: "Header"
        css: "max-width: 700px; margin: 0 auto 40px auto;"
        children::
          - ::
            type: "heading"
            content: "Feed"
            css: "color: #c9d1d9; font-size: 32px; font-weight: 700; margin-bottom: 8px;"

          - ::
            type: "text"
            content: "Latest updates from the community"
            css: "color: #6e7681; font-size: 14px;"

      # Post 1
      - ::
        type: "section-container"
        name: "Post Card 1"
        css: "max-width: 700px; margin: 0 auto 20px auto; background: #0d0e13; border: 1px solid #2f303e; border-radius: 12px; padding: 24px;"
        children::
          # Post header (author info)
          - ::
            type: "section-container"
            name: "Post Header"
            css: "display: flex; align-items: center; gap: 12px; margin-bottom: 16px;"
            children::
              - ::
                type: "text"
                content: "👤"
                css: "font-size: 20px;"

              - ::
                type: "section-container"
                name: "Author Info"
                css: "flex: 1;"
                children::
                  - ::
                    type: "text"
                    content: "Sarah Chen"
                    css: "color: #c9d1d9; font-weight: 600; font-size: 15px; margin-bottom: 2px;"

                  - ::
                    type: "text"
                    content: "@sarahchen • 2h ago"
                    css: "color: #6e7681; font-size: 13px;"

          # Post content
          - ::
            type: "markdown-text"
            content: "Just shipped a new feature using **Svelte 5 Runes**! 🚀\n\nThe reactivity model is so intuitive. Here's a quick example:\n\n```javascript\nlet count = $state(0);\nlet doubled = $derived(count * 2);\n```\n\nGame changer for building reactive UIs!"
            mode: "markdown"
            css: "color: #c9d1d9; line-height: 1.6; margin-bottom: 20px; font-size: 15px;"

          # Engagement stats
          - ::
            type: "text"
            content: "💬 12 comments  •  ❤️ 45 likes  •  🔄 8 shares"
            css: "color: #6e7681; font-size: 13px; margin-bottom: 20px; padding-top: 16px; border-top: 1px solid #2f303e;"

          # Comments section
          - ::
            type: "thread"
            name: "Post 1 Comments"
            mode: "markdown"
            description: "Share your thoughts..."
            css: "min-height: 300px; background: #111218; border-radius: 8px; padding: 16px; border: 1px solid #2f303e;"

      # Post 2
      - ::
        type: "section-container"
        name: "Post Card 2"
        css: "max-width: 700px; margin: 0 auto 20px auto; background: #0d0e13; border: 1px solid #2f303e; border-radius: 12px; padding: 24px;"
        children::
          # Post header
          - ::
            type: "section-container"
            name: "Post Header"
            css: "display: flex; align-items: center; gap: 12px; margin-bottom: 16px;"
            children::
              - ::
                type: "text"
                content: "👨‍💻"
                css: "font-size: 20px;"

              - ::
                type: "section-container"
                name: "Author Info"
                css: "flex: 1;"
                children::
                  - ::
                    type: "text"
                    content: "Alex Martinez"
                    css: "color: #c9d1d9; font-weight: 600; font-size: 15px; margin-bottom: 2px;"

                  - ::
                    type: "text"
                    content: "@alexdev • 5h ago"
                    css: "color: #6e7681; font-size: 13px;"

          # Post content
          - ::
            type: "markdown-text"
            content: "Hot take: Design systems are only as good as their documentation.\n\n### Key principles I follow:\n\n1. **Every component needs examples**\n2. **Document the 'why', not just the 'what'**\n3. **Make it searchable**\n4. **Keep it up to date**\n\nWhat are your best practices? 🤔"
            mode: "markdown"
            css: "color: #c9d1d9; line-height: 1.6; margin-bottom: 20px; font-size: 15px;"

          # Engagement stats
          - ::
            type: "text"
            content: "💬 28 comments  •  ❤️ 89 likes  •  🔄 15 shares"
            css: "color: #6e7681; font-size: 13px; margin-bottom: 20px; padding-top: 16px; border-top: 1px solid #2f303e;"

          # Comments section
          - ::
            type: "thread"
            name: "Post 2 Comments"
            mode: "markdown"
            description: "Join the discussion..."
            css: "min-height: 300px; background: #111218; border-radius: 8px; padding: 16px; border: 1px solid #2f303e;"

      # Post 3
      - ::
        type: "section-container"
        name: "Post Card 3"
        css: "max-width: 700px; margin: 0 auto 20px auto; background: #0d0e13; border: 1px solid #2f303e; border-radius: 12px; padding: 24px;"
        children::
          # Post header
          - ::
            type: "section-container"
            name: "Post Header"
            css: "display: flex; align-items: center; gap: 12px; margin-bottom: 16px;"
            children::
              - ::
                type: "text"
                content: "👩‍🎨"
                css: "font-size: 20px;"

              - ::
                type: "section-container"
                name: "Author Info"
                css: "flex: 1;"
                children::
                  - ::
                    type: "text"
                    content: "Emma Wilson"
                    css: "color: #c9d1d9; font-weight: 600; font-size: 15px; margin-bottom: 2px;"

                  - ::
                    type: "text"
                    content: "@emmawilson • 8h ago"
                    css: "color: #6e7681; font-size: 13px;"

          # Post content
          - ::
            type: "markdown-text"
            content: "Quick tip for better UI contrast:\n\nInstead of using pure black (#000000), try these dark grays:\n- **Background:** #010409\n- **Cards:** #0d0e13\n- **Borders:** #2f303e\n\nYour eyes will thank you! ✨"
            mode: "markdown"
            css: "color: #c9d1d9; line-height: 1.6; margin-bottom: 20px; font-size: 15px;"

          # Engagement stats
          - ::
            type: "text"
            content: "💬 34 comments  •  ❤️ 156 likes  •  🔄 42 shares"
            css: "color: #6e7681; font-size: 13px; margin-bottom: 20px; padding-top: 16px; border-top: 1px solid #2f303e;"

          # Comments section
          - ::
            type: "thread"
            name: "Post 3 Comments"
            mode: "markdown"
            description: "What do you think?"
            css: "min-height: 300px; background: #111218; border-radius: 8px; padding: 16px; border: 1px solid #2f303e;"

      # Post 4 - Template for adding more
      - ::
        type: "section-container"
        name: "Post Card 4"
        css: "max-width: 700px; margin: 0 auto 20px auto; background: #0d0e13; border: 1px solid #2f303e; border-radius: 12px; padding: 24px;"
        children::
          # Post header
          - ::
            type: "section-container"
            name: "Post Header"
            css: "display: flex; align-items: center; gap: 12px; margin-bottom: 16px;"
            children::
              - ::
                type: "text"
                content: "🧑‍💼"
                css: "font-size: 20px;"

              - ::
                type: "section-container"
                name: "Author Info"
                css: "flex: 1;"
                children::
                  - ::
                    type: "text"
                    content: "David Park"
                    css: "color: #c9d1d9; font-weight: 600; font-size: 15px; margin-bottom: 2px;"

                  - ::
                    type: "text"
                    content: "@davidpark • 12h ago"
                    css: "color: #6e7681; font-size: 13px;"

          # Post content
          - ::
            type: "markdown-text"
            content: "Reminder: **Accessibility is not optional.**\n\nHere's my checklist:\n- [ ] Keyboard navigation\n- [ ] Screen reader support\n- [ ] Color contrast (WCAG AA minimum)\n- [ ] Focus indicators\n- [ ] Alt text for images\n- [ ] Semantic HTML\n\nLet's build for everyone! 🌍"
            mode: "markdown"
            css: "color: #c9d1d9; line-height: 1.6; margin-bottom: 20px; font-size: 15px;"

          # Engagement stats
          - ::
            type: "text"
            content: "💬 67 comments  •  ❤️ 234 likes  •  🔄 78 shares"
            css: "color: #6e7681; font-size: 13px; margin-bottom: 20px; padding-top: 16px; border-top: 1px solid #2f303e;"

          # Comments section
          - ::
            type: "thread"
            name: "Post 4 Comments"
            mode: "markdown"
            description: "Share your accessibility tips..."
            css: "min-height: 300px; background: #111218; border-radius: 8px; padding: 16px; border: 1px solid #2f303e;"

      # Footer
      - ::
        type: "section-container"
        name: "Footer"
        css: "max-width: 700px; margin: 40px auto 0 auto; text-align: center;"
        children::
          - ::
            type: "text"
            content: "End of feed • Add more posts by copying the Post Card structure above"
            css: "color: #6e7681; font-size: 13px;"
