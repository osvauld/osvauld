name: "Osvauld Documentation"

screens::
  # HOME SCREEN
  - ::
    id: "home"
    name: "Home"
    isEntryPoint: true
    css: "background: #ffffff; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif;"
    children::
      - ::
        type: "section-container"
        name: "Layout"
        css: "display: flex; min-height: 100vh;"
        children::
          # SIDEBAR (same across all screens)
          - ::
            type: "section-container"
            name: "Sidebar"
            css: "width: 280px; background: #1e1e2e; color: white; padding: 30px 20px; position: fixed; height: 100vh; overflow-y: auto; box-shadow: 2px 0 8px rgba(0,0,0,0.1);"
            children::
              - ::
                type: "nav-button"
                content: "Osvauld"
                targetContainerId: "home"
                css: "color: #ffffff; font-size: 24px; font-weight: 700; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); background: transparent; border: none; text-align: left; width: 100%; cursor: pointer;"

              - ::
                type: "section-container"
                name: "Nav Group 1"
                css: "margin-bottom: 25px;"
                children::
                  - ::
                    type: "text"
                    content: "Introduction"
                    css: "color: #a0a0b0; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;"
                  - ::
                    type: "nav-button"
                    content: "Manifesto"
                    targetContainerId: "manifesto"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer; transition: background 0.2s;"
                  - ::
                    type: "nav-button"
                    content: "Technology Stack"
                    targetContainerId: "technology"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"

              - ::
                type: "section-container"
                name: "Nav Group 2"
                css: "margin-bottom: 25px;"
                children::
                  - ::
                    type: "text"
                    content: "Project Sthalam"
                    css: "color: #a0a0b0; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;"
                  - ::
                    type: "nav-button"
                    content: "Introduction"
                    targetContainerId: "sthalam"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"
                  - ::
                    type: "nav-button"
                    content: "Publishing Content"
                    targetContainerId: "publishing"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"
                  - ::
                    type: "nav-button"
                    content: "Forms & Submissions"
                    targetContainerId: "forms"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"
                  - ::
                    type: "nav-button"
                    content: "Comment Threads"
                    targetContainerId: "comments"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"

              - ::
                type: "section-container"
                name: "Nav Group 3"
                css: "margin-bottom: 25px;"
                children::
                  - ::
                    type: "text"
                    content: "Sovereign Node"
                    css: "color: #a0a0b0; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;"
                  - ::
                    type: "nav-button"
                    content: "Setup Guide"
                    targetContainerId: "node-setup"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%; cursor: pointer;"

          # CONTENT AREA
          - ::
            type: "section-container"
            name: "Content"
            css: "flex: 1; margin-left: 280px;"
            children::
              - ::
                type: "section-container"
                name: "Top Bar"
                css: "background: #ffffff; border-bottom: 1px solid #e5e7eb; padding: 20px 40px; position: sticky; top: 0; z-index: 50;"
                children::
                  - ::
                    type: "heading"
                    content: "Documentation"
                    css: "color: #111827; font-size: 20px; font-weight: 600; margin: 0;"

              # HERO
              - ::
                type: "section-container"
                name: "Hero"
                css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 80px 40px; text-align: center;"
                children::
                  - ::
                    type: "heading"
                    content: "Osvauld"
                    css: "color: white; font-size: 56px; font-weight: 800; margin-bottom: 20px;"
                  - ::
                    type: "text"
                    content: "Guides, resources, and API references to help you build with osvauld"
                    css: "color: rgba(255,255,255,0.95); font-size: 20px; margin: 0 auto 40px auto; max-width: 700px; line-height: 1.6;"
                  - ::
                    type: "section-container"
                    name: "Hero Actions"
                    css: "display: flex; gap: 15px; justify-content: center;"
                    children::
                      - ::
                        type: "nav-button"
                        content: "Get Started →"
                        targetContainerId: "sthalam"
                        css: "background: white; color: #667eea; padding: 14px 32px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"
                      - ::
                        type: "nav-button"
                        content: "Read Manifesto"
                        targetContainerId: "manifesto"
                        css: "background: rgba(255,255,255,0.2); color: white; padding: 14px 32px; border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

              # FEATURES
              - ::
                type: "section-container"
                name: "Features"
                css: "max-width: 1200px; margin: 0 auto; padding: 60px 40px;"
                children::
                  - ::
                    type: "section-container"
                    name: "Cards"
                    css: "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;"
                    children::
                      - ::
                        type: "section-container"
                        name: "Card 1"
                        css: "background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 35px;"
                        children::
                          - ::
                            type: "text"
                            content: "📝"
                            css: "font-size: 48px; margin-bottom: 20px; display: block;"
                          - ::
                            type: "heading"
                            content: "Project Sthalam"
                            css: "color: #111827; font-size: 24px; margin-bottom: 15px;"
                          - ::
                            type: "text"
                            content: "Sovereign publishing platform for creating and distributing content without intermediaries."
                            css: "color: #6b7280; font-size: 15px; line-height: 1.7; margin-bottom: 25px;"
                          - ::
                            type: "nav-button"
                            content: "Learn More →"
                            targetContainerId: "sthalam"
                            css: "background: #667eea; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-size: 14px; width: 100%;"

                      - ::
                        type: "section-container"
                        name: "Card 2"
                        css: "background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 35px;"
                        children::
                          - ::
                            type: "text"
                            content: "📓"
                            css: "font-size: 48px; margin-bottom: 20px; display: block;"
                          - ::
                            type: "heading"
                            content: "Livnote"
                            css: "color: #111827; font-size: 24px; margin-bottom: 15px;"
                          - ::
                            type: "text"
                            content: "Peer-to-peer collaborative note-taking with real-time synchronization."
                            css: "color: #6b7280; font-size: 15px; line-height: 1.7; margin-bottom: 25px;"
                          - ::
                            type: "nav-button"
                            content: "Coming Soon"
                            targetContainerId: "home"
                            css: "background: #e5e7eb; color: #6b7280; padding: 12px 24px; border: none; border-radius: 8px; font-size: 14px; width: 100%;"

                      - ::
                        type: "section-container"
                        name: "Card 3"
                        css: "background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 35px;"
                        children::
                          - ::
                            type: "text"
                            content: "🖥️"
                            css: "font-size: 48px; margin-bottom: 20px; display: block;"
                          - ::
                            type: "heading"
                            content: "Sovereign Node"
                            css: "color: #111827; font-size: 24px; margin-bottom: 15px;"
                          - ::
                            type: "text"
                            content: "Your personal server for complete control over your digital infrastructure."
                            css: "color: #6b7280; font-size: 15px; line-height: 1.7; margin-bottom: 25px;"
                          - ::
                            type: "nav-button"
                            content: "Setup Guide →"
                            targetContainerId: "node-setup"
                            css: "background: #667eea; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-size: 14px; width: 100%;"

  # Remaining screens follow the same sidebar pattern...
  # For brevity, I'll create a macro-like structure

  - ::
    id: "manifesto"
    name: "Manifesto"
    css: "background: #ffffff; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif;"
    children::
      - ::
        type: "section-container"
        name: "Layout"
        css: "display: flex; min-height: 100vh;"
        children::
          # Same sidebar as home
          - ::
            type: "section-container"
            name: "Sidebar"
            css: "width: 280px; background: #1e1e2e; padding: 30px 20px; position: fixed; height: 100vh; overflow-y: auto;"
            children::
              - ::
                type: "nav-button"
                content: "← Osvauld"
                targetContainerId: "home"
                css: "color: #ffffff; font-size: 18px; font-weight: 700; margin-bottom: 30px; background: transparent; border: none; text-align: left; width: 100%;"

          - ::
            type: "section-container"
            name: "Content"
            css: "flex: 1; margin-left: 280px;"
            children::
              - ::
                type: "section-container"
                name: "Article"
                css: "max-width: 900px; margin: 0 auto; padding: 60px 40px;"
                children::
                  - ::
                    type: "heading"
                    content: "Our Manifesto"
                    css: "color: #111827; font-size: 48px; margin-bottom: 30px;"
                  - ::
                    type: "markdown-text"
                    mode: "markdown"
                    content: "## The Problem\n\nToday, almost everything we do online requires surrendering sovereignty over our digital identity.\n\n## Our Solution\n\nWe're building applications that connect people **directly** - without servers, subscriptions, or intermediaries.\n\n## Principles\n\n- **Open source by default**\n- **Free to use**\n- **You own your keys**"
                    css: "background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 50px; line-height: 1.8; color: #374151;"

  - ::
    id: "comments"
    name: "Comments"
    css: "background: #ffffff; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif;"
    children::
      - ::
        type: "section-container"
        name: "Layout"
        css: "display: flex; min-height: 100vh;"
        children::
          - ::
            type: "section-container"
            name: "Sidebar"
            css: "width: 280px; background: #1e1e2e; padding: 30px 20px; position: fixed; height: 100vh; overflow-y: auto;"
            children::
              - ::
                type: "nav-button"
                content: "← Osvauld"
                targetContainerId: "home"
                css: "color: #ffffff; font-size: 18px; font-weight: 700; margin-bottom: 30px; background: transparent; border: none; text-align: left; width: 100%;"

          - ::
            type: "section-container"
            name: "Content"
            css: "flex: 1; margin-left: 280px;"
            children::
              - ::
                type: "section-container"
                name: "Article"
                css: "max-width: 900px; margin: 0 auto; padding: 60px 40px;"
                children::
                  - ::
                    type: "heading"
                    content: "Comment Threads"
                    css: "color: #111827; font-size: 48px; margin-bottom: 30px;"
                  - ::
                    type: "markdown-text"
                    mode: "markdown"
                    content: "## Real-Time Collaboration\n\nComment threads enable discussions between publishers and viewers.\n\n### Try It Out\n\nPost a comment below!"
                    css: "background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 50px; line-height: 1.8; color: #374151; margin-bottom: 40px;"

                  - ::
                    type: "section-container"
                    name: "Thread Demo"
                    css: "background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 40px;"
                    children::
                      - ::
                        type: "thread"
                        name: "Documentation Feedback"
                        mode: "markdown"
                        description: "Share your thoughts..."
                        css: "--thread-bg: #ffffff; --thread-border-color: #e5e7eb; --thread-text-color: #111827; --thread-title-color: #667eea; --thread-description-color: #6b7280; --thread-input-bg: #f9fafb; --thread-input-border: #d1d5db; --thread-input-text: #111827; --thread-input-placeholder: #9ca3af; --thread-input-focus-border: #667eea; --thread-input-focus-shadow: rgba(102,126,234,0.3); --thread-button-bg: #667eea; --thread-button-text: #ffffff; --thread-button-hover-bg: #5a67d8; --thread-button-disabled-bg: #d1d5db; --thread-button-disabled-text: #9ca3af; --thread-comment-bg: #f9fafb; --thread-comment-border: #e5e7eb; --thread-comment-author-color: #667eea; --thread-comment-time-color: #9ca3af; --thread-comment-content-color: #374151; --thread-toggle-bg: #ffffff; --thread-toggle-border: #e5e7eb; --thread-toggle-color: #374151; --thread-toggle-hover-bg: #f3f4f6; --thread-no-comments-color: #6b7280; --thread-scrollbar-track: #f9fafb; --thread-scrollbar-thumb: #d1d5db; --thread-scrollbar-thumb-hover: #9ca3af;"

  # Add placeholder screens for the rest
  - ::
    id: "technology"
    name: "Technology"
    css: "background: #ffffff; padding: 40px; font-family: system-ui;"
    children::
      - ::
        type: "nav-button"
        content: "← Home"
        targetContainerId: "home"
        css: "background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 6px; margin-bottom: 20px;"
      - ::
        type: "text"
        content: "Technology Stack Page"
        css: "font-size: 32px; color: #111827;"

  - ::
    id: "sthalam"
    name: "Sthalam"
    css: "background: #ffffff; padding: 40px; font-family: system-ui;"
    children::
      - ::
        type: "nav-button"
        content: "← Home"
        targetContainerId: "home"
        css: "background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 6px; margin-bottom: 20px;"
      - ::
        type: "text"
        content: "Sthalam Introduction Page"
        css: "font-size: 32px; color: #111827;"

  - ::
    id: "publishing"
    name: "Publishing"
    css: "background: #ffffff; padding: 40px; font-family: system-ui;"
    children::
      - ::
        type: "nav-button"
        content: "← Home"
        targetContainerId: "home"
        css: "background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 6px; margin-bottom: 20px;"
      - ::
        type: "text"
        content: "Publishing Content Page"
        css: "font-size: 32px; color: #111827;"

  - ::
    id: "forms"
    name: "Forms"
    css: "background: #ffffff; padding: 40px; font-family: system-ui;"
    children::
      - ::
        type: "nav-button"
        content: "← Home"
        targetContainerId: "home"
        css: "background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 6px; margin-bottom: 20px;"
      - ::
        type: "text"
        content: "Forms & Submissions Page"
        css: "font-size: 32px; color: #111827;"

  - ::
    id: "node-setup"
    name: "Node Setup"
    css: "background: #ffffff; padding: 40px; font-family: system-ui;"
    children::
      - ::
        type: "nav-button"
        content: "← Home"
        targetContainerId: "home"
        css: "background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 6px; margin-bottom: 20px;"
      - ::
        type: "text"
        content: "Sovereign Node Setup Page"
        css: "font-size: 32px; color: #111827;"
