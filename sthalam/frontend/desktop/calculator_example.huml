name: "Tip Calculator"
resourceType: "website"

state::
  billAmount: 0
  tipPercent: 15
  calculatedTip: 0
  totalAmount: 0
  showResults: false

screens::
  - ::
    id: "calculator"
    name: "Calculator Screen"
    isEntryPoint: true
    css: "min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; justify-content: center; align-items: center; padding: 20px;"
    children::
      - ::
        type: "section-container"
        name: "Calculator Container"
        css: "background: white; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 500px; width: 100%; padding: 40px;"
        children::
          - ::
            type: "heading"
            content: "💰 Tip Calculator"
            css: "font-size: 32px; font-weight: 700; color: #1a202c; margin: 0 0 32px 0; text-align: center;"

          # Bill Amount Input
          - ::
            type: "section-container"
            name: "Bill Input Section"
            css: "margin-bottom: 24px;"
            children::
              - ::
                type: "text"
                content: "Bill Amount"
                css: "font-size: 14px; font-weight: 600; color: #4a5568; margin: 0 0 8px 0; display: block;"

              - ::
                type: "form-field-text"
                fieldName: "billInput"
                placeholder: "Enter bill amount"
                formId: "calc-form"
                css: "margin-bottom: 0;"

          # Tip Percentage Buttons
          - ::
            type: "section-container"
            name: "Tip Selection Section"
            css: "margin-bottom: 24px;"
            children::
              - ::
                type: "text"
                content: "Select Tip Percentage"
                css: "font-size: 14px; font-weight: 600; color: #4a5568; margin: 0 0 12px 0; display: block;"

              - ::
                type: "section-container"
                name: "Tip Buttons Grid"
                css: "display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "10%"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 10
                    css: "padding: 16px; background: {{tipPercent == 10 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 10 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "15%"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 15
                    css: "padding: 16px; background: {{tipPercent == 15 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 15 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "18%"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 18
                    css: "padding: 16px; background: {{tipPercent == 18 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 18 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "20%"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 20
                    css: "padding: 16px; background: {{tipPercent == 20 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 20 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "25%"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 25
                    css: "padding: 16px; background: {{tipPercent == 25 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 25 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "Custom"
                    action: "setState"
                    stateKey: "tipPercent"
                    stateValue: 0
                    css: "padding: 16px; background: {{tipPercent == 0 ? '#667eea' : '#e2e8f0'}}; color: {{tipPercent == 0 ? 'white' : '#2d3748'}}; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

          # Custom Tip Input (only visible when Custom selected)
          - ::
            type: "section-container"
            name: "Custom Tip Input"
            visible: "{{tipPercent == 0}}"
            css: "margin-bottom: 24px;"
            children::
              - ::
                type: "form-field-text"
                fieldName: "customTip"
                placeholder: "Enter custom tip %"
                formId: "calc-form"

          # Calculate Button
          - ::
            type: "nav-button"
            content: "Calculate"
            action: "setState"
            stateUpdates::
              calculatedTip: "{{billAmount * (tipPercent / 100)}}"
              totalAmount: "{{billAmount + (billAmount * (tipPercent / 100))}}"
              showResults: true
            css: "width: 100%; padding: 16px; background: #48bb78; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 18px; cursor: pointer; margin-bottom: 32px; box-shadow: 0 4px 12px rgba(72, 187, 120, 0.4);"

          # Results Section (conditional visibility)
          - ::
            type: "section-container"
            name: "Results Section"
            visible: "{{showResults}}"
            css: "background: #f7fafc; border-radius: 12px; padding: 24px; border: 2px solid #e2e8f0;"
            children::
              - ::
                type: "heading"
                content: "Results"
                css: "font-size: 20px; font-weight: 700; color: #2d3748; margin: 0 0 16px 0;"

              - ::
                type: "section-container"
                name: "Result Row Bill"
                css: "display: flex; justify-content: space-between; margin-bottom: 12px;"
                children::
                  - ::
                    type: "text"
                    content: "Bill Amount:"
                    css: "font-size: 16px; color: #4a5568; margin: 0;"

                  - ::
                    type: "text"
                    content: "${{billAmount}}"
                    css: "font-size: 16px; font-weight: 600; color: #2d3748; margin: 0;"

              - ::
                type: "section-container"
                name: "Result Row Tip"
                css: "display: flex; justify-content: space-between; margin-bottom: 12px;"
                children::
                  - ::
                    type: "text"
                    content: "Tip ({{tipPercent}}%):"
                    css: "font-size: 16px; color: #4a5568; margin: 0;"

                  - ::
                    type: "text"
                    content: "${{calculatedTip}}"
                    css: "font-size: 16px; font-weight: 600; color: #667eea; margin: 0;"

              - ::
                type: "section-container"
                name: "Divider"
                css: "height: 1px; background: #cbd5e0; margin: 16px 0;"

              - ::
                type: "section-container"
                name: "Result Row Total"
                css: "display: flex; justify-content: space-between;"
                children::
                  - ::
                    type: "text"
                    content: "Total Amount:"
                    css: "font-size: 18px; font-weight: 700; color: #2d3748; margin: 0;"

                  - ::
                    type: "text"
                    content: "${{totalAmount}}"
                    css: "font-size: 18px; font-weight: 700; color: #48bb78; margin: 0;"

          # Hidden form definition
          - ::
            type: "form"
            id: "calc-form"
