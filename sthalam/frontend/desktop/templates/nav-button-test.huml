# Nav-Button Test Template
# Tests all 3 modes: Simple navigation, Form submission, and Branching

name: "Nav-Button Test"

screens::
  # Screen 1: Welcome & Mode Selection
  - ::
    id: "welcome"
    name: "Nav-Button Test Home"
    isEntryPoint: true
    css: "padding: 3rem; background: linear-gradient(135deg, #1e1e2e 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "Nav-Button Test Suite"
        css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Test all 3 modes of the unified nav-button component"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 3rem; font-size: 18px;"

      # Test MODE 1: Simple Navigation
      - ::
        type: "section-container"
        name: "Mode 1 Test"
        css: "background: rgba(166, 227, 161, 0.1); border: 2px solid #a6e3a1; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          - ::
            type: "text"
            content: "MODE 1: Simple Navigation"
            css: "color: #a6e3a1; font-size: 24px; font-weight: 600; margin-bottom: 0.5rem;"

          - ::
            type: "text"
            content: "Just navigates to another screen without any form submission"
            css: "color: #c9d1d9; margin-bottom: 1rem;"

          - ::
            type: "nav-button"
            content: "Test Mode 1 →"
            action: "navigate"
            targetContainerId: "mode1-result"
            css: "padding: 1rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

      # Test MODE 2: Form Submission
      - ::
        type: "section-container"
        name: "Mode 2 Test"
        css: "background: rgba(137, 180, 250, 0.1); border: 2px solid #89b4fa; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          - ::
            type: "text"
            content: "MODE 2: Form Submission + Navigation"
            css: "color: #89b4fa; font-size: 24px; font-weight: 600; margin-bottom: 0.5rem;"

          - ::
            type: "text"
            content: "Submits entire form and navigates (replaces form-submit-button)"
            css: "color: #c9d1d9; margin-bottom: 1rem;"

          - ::
            type: "nav-button"
            content: "Test Mode 2 →"
            action: "navigate"
            targetContainerId: "mode2-test"
            css: "padding: 1rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

      # Test MODE 3: Branching
      - ::
        type: "section-container"
        name: "Mode 3 Test"
        css: "background: rgba(249, 226, 175, 0.1); border: 2px solid #f9e2af; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          - ::
            type: "text"
            content: "MODE 3: Branching with Field Values"
            css: "color: #f9e2af; font-size: 24px; font-weight: 600; margin-bottom: 0.5rem;"

          - ::
            type: "text"
            content: "Sets field value and navigates (replaces branching-question)"
            css: "color: #c9d1d9; margin-bottom: 1rem;"

          - ::
            type: "nav-button"
            content: "Test Mode 3 →"
            action: "navigate"
            targetContainerId: "mode3-test"
            css: "padding: 1rem 2rem; background: #f9e2af; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 2: MODE 1 Result
  - ::
    id: "mode1-result"
    name: "Mode 1 Result"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "✅ MODE 1: Success!"
        css: "font-size: 48px; color: #a6e3a1; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Simple navigation worked! No form data was submitted."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "**What happened:**\n\n- Nav-button with just `action: navigate` and `targetContainerId`\n- No `formId`, so no data submission\n- Just changed screens"
        css: "color: #c9d1d9; background: rgba(166, 227, 161, 0.1); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  # Screen 3: MODE 2 Test (Form)
  - ::
    id: "mode2-test"
    name: "Mode 2 Test - Form"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "MODE 2: Form Submission Test"
        css: "font-size: 36px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Fill out this form and submit using nav-button"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem;"

      # Form definition (with explicit ID)
      - ::
        id: "form-mode2-test"
        type: "form"
        name: "Mode 2 Test Form"
        eventName: "mode2_form_submission"

      - ::
        type: "section-container"
        name: "Form Container"
        css: "background: rgba(137, 180, 250, 0.1); border: 2px solid #89b4fa; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%;"
        children::
          - ::
            type: "form-field-text"
            formId: "form-mode2-test"
            fieldName: "username"
            label: "Username"
            placeholder: "Enter your username"
            required: true
            css: "margin-bottom: 1rem;"

          - ::
            type: "form-field-email"
            formId: "form-mode2-test"
            fieldName: "email"
            label: "Email Address"
            placeholder: "you@example.com"
            required: true
            css: "margin-bottom: 1rem;"

          - ::
            type: "form-field-textarea"
            formId: "form-mode2-test"
            fieldName: "comments"
            label: "Comments"
            placeholder: "Any feedback?"
            required: false
            css: "margin-bottom: 2rem;"

          # MODE 2: Submit button
          - ::
            type: "nav-button"
            formId: "form-mode2-test"
            content: "Submit Form & Continue"
            action: "navigate"
            targetContainerId: "mode2-result"
            css: "padding: 1rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #6c7086; color: #cdd6f4; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 2rem;"

  # Screen 4: MODE 2 Result
  - ::
    id: "mode2-result"
    name: "Mode 2 Result"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "✅ MODE 2: Form Submitted!"
        css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Your form data was submitted and you were navigated here."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "**What happened:**\n\n1. Nav-button collected all form fields with matching `formId`\n2. Validated required fields\n3. Submitted data to `submissionsDoc`\n4. Navigated to this screen\n\n**Check your console/submissions to see the data!**"
        css: "color: #c9d1d9; background: rgba(137, 180, 250, 0.1); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  # Screen 5: MODE 3 Test (Branching)
  - ::
    id: "mode3-test"
    name: "Mode 3 Test - Branching"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "MODE 3: Branching Test"
        css: "font-size: 36px; color: #f9e2af; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Click a button to set a field value and navigate"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 3rem;"

      # Form to track choice (with explicit ID)
      - ::
        id: "form-mode3-branching"
        type: "form"
        name: "Mode 3 Branching Form"
        eventName: "mode3_branching_choice"

      - ::
        type: "section-container"
        name: "Branching Question"
        css: "background: rgba(249, 226, 175, 0.1); border: 2px solid #f9e2af; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          - ::
            type: "text"
            content: "What's your favorite color?"
            css: "color: #f9e2af; font-size: 24px; font-weight: 600; text-align: center; margin-bottom: 1rem;"

          # Option 1: Blue
          - ::
            type: "nav-button"
            formId: "form-mode3-branching"
            fieldName: "favorite_color"
            value: "blue"
            content: "🔵 Blue"
            action: "navigate"
            targetContainerId: "mode3-result-blue"
            css: "padding: 1.5rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

          # Option 2: Green
          - ::
            type: "nav-button"
            formId: "form-mode3-branching"
            fieldName: "favorite_color"
            value: "green"
            content: "🟢 Green"
            action: "navigate"
            targetContainerId: "mode3-result-green"
            css: "padding: 1.5rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

          # Option 3: Red
          - ::
            type: "nav-button"
            formId: "form-mode3-branching"
            fieldName: "favorite_color"
            value: "red"
            content: "🔴 Red"
            action: "navigate"
            targetContainerId: "mode3-result-red"
            css: "padding: 1.5rem 2rem; background: #f38ba8; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #6c7086; color: #cdd6f4; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 2rem;"

  # Screen 6A: MODE 3 Result - Blue
  - ::
    id: "mode3-result-blue"
    name: "Mode 3 Result - Blue"
    css: "padding: 3rem; background: linear-gradient(135deg, #1e3a8a 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "🔵 You chose Blue!"
        css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Great choice! Blue is calming and serene."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "**What happened:**\n\n- You clicked the Blue button\n- It set `favorite_color = \"blue\"`\n- Submitted: `{\"favorite_color\": \"blue\"}`\n- Navigated to this blue-themed screen\n\n**Check your submissions doc to see the data!**"
        css: "color: #c9d1d9; background: rgba(137, 180, 250, 0.2); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px; border: 2px solid #89b4fa;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #89b4fa; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  # Screen 6B: MODE 3 Result - Green
  - ::
    id: "mode3-result-green"
    name: "Mode 3 Result - Green"
    css: "padding: 3rem; background: linear-gradient(135deg, #1e3a2e 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "🟢 You chose Green!"
        css: "font-size: 48px; color: #a6e3a1; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Excellent! Green represents growth and harmony."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "**What happened:**\n\n- You clicked the Green button\n- It set `favorite_color = \"green\"`\n- Submitted: `{\"favorite_color\": \"green\"}`\n- Navigated to this green-themed screen\n\n**Check your submissions doc to see the data!**"
        css: "color: #c9d1d9; background: rgba(166, 227, 161, 0.2); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px; border: 2px solid #a6e3a1;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  # Screen 6C: MODE 3 Result - Red
  - ::
    id: "mode3-result-red"
    name: "Mode 3 Result - Red"
    css: "padding: 3rem; background: linear-gradient(135deg, #6e1a3a 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; min-height: 100vh; gap: 2rem;"
    children::
      - ::
        type: "heading"
        content: "🔴 You chose Red!"
        css: "font-size: 48px; color: #f38ba8; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Bold choice! Red symbolizes passion and energy."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "**What happened:**\n\n- You clicked the Red button\n- It set `favorite_color = \"red\"`\n- Submitted: `{\"favorite_color\": \"red\"}`\n- Navigated to this red-themed screen\n\n**Check your submissions doc to see the data!**"
        css: "color: #c9d1d9; background: rgba(243, 139, 168, 0.2); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px; border: 2px solid #f38ba8;"

      - ::
        type: "nav-button"
        content: "← Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #f38ba8; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"
