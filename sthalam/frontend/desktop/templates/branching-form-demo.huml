# Branching Form Flow Demo (Updated)
# Uses new nav-button approach with formId, fieldName, and value
# No more separate branching-question blocks needed!

name: "Branching Form Demo v2"

screens::
  # Screen 1: Entry Point - Customer Type Selection
  - ::
    id: "welcome"
    name: "Welcome Screen"
    isEntryPoint: true
    css: "padding: 3rem; background: linear-gradient(135deg, #1e1e2e 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Welcome to Customer Support"
        css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "We're here to help! Let us know if you're new or returning."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 3rem; font-size: 18px;"

      # Form to track customer journey
      - ::
        id: "form-customer-journey"
        type: "form"
        name: "Customer Journey Form"
        eventName: "customer_journey_start"

      - ::
        type: "section-container"
        name: "Selection Container"
        css: "background: rgba(137, 180, 250, 0.1); border: 2px solid #89b4fa; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          # Button 1: New Customer (sets customer_type=new)
          - ::
            type: "nav-button"
            formId: "form-customer-journey"
            fieldName: "customer_type"
            value: "new_customer"
            content: "Yes, I'm a New Customer"
            action: "navigate"
            targetContainerId: "new_customer"
            css: "padding: 1.5rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

          # Button 2: Returning Customer (sets customer_type=returning)
          - ::
            type: "nav-button"
            formId: "form-customer-journey"
            fieldName: "customer_type"
            value: "returning_customer"
            content: "No, I'm a Returning Customer"
            action: "navigate"
            targetContainerId: "issue_type"
            css: "padding: 1.5rem 2rem; background: #f9e2af; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 2A: New Customer Registration
  - ::
    id: "new_customer"
    name: "New Customer Registration"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "New Customer Registration"
        css: "font-size: 42px; color: #a6e3a1; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Welcome! Please fill out this form to get started."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem;"

      # Form for new customer data
      - ::
        id: "form-new-customer-reg"
        type: "form"
        name: "New Customer Registration Form"
        eventName: "new_customer_registration"

      - ::
        type: "section-container"
        name: "Registration Form"
        css: "background: rgba(166, 227, 161, 0.1); border: 2px solid #a6e3a1; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%;"
        children::
          - ::
            type: "form-field-text"
            formId: "form-new-customer-reg"
            fieldName: "full_name"
            label: "Full Name"
            placeholder: "John Doe"
            required: true
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-email"
            formId: "form-new-customer-reg"
            fieldName: "email"
            label: "Email Address"
            placeholder: "john@example.com"
            required: true
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-text"
            formId: "form-new-customer-reg"
            fieldName: "company"
            label: "Company Name (Optional)"
            placeholder: "Acme Inc"
            required: false
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-textarea"
            formId: "form-new-customer-reg"
            fieldName: "interests"
            label: "What are you interested in?"
            placeholder: "Tell us about your needs..."
            required: false
            css: "margin-bottom: 2rem;"

          # Submit button (MODE 2: submits entire form + navigates)
          - ::
            type: "nav-button"
            formId: "form-new-customer-reg"
            content: "Register & Continue"
            action: "navigate"
            targetContainerId: "thank_you"
            css: "padding: 1rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 2B: Issue Type Selection (for returning customers)
  - ::
    id: "issue_type"
    name: "Select Issue Type"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Welcome Back!"
        css: "font-size: 42px; color: #f9e2af; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "What type of issue are you experiencing?"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 3rem;"

      # Form to track issue type
      - ::
        id: "form-issue-type"
        type: "form"
        name: "Issue Type Form"
        eventName: "issue_type_selection"

      - ::
        type: "section-container"
        name: "Issue Selection"
        css: "background: rgba(249, 226, 175, 0.1); border: 2px solid #f9e2af; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%; display: flex; flex-direction: column; gap: 1rem;"
        children::
          # Button 1: Technical Issue
          - ::
            type: "nav-button"
            formId: "form-issue-type"
            fieldName: "issue_type"
            value: "technical"
            content: "Technical Issue"
            action: "navigate"
            targetContainerId: "support_technical"
            css: "padding: 1.5rem 2rem; background: #cba6f7; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

          # Button 2: Billing Question
          - ::
            type: "nav-button"
            formId: "form-issue-type"
            fieldName: "issue_type"
            value: "billing"
            content: "Billing Question"
            action: "navigate"
            targetContainerId: "support_billing"
            css: "padding: 1.5rem 2rem; background: #f38ba8; color: #1e1e2e; border: none; border-radius: 8px; font-size: 18px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 3A: Technical Support Form
  - ::
    id: "support_technical"
    name: "Technical Support"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Technical Support Request"
        css: "font-size: 42px; color: #cba6f7; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Please provide details about your technical issue."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem;"

      - ::
        id: "form-tech-support"
        type: "form"
        name: "Technical Support Form"
        eventName: "technical_support_submission"

      - ::
        type: "section-container"
        name: "Tech Support Form"
        css: "background: rgba(203, 166, 247, 0.1); border: 2px solid #cba6f7; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%;"
        children::
          - ::
            type: "form-field-email"
            formId: "form-tech-support"
            fieldName: "email"
            label: "Your Email"
            placeholder: "your@email.com"
            required: true
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-text"
            formId: "form-tech-support"
            fieldName: "error_code"
            label: "Error Code (if any)"
            placeholder: "ERR-500"
            required: false
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-textarea"
            formId: "form-tech-support"
            fieldName: "issue_description"
            label: "Describe the Issue"
            placeholder: "What happened? When did it start?"
            required: true
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-checkbox"
            formId: "form-tech-support"
            fieldName: "urgent"
            label: "This is urgent and blocking my work"
            required: false
            css: "margin-bottom: 2rem;"

          - ::
            type: "nav-button"
            formId: "form-tech-support"
            content: "Submit Support Ticket"
            action: "navigate"
            targetContainerId: "thank_you"
            css: "padding: 1rem 2rem; background: #cba6f7; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 3B: Billing Support Form
  - ::
    id: "support_billing"
    name: "Billing Support"
    css: "padding: 3rem; background: #0d0e13; display: flex; flex-direction: column; align-items: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Billing Question"
        css: "font-size: 42px; color: #f38ba8; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Let us help with your billing inquiry."
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem;"

      - ::
        id: "form-billing-support"
        type: "form"
        name: "Billing Support Form"
        eventName: "billing_support_submission"

      - ::
        type: "section-container"
        name: "Billing Form"
        css: "background: rgba(243, 139, 168, 0.1); border: 2px solid #f38ba8; border-radius: 12px; padding: 2rem; max-width: 600px; width: 100%;"
        children::
          - ::
            type: "form-field-email"
            formId: "form-billing-support"
            fieldName: "email"
            label: "Account Email"
            placeholder: "account@email.com"
            required: true
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-text"
            formId: "form-billing-support"
            fieldName: "invoice_number"
            label: "Invoice Number (Optional)"
            placeholder: "INV-2024-001"
            required: false
            css: "margin-bottom: 1.5rem;"

          - ::
            type: "form-field-textarea"
            formId: "form-billing-support"
            fieldName: "billing_question"
            label: "Your Question"
            placeholder: "How can we help with billing?"
            required: true
            css: "margin-bottom: 2rem;"

          - ::
            type: "nav-button"
            formId: "form-billing-support"
            content: "Submit Billing Question"
            action: "navigate"
            targetContainerId: "thank_you"
            css: "padding: 1rem 2rem; background: #f38ba8; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%;"

  # Screen 4: Thank You
  - ::
    id: "thank_you"
    name: "Thank You"
    css: "padding: 3rem; background: linear-gradient(135deg, #1e3a2e 0%, #0d0e13 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Thank You!"
        css: "font-size: 48px; color: #a6e3a1; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Your submission has been recorded. We'll be in touch soon!"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "markdown-text"
        content: "## What's Next?\n\n1. Check your email for confirmation\n2. We typically respond within 24 hours\n3. You can track your request in the portal\n\n> All your selections and form data have been captured!"
        css: "color: #c9d1d9; background: rgba(166, 227, 161, 0.1); padding: 2rem; border-radius: 8px; line-height: 1.6; max-width: 600px;"

      - ::
        type: "nav-button"
        content: "Back to Home"
        action: "navigate"
        targetContainerId: "welcome"
        css: "padding: 1rem 2rem; background: #a6e3a1; color: #1e1e2e; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 2rem;"
