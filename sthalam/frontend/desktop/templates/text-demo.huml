# Text and Markdown Demo
# Shows text, heading, and markdown-text blocks for testing editing features

name: "Text Demo"

screens::
  - ::
    id: "main"
    name: "Main Screen (Entry)"
    isEntryPoint: true
    css: "padding: 2rem; background: #0d0e13; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "Welcome to Our Platform"
        css: "font-size: 48px; color: #89b4fa; text-align: center; margin-bottom: 1rem;"

      - ::
        type: "text"
        content: "Build amazing websites with ease"
        css: "color: #c9d1d9; text-align: center; margin-bottom: 2rem; font-size: 18px;"

      - ::
        type: "section-container"
        name: "Header"
        css: "background: rgba(137, 180, 250, 0.1); border: 2px solid #89b4fa; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem;"
        children::
          - ::
            type: "heading"
            content: "Getting Started"
            css: "font-size: 32px; color: #89b4fa; margin-bottom: 1rem;"

          - ::
            type: "markdown-text"
            content: "## Features\n\n- **Easy to use** - Intuitive drag and drop interface\n- **Powerful** - Build complex layouts with containers\n- **Flexible** - Customize every aspect of your design\n\n### Quick Start\n\n1. Create a new screen\n2. Add containers and components\n3. Style and configure\n4. Preview and deploy\n\n> This is a blockquote example showing markdown support"
            css: "color: #c9d1d9; line-height: 1.6;"

      - ::
        type: "section-container"
        name: "Content"
        css: "background: rgba(166, 227, 161, 0.1); border: 2px solid #a6e3a1; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem;"
        children::
          - ::
            type: "heading"
            content: "Advanced Features"
            css: "font-size: 24px; color: #a6e3a1; margin-bottom: 0.75rem;"

          - ::
            type: "text"
            content: "Explore nested containers, responsive layouts, and more."
            css: "color: #c9d1d9; margin-bottom: 1rem;"

          - ::
            type: "markdown-text"
            content: "### Code Example\n\n```javascript\nfunction hello() {\n  console.log(\"Hello World!\");\n}\n```\n\nThis demonstrates code block support in markdown."
            css: "color: #c9d1d9; background: rgba(0, 0, 0, 0.3); padding: 1rem; border-radius: 8px; line-height: 1.6;"

      - ::
        type: "section-container"
        name: "Footer"
        css: "background: rgba(249, 226, 175, 0.1); border: 2px solid #f9e2af; border-radius: 12px; padding: 1.5rem;"
        children::
          - ::
            type: "heading"
            content: "Learn More"
            css: "font-size: 20px; color: #f9e2af; margin-bottom: 0.5rem;"

          - ::
            type: "text"
            content: "Check our documentation for detailed guides and tutorials."
            css: "color: #c9d1d9;"
