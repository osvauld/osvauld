name: "Calculator App"
resourceType: "website"

state::
  display: "0"
  previousValue: 0
  operation: ""
  waitingForNewValue: false
  expression: ""
  digits::
    - 7
    - 8
    - 9
    - 4
    - 5
    - 6
    - 1
    - 2
    - 3
    - 0
  operations::
    - ::
      symbol: "÷"
      op: "divide"
    - ::
      symbol: "×"
      op: "multiply"
    - ::
      symbol: "-"
      op: "subtract"
    - ::
      symbol: "+"
      op: "add"

screens::
  - ::
    id: "calculator"
    name: "Calculator Screen"
    isEntryPoint: true
    css: "min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
    children::
      - ::
        type: "section-container"
        name: "Calculator Container"
        css: "background: #1f2937; border-radius: 24px; padding: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.4); max-width: 400px; width: 100%;"
        children::
          # Title
          - ::
            type: "heading"
            content: "Calculator"
            css: "color: #f3f4f6; font-size: 24px; font-weight: 700; margin: 0 0 24px 0; text-align: center;"

          # Display
          - ::
            type: "section-container"
            name: "Display"
            css: "background: #111827; border-radius: 16px; padding: 24px; margin-bottom: 24px; min-height: 100px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center;"
            children::
              # Expression display (shows the calculation being performed)
              - ::
                type: "text"
                content: "{{expression}}"
                visible: "{{expression != ''}}"
                css: "color: #9ca3af; font-size: 20px; font-weight: 400; font-family: 'SF Mono', 'Monaco', 'Consolas', monospace; text-align: right; width: 100%; margin-bottom: 8px; min-height: 24px;"

              # Current display
              - ::
                type: "text"
                content: "{{display}}"
                css: "color: #f3f4f6; font-size: 48px; font-weight: 300; font-family: 'SF Mono', 'Monaco', 'Consolas', monospace; word-break: break-all; text-align: right; width: 100%;"

          # Button Grid
          - ::
            type: "section-container"
            name: "Button Grid"
            css: "display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;"
            children::
              # Clear button (full width)
              - ::
                type: "nav-button"
                content: "C"
                action: "setState"
                stateUpdates::
                  display: "0"
                  previousValue: 0
                  operation: ""
                  expression: ""
                  waitingForNewValue: false
                css: "grid-column: span 2; padding: 24px; background: #ef4444; color: white; border: none; border-radius: 12px; font-size: 24px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);"

              # Backspace button
              - ::
                type: "nav-button"
                content: "⌫"
                action: "setState"
                stateKey: "display"
                stateValue: "{{display.length > 1 ? display.slice(0, -1) : '0'}}"
                css: "padding: 24px; background: #6b7280; color: white; border: none; border-radius: 12px; font-size: 24px; font-weight: 600; cursor: pointer; transition: all 0.2s;"

              # Divide button
              - ::
                type: "nav-button"
                content: "÷"
                action: "setState"
                stateUpdates::
                  previousValue: "{{Number(display)}}"
                  operation: "divide"
                  expression: "{{display + ' ÷'}}"
                  waitingForNewValue: true
                css: "padding: 24px; background: #f59e0b; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);"

              # Number buttons (7-9, 4-6, 1-3, 0) using forEach
              - ::
                type: "nav-button"
                forEach: "digits"
                content: "{{item}}"
                action: "setState"
                stateUpdates::
                  display: "{{waitingForNewValue ? String(item) : (display == '0' ? String(item) : display + String(item))}}"
                  waitingForNewValue: false
                css: "padding: 24px; background: #374151; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s; {{index == 9 ? 'grid-column: span 2;' : ''}}"

              # Decimal point
              - ::
                type: "nav-button"
                content: "."
                action: "setState"
                stateKey: "display"
                stateValue: "{{display.includes('.') ? display : display + '.'}}"
                css: "padding: 24px; background: #374151; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s;"

              # Multiply button
              - ::
                type: "nav-button"
                content: "×"
                action: "setState"
                stateUpdates::
                  previousValue: "{{Number(display)}}"
                  operation: "multiply"
                  expression: "{{display + ' ×'}}"
                  waitingForNewValue: true
                css: "padding: 24px; background: #f59e0b; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);"

              # Subtract button
              - ::
                type: "nav-button"
                content: "-"
                action: "setState"
                stateUpdates::
                  previousValue: "{{Number(display)}}"
                  operation: "subtract"
                  expression: "{{display + ' -'}}"
                  waitingForNewValue: true
                css: "padding: 24px; background: #f59e0b; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);"

              # Add button
              - ::
                type: "nav-button"
                content: "+"
                action: "setState"
                stateUpdates::
                  previousValue: "{{Number(display)}}"
                  operation: "add"
                  expression: "{{display + ' +'}}"
                  waitingForNewValue: true
                css: "padding: 24px; background: #f59e0b; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);"

              # Equals button
              - ::
                type: "nav-button"
                content: "="
                action: "setState"
                stateUpdates::
                  display: "{{operation == 'add' ? String(Number(previousValue) + Number(display)) : (operation == 'subtract' ? String(Number(previousValue) - Number(display)) : (operation == 'multiply' ? String(Number(previousValue) * Number(display)) : (operation == 'divide' ? String(Number(previousValue) / Number(display)) : display)))}}"
                  expression: "{{operation != '' ? expression + ' ' + display + ' =' : ''}}"
                  operation: ""
                  waitingForNewValue: true
                css: "grid-column: span 4; padding: 24px; background: #10b981; color: white; border: none; border-radius: 12px; font-size: 28px; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);"

          # Info text
          - ::
            type: "text"
            content: "Built with HUML + Fine-Grained Signals"
            css: "color: #9ca3af; font-size: 12px; text-align: center; margin-top: 16px;"
