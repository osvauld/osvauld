name: "Contact Form with JEXL"
resourceType: "website"

state::
  currentStep: 1
  formSubmitted: false

screens::
  - ::
    id: "main"
    name: "Contact Form"
    isEntryPoint: true
    css: "min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; justify-content: center; align-items: center; padding: 20px;"
    children::
      # Main form container
      - ::
        type: "section-container"
        name: "Main Form Container"
        css: "background: white; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 600px; width: 100%; padding: 48px; position: relative;"
        children::
          # Header
          - ::
            type: "heading"
            content: "Get in Touch"
            css: "font-size: 32px; font-weight: 700; color: #1a202c; margin: 0 0 8px 0; text-align: center;"

          - ::
            type: "text"
            content: "Fill out the form below and we'll get back to you soon."
            css: "font-size: 16px; color: #718096; margin: 0 0 32px 0; text-align: center;"

          # Progress indicator
          - ::
            type: "section-container"
            name: "Progress Indicator"
            css: "display: flex; justify-content: center; gap: 12px; margin-bottom: 40px;"
            children::
              - ::
                type: "section-container"
                name: "Progress Step 1 Circle"
                css: "width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; background: {{currentStep >= 1 ? '#667eea' : '#e2e8f0'}}; color: {{currentStep >= 1 ? 'white' : '#a0aec0'}}; transition: all 0.3s;"
                children::
                  - ::
                    type: "text"
                    content: "1"
                    css: "margin: 0; font-size: 18px;"

              - ::
                type: "section-container"
                name: "Progress Connector 1-2"
                css: "width: 60px; height: 4px; background: {{currentStep >= 2 ? '#667eea' : '#e2e8f0'}}; align-self: center; border-radius: 2px; transition: all 0.3s;"

              - ::
                type: "section-container"
                name: "Progress Step 2 Circle"
                css: "width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; background: {{currentStep >= 2 ? '#667eea' : '#e2e8f0'}}; color: {{currentStep >= 2 ? 'white' : '#a0aec0'}}; transition: all 0.3s;"
                children::
                  - ::
                    type: "text"
                    content: "2"
                    css: "margin: 0; font-size: 18px;"

              - ::
                type: "section-container"
                name: "Progress Connector 2-3"
                css: "width: 60px; height: 4px; background: {{currentStep >= 3 ? '#667eea' : '#e2e8f0'}}; align-self: center; border-radius: 2px; transition: all 0.3s;"

              - ::
                type: "section-container"
                name: "Progress Step 3 Circle"
                css: "width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; background: {{currentStep >= 3 ? '#667eea' : '#e2e8f0'}}; color: {{currentStep >= 3 ? 'white' : '#a0aec0'}}; transition: all 0.3s;"
                children::
                  - ::
                    type: "text"
                    content: "3"
                    css: "margin: 0; font-size: 18px;"

          # Form definition
          - ::
            type: "form"
            id: "contact-form"
            name: "Contact Form"
            eventName: "contact_submission"

          # STEP 1: Personal Info
          - ::
            type: "section-container"
            visible: "{{currentStep == 1 && !formSubmitted}}"
            css: "animation: fadeIn 0.3s ease-in;"
            children::
              - ::
                type: "heading"
                content: "Step 1: Personal Information"
                css: "font-size: 20px; font-weight: 600; color: #2d3748; margin: 0 0 24px 0;"

              - ::
                type: "form-field-text"
                label: "Full Name"
                fieldName: "fullName"
                placeholder: "John Doe"
                required: true
                formId: "contact-form"
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-email"
                label: "Email Address"
                fieldName: "email"
                placeholder: "john@example.com"
                required: true
                formId: "contact-form"
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-tel"
                label: "Phone Number"
                fieldName: "phone"
                placeholder: "+1 (555) 123-4567"
                formId: "contact-form"
                css: "margin-bottom: 32px;"

              # Navigation buttons
              - ::
                type: "section-container"
                css: "display: flex; justify-content: flex-end; gap: 12px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "Next →"
                    action: "setState"
                    stateKey: "currentStep"
                    stateValue: 2
                    formId: "contact-form"
                    css: "padding: 12px 32px; background: #667eea; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

          # STEP 2: Message
          - ::
            type: "section-container"
            visible: "{{currentStep == 2 && !formSubmitted}}"
            css: "animation: fadeIn 0.3s ease-in;"
            children::
              - ::
                type: "heading"
                content: "Step 2: Your Message"
                css: "font-size: 20px; font-weight: 600; color: #2d3748; margin: 0 0 24px 0;"

              - ::
                type: "form-field-select"
                label: "Subject"
                fieldName: "subject"
                required: true
                formId: "contact-form"
                options::
                  - "General Inquiry"
                  - "Technical Support"
                  - "Sales Question"
                  - "Partnership Opportunity"
                  - "Other"
                css: "margin-bottom: 20px;"

              - ::
                type: "form-field-textarea"
                label: "Message"
                fieldName: "message"
                placeholder: "Tell us more about how we can help..."
                required: true
                formId: "contact-form"
                css: "margin-bottom: 32px; min-height: 150px;"

              # Navigation buttons
              - ::
                type: "section-container"
                css: "display: flex; justify-content: space-between; gap: 12px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    action: "setState"
                    stateKey: "currentStep"
                    stateValue: 1
                    formId: "contact-form"
                    css: "padding: 12px 32px; background: #e2e8f0; color: #2d3748; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "Next →"
                    action: "setState"
                    stateKey: "currentStep"
                    stateValue: 3
                    formId: "contact-form"
                    css: "padding: 12px 32px; background: #667eea; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

          # STEP 3: Review & Submit
          - ::
            type: "section-container"
            visible: "{{currentStep == 3 && !formSubmitted}}"
            css: "animation: fadeIn 0.3s ease-in;"
            children::
              - ::
                type: "heading"
                content: "Step 3: Review & Submit"
                css: "font-size: 20px; font-weight: 600; color: #2d3748; margin: 0 0 24px 0;"

              - ::
                type: "text"
                content: "Please review your information before submitting."
                css: "font-size: 14px; color: #718096; margin: 0 0 24px 0;"

              # Preferences
              - ::
                type: "form-field-checkbox"
                label: "Subscribe to our newsletter"
                fieldName: "newsletter"
                formId: "contact-form"
                css: "margin-bottom: 16px;"

              - ::
                type: "form-field-checkbox"
                label: "I agree to the privacy policy"
                fieldName: "privacyAgree"
                required: true
                formId: "contact-form"
                css: "margin-bottom: 32px;"

              # Navigation buttons
              - ::
                type: "section-container"
                css: "display: flex; justify-content: space-between; gap: 12px;"
                children::
                  - ::
                    type: "nav-button"
                    content: "← Back"
                    action: "setState"
                    stateKey: "currentStep"
                    stateValue: 2
                    formId: "contact-form"
                    css: "padding: 12px 32px; background: #e2e8f0; color: #2d3748; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"

                  - ::
                    type: "nav-button"
                    content: "Submit ✓"
                    action: "setState"
                    stateKey: "formSubmitted"
                    stateValue: true
                    formId: "contact-form"
                    submit: true
                    css: "padding: 12px 32px; background: #48bb78; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(72, 187, 120, 0.4);"

          # SUCCESS MESSAGE
          - ::
            type: "section-container"
            visible: "{{formSubmitted}}"
            css: "text-align: center; animation: fadeIn 0.5s ease-in;"
            children::
              - ::
                type: "text"
                content: "✓"
                css: "font-size: 64px; color: #48bb78; margin: 0 0 16px 0; display: block;"

              - ::
                type: "heading"
                content: "Thank You!"
                css: "font-size: 28px; font-weight: 700; color: #1a202c; margin: 0 0 12px 0;"

              - ::
                type: "text"
                content: "Your message has been successfully submitted. We'll get back to you within 24 hours."
                css: "font-size: 16px; color: #718096; margin: 0 0 32px 0; line-height: 1.6;"

              - ::
                type: "nav-button"
                content: "Submit Another"
                action: "setState"
                stateUpdates::
                  currentStep: 1
                  formSubmitted: false
                css: "padding: 12px 32px; background: #667eea; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer; transition: all 0.2s;"
