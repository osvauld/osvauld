name: "CEL Functions Test"
version: "v1.0.0"

documents::
  publisherState::
    currentTimestamp::
      type: "number"
      initial: 0
    currentId::
      type: "string"
      initial: ""
    itemCount::
      type: "number"
      initial: 0

  publisherComputed::
    hasItems: "${ itemCount > 0 }"

ui::
  publisher::
    - ::
      type: "screen"
      id: "test"
      name: "test"
      isEntryPoint: true
      css: "padding: 2rem; max-width: 900px; margin: 0 auto; font-family: system-ui;"
      blocks::
        - ::
          type: "heading"
          level: 1
          content: "CEL Functions Test"
          css: "color: #2563eb; margin-bottom: 2rem;"
        - ::
          type: "section"
          css: "background: #f0f9ff; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 2px solid #0ea5e9;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "timestamp() Function"
              css: "margin: 0 0 1rem 0; color: #0c4a6e;"
            - ::
              type: "text"
              content: "Current Timestamp: {{timestamp()}}"
              css: "font-size: 1.1rem; color: #334155; margin-bottom: 0.5rem; font-family: monospace;"
            - ::
              type: "text"
              content: "Stored: {{currentTimestamp}}"
              css: "font-size: 1rem; color: #64748b; margin-bottom: 1rem; font-family: monospace;"
            - ::
              type: "button"
              content: "Capture Timestamp"
              action: "setState"
              stateUpdates::
                currentTimestamp: "${ timestamp() }"
              css: "padding: 0.75rem 1.5rem; background: #0ea5e9; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;"
        - ::
          type: "section"
          css: "background: #f0fdf4; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 2px solid #22c55e;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "generateId() Function"
              css: "margin: 0 0 1rem 0; color: #14532d;"
            - ::
              type: "text"
              content: "Generated ID: {{generateId()}}"
              css: "font-size: 1.1rem; color: #334155; margin-bottom: 0.5rem; font-family: monospace; word-break: break-all;"
            - ::
              type: "text"
              content: "Stored ID: {{currentId}}"
              css: "font-size: 1rem; color: #64748b; margin-bottom: 1rem; font-family: monospace; word-break: break-all;"
            - ::
              type: "button"
              content: "Generate New ID"
              action: "setState"
              stateUpdates::
                currentId: "${ generateId() }"
              css: "padding: 0.75rem 1.5rem; background: #22c55e; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;"
        - ::
          type: "section"
          css: "background: #fefce8; padding: 1.5rem; border-radius: 8px; border: 2px solid #eab308;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Combined Usage Test"
              css: "margin: 0 0 1rem 0; color: #713f12;"
            - ::
              type: "text"
              content: "Items added: {{itemCount}}"
              css: "font-size: 1rem; color: #78716c; margin-bottom: 1rem;"
            - ::
              type: "container"
              layout: "flex"
              direction: "row"
              gap: "1rem"
              css: "margin-bottom: 1.5rem;"
              blocks::
                - ::
                  type: "button"
                  content: "Add Item"
                  action: "setState"
                  stateUpdates::
                    itemCount: "${ itemCount + 1 }"
                  css: "padding: 0.75rem 1.5rem; background: #eab308; color: #713f12; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;"
                - ::
                  type: "button"
                  content: "Reset Count"
                  action: "setState"
                  stateUpdates::
                    itemCount: 0
                  css: "padding: 0.75rem 1.5rem; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;"
            - ::
              type: "text"
              content: "✅ {{itemCount}} item(s) added successfully!"
              when: "${ itemCount > 0 }"
              css: "padding: 1rem; background: #d1fae5; color: #065f46; border-radius: 6px; font-weight: 500;"
            - ::
              type: "text"
              content: "No items yet. Click Add Item to test!"
              when: "${ itemCount == 0 }"
              css: "padding: 1rem; background: #fee2e2; color: #991b1b; border-radius: 6px;"
        - ::
          type: "section"
          css: "background: #faf5ff; padding: 1.5rem; border-radius: 8px; border: 2px solid #a855f7;"
          blocks::
            - ::
              type: "heading"
              level: 2
              content: "Live Updates"
              css: "margin: 0 0 1rem 0; color: #581c87;"
            - ::
              type: "text"
              content: "These values update every render:"
              css: "color: #78716c; margin-bottom: 1rem;"
            - ::
              type: "container"
              layout: "flex"
              direction: "column"
              gap: "0.5rem"
              blocks::
                - ::
                  type: "text"
                  content: "🕐 Live Timestamp: {{timestamp()}}"
                  css: "font-family: monospace; color: #4c1d95; background: white; padding: 0.5rem; border-radius: 4px;"
                - ::
                  type: "text"
                  content: "🆔 New ID: {{generateId()}}"
                  css: "font-family: monospace; color: #4c1d95; background: white; padding: 0.5rem; border-radius: 4px; word-break: break-all;"
            - ::
              type: "text"
              content: "Note: These regenerate on each UI update"
              css: "font-size: 0.875rem; color: #a855f7; margin-top: 0.5rem; font-style: italic;"
