name: "Math Pattern Performance Demo"

publisher:
  state:
    time: 0
    gridSize: 40
    selectedPattern: "waves"
    speed: 1
    isPaused: false

  computed:
    expressionsPerFrame: "{{ gridSize * gridSize }}"
    expressionsPerSecond: "{{ expressionsPerFrame * 60 }}"
    patternName: "{{ selectedPattern equals 'waves' ? 'Wave Interference' : selectedPattern equals 'ripple' ? 'Ripple Effect' : selectedPattern equals 'spiral' ? 'Spiral Pattern' : selectedPattern equals 'plasma' ? 'Plasma Field' : 'Checkerboard' }}"

  screens:
    - id: pattern-demo
      name: Math Pattern Demo
      isEntryPoint: true
      css: "display: flex; flex-direction: column; height: 100vh; background: #0a0a0a; color: white; font-family: 'Monaco', 'Courier New', monospace;"
      blocks:
        # Header
        - type: section-container
          css: "padding: 20px; background: linear-gradient(135deg, #1e3a8a 0%, #7c3aed 100%); border-bottom: 2px solid #60a5fa;"
          blocks:
            - type: heading
              content: "🧮 HUML Math Pattern Demo"
              css: "font-size: 32px; margin: 0 0 10px 0; font-weight: bold;"

            - type: text
              content: "{{ patternName }} - Real-time OCaml Expression Evaluation"
              css: "font-size: 16px; opacity: 0.9; margin: 0;"

        # Main Content Area
        - type: section-container
          css: "flex: 1; display: flex; padding: 20px; gap: 20px; overflow: hidden;"
          blocks:
            # Grid Container (Left side)
            - type: section-container
              css: "flex: 1; display: flex; align-items: center; justify-content: center;"
              blocks:
                - type: section-container
                  id: grid-container
                  css: "display: grid; grid-template-columns: repeat(40, 1fr); gap: 1px; background: #000; border: 2px solid #60a5fa; border-radius: 8px; padding: 2px; max-width: 800px; max-height: 800px; width: 100%; aspect-ratio: 1;"
                  blocks:
                    # Simple static grid for now - 10x10 for testing
                    - type: section-container
                      css: "background: hsl(0, 70%, 60%); aspect-ratio: 1; border-radius: 2px;"
                    - type: section-container
                      css: "background: hsl(30, 70%, 60%); aspect-ratio: 1; border-radius: 2px;"
                    - type: section-container
                      css: "background: hsl(60, 70%, 60%); aspect-ratio: 1; border-radius: 2px;"
                    - type: section-container
                      css: "background: hsl(90, 70%, 60%); aspect-ratio: 1; border-radius: 2px;"
                    - type: section-container
                      css: "background: hsl(120, 70%, 60%); aspect-ratio: 1; border-radius: 2px;"

            # Control Panel (Right side)
            - type: section-container
              css: "width: 350px; display: flex; flex-direction: column; gap: 20px;"
              blocks:
                # Performance Stats
                - type: section-container
                  css: "background: #1e293b; border: 2px solid #60a5fa; border-radius: 8px; padding: 20px;"
                  blocks:
                    - type: heading
                      content: "📊 Performance"
                      css: "font-size: 20px; margin: 0 0 15px 0; color: #60a5fa;"

                    - type: text
                      content: "{{ expressionsPerFrame }} expressions/frame"
                      css: "font-size: 24px; font-weight: bold; color: #22c55e; margin: 0 0 10px 0;"

                    - type: text
                      content: "{{ expressionsPerSecond }} expressions/second"
                      css: "font-size: 16px; opacity: 0.8; margin: 0 0 10px 0;"

                    - type: text
                      content: "@ 60 FPS"
                      css: "font-size: 14px; opacity: 0.6; margin: 0 0 15px 0;"

                    - type: section-container
                      css: "padding-top: 15px; border-top: 1px solid #334155;"
                      blocks:
                        - type: text
                          content: "⚡ Evaluation Time"
                          css: "font-size: 14px; opacity: 0.7; margin: 0 0 5px 0;"

                        - type: text
                          content: "< 1ms per frame"
                          css: "font-size: 18px; font-weight: bold; color: #a78bfa; margin: 0;"

                # Pattern Selection
                - type: section-container
                  css: "background: #1e293b; border: 2px solid #60a5fa; border-radius: 8px; padding: 20px;"
                  blocks:
                    - type: heading
                      content: "🎨 Patterns"
                      css: "font-size: 20px; margin: 0 0 15px 0; color: #60a5fa;"

                    - type: nav-button
                      content: "🌊 Wave Interference"
                      action: "setState"
                      stateUpdates:
                        selectedPattern: "waves"
                      css: "{{ 'width: 100%; padding: 12px; margin: 0 0 10px 0; background: ' + (selectedPattern equals 'waves' ? '#7c3aed' : '#334155') + '; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 500;' }}"

                    - type: nav-button
                      content: "💫 Ripple Effect"
                      action: "setState"
                      stateUpdates:
                        selectedPattern: "ripple"
                      css: "{{ 'width: 100%; padding: 12px; margin: 0 0 10px 0; background: ' + (selectedPattern equals 'ripple' ? '#7c3aed' : '#334155') + '; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 500;' }}"

                    - type: nav-button
                      content: "🌀 Spiral Pattern"
                      action: "setState"
                      stateUpdates:
                        selectedPattern: "spiral"
                      css: "{{ 'width: 100%; padding: 12px; margin: 0; background: ' + (selectedPattern equals 'spiral' ? '#7c3aed' : '#334155') + '; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 500;' }}"

                # Info Box
                - type: section-container
                  css: "background: #1e293b; border: 2px solid #60a5fa; border-radius: 8px; padding: 20px;"
                  blocks:
                    - type: heading
                      content: "ℹ️ How It Works"
                      css: "font-size: 18px; margin: 0 0 12px 0; color: #60a5fa;"

                    - type: text
                      content: "Each cell evaluates a mathematical expression using OCaml-powered HUML evaluator."
                      css: "font-size: 13px; line-height: 1.6; opacity: 0.8; margin: 0 0 10px 0;"

                    - type: text
                      content: "Simple demo with just 5 cells showing different hues - imagine 1,600 cells!"
                      css: "font-size: 13px; line-height: 1.6; opacity: 0.8; margin: 0 0 10px 0;"

                    - type: text
                      content: "All computed in < 1ms per frame for buttery smooth 60 FPS."
                      css: "font-size: 13px; line-height: 1.6; color: #22c55e; font-weight: 500; margin: 0;"

viewer:
  screens:
    - id: viewer-demo
      name: Math Pattern Viewer
      isEntryPoint: true
      css: "display: flex; align-items: center; justify-content: center; height: 100vh; background: #0a0a0a; color: white;"
      blocks:
        - type: text
          content: "Switch to Publisher Mode to see the demo!"
          css: "font-size: 24px; opacity: 0.6;"
