name: "Math Pattern Demo"

publisher::
  state::
    time: 0
    gridSize: 100
    selectedPattern: "waves"
    fps: 0
    wavesExpr: "(sin(x * 0.2 + time) + sin(y * 0.2 + time)) / 2"
    rippleExpr: "sin(sqrt((x - gridSize/2) * (x - gridSize/2) + (y - gridSize/2) * (y - gridSize/2)) * 0.3 - time)"
    spiralExpr: "sin(atan2(y - gridSize/2, x - gridSize/2) * 3 + sqrt((x - gridSize/2) * (x - gridSize/2) + (y - gridSize/2) * (y - gridSize/2)) * 0.2 - time)"

  computed::
    totalCells: "{{ gridSize * gridSize }}"
    expressionsPerSecond: "{{ totalCells * fps }}"

  screens::
    - ::
      id: "demo"
      name: "Pattern Demo"
      isEntryPoint: true
      css: "display: flex; flex-direction: column; height: 100vh; background: #0a0a0a; color: white; padding: 20px; font-family: monospace;"
      blocks::
        - ::
          type: "heading"
          content: "Math Pattern Demo"
          css: "font-size: 32px; margin: 0 0 20px 0; color: #60a5fa;"

        - ::
          type: "text"
          content: "{{ fps }} FPS"
          css: "font-size: 72px; color: #f59e0b; margin: 0 0 10px 0; font-weight: bold; text-shadow: 0 0 20px rgba(245, 158, 11, 0.5);"

        - ::
          type: "text"
          content: "{{ totalCells }} cells/frame"
          css: "font-size: 28px; color: #22c55e; margin: 0 0 8px 0; font-weight: 600;"

        - ::
          type: "text"
          content: "{{ expressionsPerSecond }} expr/sec"
          css: "font-size: 24px; opacity: 0.9; margin: 0 0 20px 0; color: #a78bfa; font-weight: 600;"

        - ::
          type: "text"
          content: "Selected pattern:"
          css: "font-size: 16px; margin: 0 0 10px 0;"

        - ::
          type: "text"
          content: "{{ selectedPattern }}"
          css: "font-size: 20px; color: #a78bfa; margin: 0 0 30px 0;"

        - ::
          type: "section-container"
          css: "display: flex; gap: 10px; margin-bottom: 30px;"
          blocks::
            - ::
              type: "nav-button"
              content: "Waves"
              action: "setState"
              stateUpdates::
                selectedPattern: "waves"
              css: "padding: 12px 24px; background: #7c3aed; color: white; border: none; border-radius: 6px;"

            - ::
              type: "nav-button"
              content: "Ripple"
              action: "setState"
              stateUpdates::
                selectedPattern: "ripple"
              css: "padding: 12px 24px; background: #7c3aed; color: white; border: none; border-radius: 6px;"

            - ::
              type: "nav-button"
              content: "Spiral"
              action: "setState"
              stateUpdates::
                selectedPattern: "spiral"
              css: "padding: 12px 24px; background: #7c3aed; color: white; border: none; border-radius: 6px;"

        - ::
          type: "section-container"
          css: "padding: 20px; background: #1e293b; border-radius: 8px;"
          blocks::
            - ::
              type: "text"
              content: "Live Pattern Visualization"
              css: "font-size: 20px; margin: 0 0 10px 0; color: #60a5fa;"

            - ::
              type: "canvas-pattern"
              css: "border-radius: 4px; margin: 10px 0;"

            - ::
              type: "text"
              content: "This demo shows the OCaml-powered HUML evaluator computing expressions in real-time."
              css: "font-size: 14px; line-height: 1.6; opacity: 0.8; margin: 10px 0 10px 0;"

            - ::
              type: "text"
              content: "All computed in under 1ms per frame using WebAssembly!"
              css: "font-size: 14px; line-height: 1.6; color: #22c55e; margin: 0;"

viewer::
  screens::
    - ::
      id: "viewer"
      name: "Viewer"
      isEntryPoint: true
      css: "display: flex; align-items: center; justify-content: center; height: 100vh; background: #0a0a0a; color: white;"
      blocks::
        - ::
          type: "text"
          content: "Switch to Publisher Mode"
          css: "font-size: 24px; opacity: 0.6;"
