name: "Computed State Test"

state::
  firstName: "John"
  lastName: "Doe"
  items::
    - ::
      name: "Product A"
      price: 10
      quantity: 2
    - ::
      name: "Product B"
      price: 20
      quantity: 1
    - ::
      name: "Product C"
      price: 15
      quantity: 3

computed::
  fullName: "{{firstName + ' ' + lastName}}"
  itemCount: "{{items | length}}"
  totalItems: "{{sum(items, 'quantity')}}"
  totalPrice: "{{items[0].price * items[0].quantity + items[1].price * items[1].quantity + items[2].price * items[2].quantity}}"
  formattedTotal: "{{totalPrice | toFixed(2)}}"
  hasManyItems: "{{totalItems > 5}}"

screens::
  - ::
    id: "main"
    name: "Main Screen"
    isEntryPoint: true
    blocks::
      - ::
        type: "section-container"
        css: "padding: 2rem; max-width: 800px; margin: 0 auto; font-family: sans-serif;"
        blocks::
          - ::
            type: "heading"
            content: "Computed State Demo"
            css: "color: #333; margin-bottom: 2rem;"

          # Show user info
          - ::
            type: "section-container"
            css: "background: #f5f5f5; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"
            blocks::
              - ::
                type: "text"
                content: "User: {{fullName}}"
                css: "font-size: 1.2rem; font-weight: bold;"

          # Input fields to change state
          - ::
            type: "section-container"
            css: "margin-bottom: 2rem;"
            blocks::
              - ::
                type: "text"
                content: "Change Name:"
                css: "font-weight: bold; margin-bottom: 0.5rem;"
              - ::
                type: "form-field-text"
                name: "firstName"
                label: "First Name"
                defaultValue: "{{firstName}}"
              - ::
                type: "form-field-text"
                name: "lastName"
                label: "Last Name"
                defaultValue: "{{lastName}}"

          # Shopping cart summary
          - ::
            type: "section-container"
            css: "background: #fff; border: 2px solid #007bff; padding: 1.5rem; border-radius: 8px;"
            blocks::
              - ::
                type: "text"
                content: "Shopping Cart Summary"
                css: "font-size: 1.5rem; font-weight: bold; color: #007bff; margin-bottom: 1rem;"

              - ::
                type: "text"
                content: "Total Products: {{itemCount}}"
                css: "font-size: 1.1rem; margin-bottom: 0.5rem;"

              - ::
                type: "text"
                content: "Total Quantity: {{totalItems}}"
                css: "font-size: 1.1rem; margin-bottom: 0.5rem;"

              - ::
                type: "text"
                content: "Total Price: ${{formattedTotal}}"
                css: "font-size: 1.5rem; font-weight: bold; color: #28a745; margin-top: 1rem;"

              - ::
                type: "text"
                content: "⚠️ Large order!"
                visible: "{{hasManyItems}}"
                css: "background: #fff3cd; color: #856404; padding: 0.5rem; border-radius: 4px; margin-top: 1rem;"

          # Item list
          - ::
            type: "section-container"
            css: "margin-top: 2rem;"
            blocks::
              - ::
                type: "text"
                content: "Cart Items"
                css: "font-weight: bold; font-size: 1.2rem; margin-bottom: 1rem;"

              - ::
                type: "section-container"
                forEach: "items"
                forEachAs: "item"
                css: "background: #f8f9fa; padding: 1rem; margin-bottom: 0.5rem; border-radius: 4px; display: flex; justify-content: space-between;"
                blocks::
                  - ::
                    type: "text"
                    content: "{{item.name}}"
                    css: "font-weight: 500;"
                  - ::
                    type: "text"
                    content: "{{item.quantity + ' × $' + item.price + ' = $' + (item.price * item.quantity)}}"
                    css: "color: #666;"
