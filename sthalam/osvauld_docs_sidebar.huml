                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%;"
              - ::
                type: "section-container"
                name: "Livnote Nav"
                css: "margin-bottom: 25px;"
                children::
                  - ::
                    type: "text"
                    content: "Livnote"
                    css: "color: #a0a0b0; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;"
                  - ::
                    type: "nav-button"
                    content: "Creating your identity"
                    targetContainerId: "livnote-identity"
                    css: "background: transparent; color: #d0d0d8; padding: 8px 15px; margin: 4px 0; border: none; border-radius: 6px; font-size: 14px; text-align: left; width: 100%;"
                  - ::
                    type: "nav-button"
