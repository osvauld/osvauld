  - ::
    id: "confirmation"
    name: "Registration Confirmation"
    css: "background: linear-gradient(135deg, #1e1e2e 0%, #2d3561 100%); padding: 40px 20px; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;"
    children::
      - ::
        type: "heading"
        content: "✅ Registration Successful!"
        css: "color: #00ff88; font-size: 48px; font-weight: 800; text-align: center; margin-bottom: 20px;"

      - ::
        type: "section-container"
        name: "Confirmation Details"
        css: "max-width: 700px; background: #2d3561; padding: 40px; border-radius: 12px; border: 2px solid #00ff88; text-align: center;"
        children::
          - ::
            type: "text"
            content: "Thank you for registering for Tech Innovation Summit 2025!"
            css: "color: white; font-size: 22px; font-weight: 600; margin-bottom: 20px;"

          - ::
            type: "text"
            content: "Your registration has been successfully submitted. You will receive a confirmation email shortly with all the event details."
            css: "color: rgba(255,255,255,0.8); font-size: 16px; line-height: 1.6; margin-bottom: 30px;"

          - ::
            type: "section-container"
            name: "Event Info Box"
            css: "background: #1e1e2e; padding: 25px; border-radius: 10px; margin-bottom: 30px; border: 1px solid #3d4571;"
            children::
