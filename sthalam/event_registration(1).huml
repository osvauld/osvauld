            placeholder: "Any other booth setup requirements or special requests"
            required: false
            css: "margin-bottom: 30px;"

          - ::
            type: "section-container"
            name: "Booth Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between;"
            children::
