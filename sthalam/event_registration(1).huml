name: "Tech Innovation Summit 2025 - Event Registration"

screens::
  - ::
    id: "welcome"
    name: "Welcome Screen"
    isEntryPoint: true
    css: "background: linear-gradient(135deg, #1e1e2e 0%, #2d3561 100%); padding: 40px 20px; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;"
    children::
      - ::
        type: "heading"
        content: "🎉 Tech Innovation Summit 2025"
        css: "color: white; font-size: 48px; font-weight: 800; text-align: center; margin-bottom: 20px;"

      - ::
        type: "text"
        content: "Join us for three days of innovation, networking, and learning"
        css: "color: rgba(255,255,255,0.8); font-size: 20px; text-align: center; margin-bottom: 50px; max-width: 600px;"

      - ::
        type: "text"
        content: "Select Your Registration Type"
        css: "color: white; font-size: 24px; font-weight: 600; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Registration Type Buttons"
        css: "display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 500px;"
        children::
          - ::
            type: "nav-button"
            content: "🎤 Speaker Registration"
            targetContainerId: "speaker-info"
            css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border: none; border-radius: 12px; font-size: 18px; font-weight: 600; cursor: pointer;"

          - ::
            type: "nav-button"
            content: "👥 Attendee Registration"
            targetContainerId: "attendee-info"
            css: "background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 20px; border: none; border-radius: 12px; font-size: 18px; font-weight: 600; cursor: pointer;"

          - ::
            type: "nav-button"
            content: "💼 Sponsor Registration"
            targetContainerId: "sponsor-info"
            css: "background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 20px; border: none; border-radius: 12px; font-size: 18px; font-weight: 600; cursor: pointer;"

  - ::
    id: "speaker-info"
    name: "Speaker Information"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        id: "form-speaker"
        type: "form"
        name: "Speaker Registration Form"
        eventName: "speaker_registration"

      - ::
        type: "heading"
        content: "🎤 Speaker Registration"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Share your expertise with our community"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Speaker Form Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "form-field-text"
            formId: "form-speaker"
            fieldName: "full_name"
            label: "Full Name"
            placeholder: "Enter your full name"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-email"
            formId: "form-speaker"
            fieldName: "email"
            label: "Email Address"
            placeholder: "your.email@example.com"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-speaker"
            fieldName: "phone"
            label: "Phone Number"
            placeholder: "+1 (555) 000-0000"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-speaker"
            fieldName: "talk_title"
            label: "Talk Title"
            placeholder: "What will you be speaking about?"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-textarea"
            formId: "form-speaker"
            fieldName: "speaker_bio"
            label: "Speaker Bio"
            placeholder: "Tell us about yourself and your expertise (max 500 characters)"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "section-container"
            name: "Speaker Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between; margin-top: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "welcome"
                css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;"

              - ::
                type: "nav-button"
                content: "Continue →"
                formId: "form-speaker"
                action: "continue"
                targetContainerId: "speaker-details"
                css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  - ::
    id: "speaker-details"
    name: "Speaker Details"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "🎤 Additional Speaker Details"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Help us prepare for your session"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Speaker Details Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "text"
            content: "Topic Area"
            css: "color: white; font-size: 16px; font-weight: 600; margin-bottom: 15px;"

          - ::
            type: "section-container"
            name: "Topic Area Buttons"
            css: "display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "Artificial Intelligence & Machine Learning"
                formId: "form-speaker"
                fieldName: "topic_area"
                value: "ai_ml"
                targetContainerId: "speaker-av"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px 20px; border: none; border-radius: 8px; font-size: 15px; text-align: left;"

              - ::
                type: "nav-button"
                content: "Web Development & Frontend"
                formId: "form-speaker"
                fieldName: "topic_area"
                value: "web_dev"
                targetContainerId: "speaker-av"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px 20px; border: none; border-radius: 8px; font-size: 15px; text-align: left;"

              - ::
                type: "nav-button"
                content: "Cloud Computing & DevOps"
                formId: "form-speaker"
                fieldName: "topic_area"
                value: "cloud_devops"
                targetContainerId: "speaker-av"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px 20px; border: none; border-radius: 8px; font-size: 15px; text-align: left;"

              - ::
                type: "nav-button"
                content: "Cybersecurity"
                formId: "form-speaker"
                fieldName: "topic_area"
                value: "cybersecurity"
                targetContainerId: "speaker-av"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px 20px; border: none; border-radius: 8px; font-size: 15px; text-align: left;"

              - ::
                type: "nav-button"
                content: "Data Science & Analytics"
                formId: "form-speaker"
                fieldName: "topic_area"
                value: "data_science"
                targetContainerId: "speaker-av"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px 20px; border: none; border-radius: 8px; font-size: 15px; text-align: left;"

          - ::
            type: "nav-button"
            content: "← Back"
            targetContainerId: "speaker-info"
            css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; width: 100%;"

  - ::
    id: "speaker-av"
    name: "Speaker AV Requirements"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "🎤 AV Requirements"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "What equipment will you need?"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "AV Requirements Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "form-field-textarea"
            formId: "form-speaker"
            fieldName: "av_requirements"
            label: "AV Requirements"
            placeholder: "List any audio/visual equipment you'll need (projector, microphone, laptop connection, etc.)"
            required: false
            css: "margin-bottom: 30px;"

          - ::
            type: "section-container"
            name: "AV Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between;"
            children::
              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "speaker-details"
                css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;"

              - ::
                type: "nav-button"
                content: "Submit Registration →"
                formId: "form-speaker"
                targetContainerId: "confirmation"
                css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  - ::
    id: "attendee-info"
    name: "Attendee Information"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        id: "form-attendee"
        type: "form"
        name: "Attendee Registration Form"
        eventName: "attendee_registration"

      - ::
        type: "heading"
        content: "👥 Attendee Registration"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Join us for an amazing learning experience"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Attendee Form Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "form-field-text"
            formId: "form-attendee"
            fieldName: "full_name"
            label: "Full Name"
            placeholder: "Enter your full name"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-email"
            formId: "form-attendee"
            fieldName: "email"
            label: "Email Address"
            placeholder: "your.email@example.com"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-attendee"
            fieldName: "phone"
            label: "Phone Number"
            placeholder: "+1 (555) 000-0000"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-attendee"
            fieldName: "company"
            label: "Company/Organization"
            placeholder: "Your company name"
            required: false
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-attendee"
            fieldName: "job_title"
            label: "Job Title"
            placeholder: "Your current role"
            required: false
            css: "margin-bottom: 20px;"

          - ::
            type: "section-container"
            name: "Attendee Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between; margin-top: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "welcome"
                css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;"

              - ::
                type: "nav-button"
                content: "Continue →"
                formId: "form-attendee"
                action: "continue"
                targetContainerId: "attendee-preferences"
                css: "background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  - ::
    id: "attendee-preferences"
    name: "Attendee Preferences"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "👥 Your Preferences"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Help us personalize your experience"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Preferences Form Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "text"
            content: "T-Shirt Size"
            css: "color: white; font-size: 16px; font-weight: 600; margin-bottom: 15px;"

          - ::
            type: "section-container"
            name: "T-Shirt Size Buttons"
            css: "display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "S"
                formId: "form-attendee"
                fieldName: "tshirt_size"
                value: "S"
                targetContainerId: "attendee-workshops"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px; border: none; border-radius: 8px; font-size: 15px;"

              - ::
                type: "nav-button"
                content: "M"
                formId: "form-attendee"
                fieldName: "tshirt_size"
                value: "M"
                targetContainerId: "attendee-workshops"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px; border: none; border-radius: 8px; font-size: 15px;"

              - ::
                type: "nav-button"
                content: "L"
                formId: "form-attendee"
                fieldName: "tshirt_size"
                value: "L"
                targetContainerId: "attendee-workshops"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px; border: none; border-radius: 8px; font-size: 15px;"

              - ::
                type: "nav-button"
                content: "XL"
                formId: "form-attendee"
                fieldName: "tshirt_size"
                value: "XL"
                targetContainerId: "attendee-workshops"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px; border: none; border-radius: 8px; font-size: 15px;"

              - ::
                type: "nav-button"
                content: "2XL"
                formId: "form-attendee"
                fieldName: "tshirt_size"
                value: "2XL"
                targetContainerId: "attendee-workshops"
                action: "setValueOnly"
                css: "background: #3d4571; color: white; padding: 12px; border: none; border-radius: 8px; font-size: 15px;"

          - ::
            type: "nav-button"
            content: "← Back"
            targetContainerId: "attendee-info"
            css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; width: 100%;"

  - ::
    id: "attendee-workshops"
    name: "Attendee Workshop Selection"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "👥 Workshop Preferences"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Select workshops you'd like to attend"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Workshop Form Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "form-field-checkbox"
            formId: "form-attendee"
            fieldName: "workshop_ai"
            label: "AI & Machine Learning Workshop"
            css: "margin-bottom: 15px;"

          - ::
            type: "form-field-checkbox"
            formId: "form-attendee"
            fieldName: "workshop_cloud"
            label: "Cloud Architecture Workshop"
            css: "margin-bottom: 15px;"

          - ::
            type: "form-field-checkbox"
            formId: "form-attendee"
            fieldName: "workshop_security"
            label: "Cybersecurity Essentials"
            css: "margin-bottom: 15px;"

          - ::
            type: "form-field-checkbox"
            formId: "form-attendee"
            fieldName: "workshop_mobile"
            label: "Mobile App Development"
            css: "margin-bottom: 30px;"

          - ::
            type: "form-field-textarea"
            formId: "form-attendee"
            fieldName: "dietary_restrictions"
            label: "Dietary Restrictions"
            placeholder: "Please list any dietary restrictions or allergies"
            required: false
            css: "margin-bottom: 30px;"

          - ::
            type: "section-container"
            name: "Workshop Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between;"
            children::
              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "attendee-preferences"
                css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;"

              - ::
                type: "nav-button"
                content: "Submit Registration →"
                formId: "form-attendee"
                targetContainerId: "confirmation"
                css: "background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  - ::
    id: "sponsor-info"
    name: "Sponsor Information"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        id: "form-sponsor"
        type: "form"
        name: "Sponsor Registration Form"
        eventName: "sponsor_registration"

      - ::
        type: "heading"
        content: "💼 Sponsor Registration"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Partner with us to reach innovators and decision-makers"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Sponsor Form Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "form-field-text"
            formId: "form-sponsor"
            fieldName: "contact_name"
            label: "Contact Person Name"
            placeholder: "Primary contact name"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-email"
            formId: "form-sponsor"
            fieldName: "email"
            label: "Contact Email"
            placeholder: "contact@company.com"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-sponsor"
            fieldName: "phone"
            label: "Contact Phone"
            placeholder: "+1 (555) 000-0000"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-sponsor"
            fieldName: "company_name"
            label: "Company Name"
            placeholder: "Your company name"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "form-field-text"
            formId: "form-sponsor"
            fieldName: "company_website"
            label: "Company Website"
            placeholder: "https://www.company.com"
            required: true
            css: "margin-bottom: 20px;"

          - ::
            type: "section-container"
            name: "Sponsor Form Buttons"
            css: "display: flex; gap: 15px; justify-content: space-between; margin-top: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "← Back"
                targetContainerId: "welcome"
                css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;"

              - ::
                type: "nav-button"
                content: "Continue →"
                formId: "form-sponsor"
                action: "continue"
                targetContainerId: "sponsor-tier"
                css: "background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;"

  - ::
    id: "sponsor-tier"
    name: "Sponsor Tier Selection"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "💼 Choose Your Sponsorship Level"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Select the package that best fits your goals"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Sponsor Tier Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "section-container"
            name: "Tier Buttons"
            css: "display: flex; flex-direction: column; gap: 15px; margin-bottom: 30px;"
            children::
              - ::
                type: "nav-button"
                content: "💎 Platinum Sponsor - $50,000"
                formId: "form-sponsor"
                fieldName: "sponsorship_tier"
                value: "platinum"
                targetContainerId: "sponsor-booth"
                action: "setValueOnly"
                css: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border: none; border-radius: 10px; font-size: 17px; font-weight: 600; text-align: left;"

              - ::
                type: "nav-button"
                content: "🥇 Gold Sponsor - $25,000"
                formId: "form-sponsor"
                fieldName: "sponsorship_tier"
                value: "gold"
                targetContainerId: "sponsor-booth"
                action: "setValueOnly"
                css: "background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); color: #1e1e2e; padding: 20px; border: none; border-radius: 10px; font-size: 17px; font-weight: 600; text-align: left;"

              - ::
                type: "nav-button"
                content: "🥈 Silver Sponsor - $10,000"
                formId: "form-sponsor"
                fieldName: "sponsorship_tier"
                value: "silver"
                targetContainerId: "sponsor-booth"
                action: "setValueOnly"
                css: "background: linear-gradient(135deg, #a8caba 0%, #5d4e6d 100%); color: white; padding: 20px; border: none; border-radius: 10px; font-size: 17px; font-weight: 600; text-align: left;"

              - ::
                type: "nav-button"
                content: "🥉 Bronze Sponsor - $5,000"
                formId: "form-sponsor"
                fieldName: "sponsorship_tier"
                value: "bronze"
                targetContainerId: "sponsor-booth"
                action: "setValueOnly"
                css: "background: linear-gradient(135deg, #cd7672 0%, #cc5333 100%); color: white; padding: 20px; border: none; border-radius: 10px; font-size: 17px; font-weight: 600; text-align: left;"

          - ::
            type: "nav-button"
            content: "← Back"
            targetContainerId: "sponsor-info"
            css: "background: #3d4571; color: white; padding: 15px 30px; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; width: 100%;"

  - ::
    id: "sponsor-booth"
    name: "Sponsor Booth Requirements"
    css: "background: #1e1e2e; padding: 40px 20px; min-height: 100vh;"
    children::
      - ::
        type: "heading"
        content: "💼 Booth Setup Requirements"
        css: "color: white; font-size: 36px; font-weight: 700; text-align: center; margin-bottom: 10px;"

      - ::
        type: "text"
        content: "Let us know what you'll need for your booth"
        css: "color: rgba(255,255,255,0.7); font-size: 18px; text-align: center; margin-bottom: 40px;"

      - ::
        type: "section-container"
        name: "Booth Requirements Container"
        css: "max-width: 600px; margin: 0 auto; background: #2d3561; padding: 30px; border-radius: 12px; border: 1px solid #3d4571;"
        children::
          - ::
            type: "text"
            content: "Booth Requirements (Select all that apply)"
            css: "color: white; font-size: 16px; font-weight: 600; margin-bottom: 20px;"

          - ::
            type: "form-field-checkbox"
