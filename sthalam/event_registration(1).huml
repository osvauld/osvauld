                type: "text"
                content: "📅 Event Dates: March 15-17, 2025"
                css: "color: white; font-size: 16px; margin-bottom: 10px;"

              - ::
                type: "text"
                content: "📍 Location: San Francisco Convention Center"
                css: "color: white; font-size: 16px; margin-bottom: 10px;"

              - ::
                type: "text"
                content: "🕐 Check-in: 8:00 AM on Day 1"
                css: "color: white; font-size: 16px;"

          - ::
            type: "text"
            content: "What's Next?"
            css: "color: white; font-size: 22px; font-weight: 600; margin-bottom: 20px; margin-top: 20px;"

          - ::
            type: "text"
            content: "• Check your email for confirmation and payment instructions\n• Download the event app (link in confirmation email)\n• Review the schedule and plan your sessions\n• Book your accommodation early"
            css: "color: rgba(255,255,255,0.8); font-size: 15px; line-height: 1.8; text-align: left; white-space: pre-line; margin-bottom: 30px;"

      - ::
        type: "section-container"
        name: "Confirmation Actions"
        css: "display: flex; gap: 20px; margin-top: 40px; flex-wrap: wrap; justify-content: center;"
        children::
