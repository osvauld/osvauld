#!/usr/bin/env python3
"""AI Interface command sender - sends JSON commands via Unix socket"""

import socket
import sys
import json

def send_command(session: str, command: str) -> str:
    socket_path = f"/tmp/sthalam/{session}/ai.sock"

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(socket_path)
        sock.sendall((command + "\n").encode())

        # Read response
        response = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response += chunk
            if b"\n" in chunk:
                break

        return response.decode().strip()
    finally:
        sock.close()

def main():
    if len(sys.argv) < 3:
        print("Usage: ai <session_name> <json_command>")
        print("")
        print("Examples:")
        print('  ai ecom \'{"action":"status"}\'')
        print('  ai ecom \'{"target":"shop_owner","action":"login","params":{"passphrase":"test123"}}\'')
        print('  ai ecom \'{"target":"shop_owner","action":"list_spaces"}\'')
        print('  ai ecom \'{"target":"all","action":"ping"}\'')
        sys.exit(1)

    session = sys.argv[1]
    command = sys.argv[2]

    try:
        result = send_command(session, command)
        # Pretty print if it's JSON
        try:
            parsed = json.loads(result)
            print(json.dumps(parsed, indent=2))
        except:
            print(result)
    except FileNotFoundError:
        print(f"Error: Socket not found: /tmp/sthalam/{session}/ai.sock")
        print(f"Is ai_interface running? Start with:")
        print(f"  ./target/debug/ai_interface --name {session} --instances owner,customer --show-ui")
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
