// Node management screen

import { Theme } from "../theme.slint";
import { NodeInfo } from "../types.slint";
import { NodeCard } from "../components/cards.slint";
import { AddNodeModal } from "../components/modals.slint";

// Node management screen
export component NodeManagementScreen {
    in property<[NodeInfo]> nodes: [];
    in-out property<bool> show-add-modal: false;
    in-out property<string> connection-string: "";
    in property<bool> connecting: false;
    in-out property<string> error-message: "";

    callback request-nodes();
    callback add-node(string);
    callback delete-node(string);
    callback connect-node(string);
    callback go-back();

    // Responsive: 1 column on mobile, 3 on desktop
    property<int> node-columns: Theme.is-mobile ? 1 : (Theme.is-tablet ? 2 : 3);
    property<length> node-card-width: Theme.is-mobile ? (root.width - Theme.page-padding-h * 2 - 16px) : 200px;

    // Initialize
    init => {
        request-nodes();
    }

    VerticalLayout {
        padding-top: Theme.is-mobile ? 12px : 24px;
        padding-left: Theme.page-padding-h;
        padding-right: Theme.page-padding-h;
        padding-bottom: 24px;
        spacing: Theme.is-mobile ? 16px : 24px;

        // Header - stacks vertically on mobile
        VerticalLayout {
            spacing: Theme.is-mobile ? 8px : 0px;

            HorizontalLayout {
                spacing: Theme.is-mobile ? 8px : 16px;
                alignment: space-between;

                // Back button + title
                HorizontalLayout {
                    spacing: Theme.is-mobile ? 8px : 12px;

                    Rectangle {
                        width: Theme.touch-target-min;
                        height: Theme.touch-target-min;
                        border-radius: 6px;
                        background: back-area.has-hover ? Theme.side-list-highlight : transparent;

                        Text {
                            text: "\u{2190}";
                            color: Theme.quarzo-white;
                            font-size: Theme.is-mobile ? 18px : 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        back-area := TouchArea {
                            clicked => { go-back(); }
                        }
                    }

                    Text {
                        text: Theme.is-mobile ? "Nodes" : "Sovereign Nodes";
                        color: Theme.quarzo-white;
                        font-size: Theme.font-h2;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // Desktop: Add Node button in header
                if !Theme.is-mobile: Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: 6px;
                    background: add-area.has-hover ? Theme.active-border : Theme.grape-green;

                    Text {
                        text: "+ Add Node";
                        color: Theme.quarzo-white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    add-area := TouchArea {
                        accessible-role: button;
                        accessible-label: "add-node-button";
                        clicked => {
                            show-add-modal = true;
                            connection-string = "";
                            error-message = "";
                        }
                    }
                }
            }

            // Mobile: Add Node button as full-width row
            if Theme.is-mobile: Rectangle {
                height: Theme.touch-target-min;
                border-radius: 6px;
                background: add-area-m.has-hover ? Theme.active-border : Theme.grape-green;

                Text {
                    text: "+ Add Node";
                    color: Theme.quarzo-white;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                add-area-m := TouchArea {
                    accessible-role: button;
                    accessible-label: "add-node-button";
                    clicked => {
                        show-add-modal = true;
                        connection-string = "";
                        error-message = "";
                    }
                }
            }
        }

        // Node list or empty state
        if nodes.length > 0: Flickable {
            VerticalLayout {
                spacing: 16px;

                // Grid of nodes (dynamic columns)
                for row-idx in Math.ceil(nodes.length / node-columns): HorizontalLayout {
                    spacing: 16px;

                    for col-idx in node-columns: Rectangle {
                        width: node-card-width;
                        height: Theme.is-mobile ? 120px : 140px;

                        property <int> node-idx: row-idx * node-columns + col-idx;

                        if node-idx < nodes.length: NodeCard {
                            node-id: nodes[node-idx].id;
                            name: nodes[node-idx].name;
                            is-connected: nodes[node-idx].is-connected;
                            last-connected: nodes[node-idx].last-connected;
                            connection-type: nodes[node-idx].connection-type;

                            clicked => {
                                if !nodes[node-idx].is-connected {
                                    connect-node(nodes[node-idx].id);
                                }
                            }
                            delete-clicked => { delete-node(nodes[node-idx].id); }
                        }
                    }
                }
            }
        }

        // Empty state
        if nodes.length == 0: VerticalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "No sovereign nodes yet";
                color: Theme.text-passive;
                font-size: 18px;
                horizontal-alignment: center;
            }

            Text {
                text: "Add your first node to start publishing content";
                color: Theme.text-passive;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
    }

    // Add Node Modal
    AddNodeModal {
        show: show-add-modal;
        connection-string <=> connection-string;
        connecting: connecting;
        error-message: error-message;

        add(conn-str) => {
            add-node(conn-str);
        }
        cancel => {
            show-add-modal = false;
            connection-string = "";
            error-message = "";
        }
    }
}
