// Osvauld Color Palette
// Extracted from original sthalam frontend CSS

export global Theme {
    // Core backgrounds
    out property<color> ninja-black: #010409;        // Main background
    out property<color> frame-black: #0d0e13;        // Frame/panel background
    out property<color> card-shade: #111218;         // Card background
    out property<color> field-active: #16171f;       // Active field background
    out property<color> add-field-grey: #12161c;     // Secondary field
    out property<color> modal-field-active: #20212b; // Modal fields

    // Borders
    out property<color> default-border: #2f303e;     // Default borders
    out property<color> active-border: #4d4f60;      // Active/hover borders
    out property<color> border-green: #161b22;       // Subtle borders
    out property<color> card-border: #373946;        // Card borders
    out property<color> dark-separator: #21262d;     // Line separators

    // Text colors
    out property<color> quarzo-white: #c9d1d9;       // Primary text
    out property<color> text-active: #a3a4b5;        // Active text
    out property<color> text-passive: #6e7681;       // Muted text (sheffield-grey)
    out property<color> field-text: #85889c;         // Field text
    out property<color> field-text-active: #bfc0cc;  // Active field text
    out property<color> side-list-active: #f2f2f0;   // Highlighted list item
    out property<color> highlight-white: #e8eff6;    // Emphasis text

    // Accent colors
    out property<color> carolina-blue: #89b4fa;      // Primary accent
    out property<color> active-lavender: #b4befe;    // Active states
    out property<color> spritzig-blue: #74c7ec;      // Links/highlights
    out property<color> lilac-pink: #cba6f7;         // Secondary accent
    out property<color> grape-green: #a6e3a1;        // Success
    out property<color> danger-red: #ff6a6a;         // Error/danger
    out property<color> livnote-lavender: #8a86e5;   // Primary button (signup/submit)

    // Role colors
    out property<color> owner-green: #2c3b33;        // Owner badge bg
    out property<color> owner-text: #a6e3a1;         // Owner badge text
    out property<color> manager-purple: #3b3441;     // Manager badge bg
    out property<color> manager-text: #f5c2e7;       // Manager badge text
    out property<color> reader-orange: #3c3b35;      // Reader badge bg
    out property<color> reader-text: #f9e2af;        // Reader badge text

    // Misc
    out property<color> side-list-highlight: #292a36; // List item hover
    out property<color> cancel-background: #21222c;   // Cancel button bg
    out property<color> faded-cancel: #67697c;        // Faded text
    out property<color> signup-gray: #2C2E34;         // Disabled button
}
