// Page card component (shows a page containing apps)
export component PageCard {
    in property<string> page-id;
    in property<string> name;
    in property<int> app-count;
    callback clicked();

    width: 160px;
    height: 100px;

    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: area.has-hover ? Theme.active-border : Theme.default-border;
        background: area.has-hover ? Theme.side-list-highlight : Theme.frame-black;

        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            alignment: center;

            // Page icon (document/folder)
            Text {
                text: "\u{1F4C4}";  // 📄 page icon
                font-size: 28px;
                horizontal-alignment: center;
            }

            // Page name
            Text {
                text: name;
                color: Theme.quarzo-white;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
                horizontal-alignment: center;
            }

            // App count
            Text {
                text: app-count == 1 ? "1 app" : app-count + " apps";
                color: Theme.text-passive;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }

        area := TouchArea {
            clicked => { clicked(); }
        }

        animate border-color { duration: 150ms; }
        animate background { duration: 150ms; }
    }
}

