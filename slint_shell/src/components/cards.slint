// Node card component
export component NodeCard {
    in property<string> node-id;
    in property<string> name;
    in property<bool> is-connected;
    in property<string> last-connected;
    in property<string> connection-type;

    callback clicked();
    callback delete-clicked();

    width: 200px;
    height: 140px;

    Rectangle {
        background: card-area.has-hover ? Theme.side-list-highlight : Theme.frame-black;
        border-radius: 8px;
        border-width: 1px;
        border-color: is-connected ? Theme.grape-green : Theme.default-border;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            // Delete button (top right)
            Rectangle {
                height: 20px;
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: delete-area.has-hover ? Theme.cancel-background : transparent;

                        Text {
                            text: "\u{00D7}";
                            color: delete-area.has-hover ? Theme.quarzo-white : Theme.faded-cancel;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        delete-area := TouchArea {
                            clicked => { delete-clicked(); }
                        }
                    }
                }
            }

            // Server icon
            Text {
                text: "\u{1F4E1}";  // 📡
                font-size: 32px;
                horizontal-alignment: center;
            }

            // Node name
            Text {
                text: name;
                color: Theme.quarzo-white;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            // Connection status
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: is-connected ? Theme.grape-green : Theme.text-passive;
                }

                Text {
                    text: is-connected ? "Connected" : "Offline";
                    color: is-connected ? Theme.grape-green : Theme.text-passive;
                    font-size: 11px;
                }
            }

            // Connection type badge
            Rectangle {
                height: 20px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        background: connection-type == "Owner" ? Theme.grape-green : Theme.active-border;
                        border-radius: 4px;
                        padding-left: 8px;
                        padding-right: 8px;
                        height: 20px;

                        Text {
                            text: connection-type;
                            color: Theme.quarzo-white;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Last connected
            Text {
                text: last-connected;
                color: Theme.text-passive;
                font-size: 10px;
                horizontal-alignment: center;
            }
        }

        card-area := TouchArea {
            clicked => { clicked(); }
        }
    }
}

