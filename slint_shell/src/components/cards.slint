// Card components

import { Theme } from "../theme.slint";
import { AppInfo, PageInfo } from "../types.slint";

// Space card component
export component SpaceCard {
    in property<string> space-id;
    in property<string> name;
    in property<int> app-count;
    callback clicked();

    width: 200px;
    height: 120px;

    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: area.has-hover ? Theme.active-border : Theme.default-border;
        background: area.has-hover ? Theme.side-list-highlight : Theme.frame-black;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: start;

            // Folder icon
            Text {
                text: "\u{1F4C1}";
                font-size: 32px;
            }

            // Space name
            Text {
                text: name;
                color: Theme.quarzo-white;
                font-size: 16px;
                font-weight: 500;
                overflow: elide;
            }

            // App count
            Text {
                text: app-count == 1 ? "1 app" : app-count + " apps";
                color: Theme.text-passive;
                font-size: 12px;
            }
        }

        area := TouchArea {
            clicked => { clicked(); }
        }

        animate border-color { duration: 150ms; }
        animate background { duration: 150ms; }
    }
}

// Create space card (+ button)
export component CreateSpaceCard {
    callback clicked();

    width: 200px;
    height: 120px;

    Rectangle {
        border-radius: 12px;
        border-width: 2px;
        border-color: area.has-hover ? Theme.livnote-lavender : Theme.default-border;
        background: area.has-hover ? #0d0e1380 : transparent;

        VerticalLayout {
            alignment: center;

            Text {
                text: "+";
                color: area.has-hover ? Theme.livnote-lavender : Theme.text-passive;
                font-size: 48px;
                horizontal-alignment: center;
            }
            Text {
                text: "New Space";
                color: area.has-hover ? Theme.livnote-lavender : Theme.text-passive;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        area := TouchArea {
            clicked => { clicked(); }
        }

        animate border-color { duration: 150ms; }
        animate background { duration: 150ms; }
    }
}

