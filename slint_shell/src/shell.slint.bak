// Upload app card (+ button)
component UploadAppCard {
    callback clicked();

    width: 160px;
    height: 100px;

    Rectangle {
        border-radius: 12px;
        border-width: 2px;
        border-color: area.has-hover ? Theme.livnote-lavender : Theme.default-border;
        background: area.has-hover ? #0d0e1380 : transparent;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: "+";
                color: area.has-hover ? Theme.livnote-lavender : Theme.text-passive;
                font-size: 36px;
                horizontal-alignment: center;
            }
            Text {
                text: "Upload App";
                color: area.has-hover ? Theme.livnote-lavender : Theme.text-passive;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }

        area := TouchArea {
            clicked => { clicked(); }
        }

        animate border-color { duration: 150ms; }
        animate background { duration: 150ms; }
    }
}

// Space View screen (inside a space)
component SpaceView {
    in property<string> space-id: "";
    in property<string> space-name: "Space";
    in property<[AppInfo]> apps: [];

    callback go-back();
    callback request-apps(string);      // Called to load apps for this space
    callback upload-app-clicked();      // Called when user wants to upload an app
    callback select-app(string);

    // Responsive grid properties for apps
    property<length> app-card-width: 160px;
    property<length> app-card-spacing: 16px;
    property<length> padding-horizontal: 64px;  // Left + right padding (32px * 2)
    property<length> available-width: root.width - padding-horizontal;
    property<int> app-columns: max(1, floor(available-width / (app-card-width + app-card-spacing)));

    // Request apps when component is shown
    init => { request-apps(space-id); }

    VerticalLayout {
        padding: 32px;
        spacing: 24px;

        // Header with back button
        HorizontalLayout {
            spacing: 16px;

            // Back button
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: back-area.has-hover ? Theme.cancel-background : transparent;

                Text {
                    text: "\u{2190}";
                    color: back-area.has-hover ? Theme.quarzo-white : Theme.text-passive;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                back-area := TouchArea {
                    clicked => { go-back(); }
                }
            }

            // Space name
            Text {
                text: space-name;
                color: Theme.quarzo-white;
                font-size: 28px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // Apps section
        Text {
            text: "Apps";
            color: Theme.text-active;
            font-size: 16px;
            font-weight: 500;
        }

        // App grid (responsive layout)
        Flickable {
            VerticalLayout {
                spacing: app-card-spacing;
                padding: 4px;

                // Row 0
                HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx < app-columns: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length < app-columns: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 1
                if apps.length > app-columns: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns: if idx < app-columns * 2: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns: if apps.length < app-columns * 2: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 2
                if apps.length > app-columns * 2: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 2: if idx < app-columns * 3: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 2: if apps.length < app-columns * 3: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 3
                if apps.length > app-columns * 3: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 3: if idx < app-columns * 4: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 3: if apps.length < app-columns * 4: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 4
                if apps.length > app-columns * 4: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 4: if idx < app-columns * 5: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 4: if apps.length < app-columns * 5: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 5
                if apps.length > app-columns * 5: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 5: if idx < app-columns * 6: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 5: if apps.length < app-columns * 6: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 6
                if apps.length > app-columns * 6: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 6: if idx < app-columns * 7: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 6: if apps.length < app-columns * 7: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 7
                if apps.length > app-columns * 7: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 7: if idx < app-columns * 8: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 7: if apps.length < app-columns * 8: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 8
                if apps.length > app-columns * 8: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 8: if idx < app-columns * 9: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 8: if apps.length < app-columns * 9: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }

                // Row 9
                if apps.length > app-columns * 9: HorizontalLayout {
                    spacing: app-card-spacing;
                    for app[idx] in apps:
                        if idx >= app-columns * 9: if idx < app-columns * 10: AppCard {
                            app-id: app.id;
                            name: app.name;
                            clicked => { select-app(app.id); }
                        }
                    if apps.length >= app-columns * 9: if apps.length < app-columns * 10: UploadAppCard {
                        clicked => { upload-app-clicked(); }
                    }
                }
            }
        }

        // Empty state hint (only when no apps)
        if apps.length == 0: Text {
            text: "Click '+' to upload your first app";
            color: Theme.text-active;
            font-size: 14px;
        }
    }
}

// Main shell component
export component Shell inherits Window {
    title: "Sthalam";
    background: Theme.ninja-black;
    min-width: 800px;
    min-height: 600px;

    // Tab state
    in property<[TabInfo]> tabs: [];
    in property<string> active-tab-id: "";

    // Shell state
    in property<bool> authenticated: false;
    in property<bool> initialized: false;

    // Screen state: "initiation", "signup", "login", "spaces", "space-view", "app"
    in-out property<string> current-screen: "initiation";

    // Space state
    in property<[SpaceInfo]> spaces: [];
    in-out property<string> current-space-id: "";
    in property<[AppInfo]> apps: [];  // apps in current space
    in property<string> current-space-name: "";

    // Callbacks
    callback tab-selected(string);
    callback tab-closed(string);
    callback new-tab();

    // Auth callbacks
    callback login(string);
    callback sign-up(string, string);  // username, password
    callback import-key();

    // Space callbacks
    callback request-spaces();          // UI requests to load spaces
    callback create-space(string);      // name
    callback select-space(string);      // space_id
    callback delete-space(string);      // space_id

    // App callbacks
    callback request-apps(string);      // UI requests apps for space_id
    callback upload-app-clicked();      // User wants to upload an app (opens folder picker)
    callback select-app(string);        // app_id
    callback delete-app(string);        // app_id

    VerticalLayout {
        // Tab bar (only show when authenticated)
        if authenticated: Rectangle {
            height: 52px;
            background: Theme.frame-black;
            border-width: 0px;
            border-color: Theme.dark-separator;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                alignment: start;

                // Tabs
                for tab in tabs: TabButton {
                    title: tab.title;
                    active: tab.id == active-tab-id;
                    clicked => { tab-selected(tab.id); }
                    close-clicked => { tab-closed(tab.id); }
                }

                // New tab button
                NewTabButton {
                    clicked => { new-tab(); }
                }
            }
        }

        // Separator
        if authenticated: Rectangle {
            height: 1px;
            background: Theme.dark-separator;
        }

        // Content area
        Rectangle {
            background: Theme.ninja-black;

            // Initiation screen
            if current-screen == "initiation": InitiationScreen {
                import-key => { import-key(); }
                new-user => { current-screen = "signup"; }
            }

            // Sign up screen
            if current-screen == "signup": SignUpScreen {
                go-back => { current-screen = "initiation"; }
                submit(username, password) => { sign-up(username, password); }
            }

            // Login screen
            if current-screen == "login": WelcomeScreen {
                submit => { login(self.passphrase); }
            }

            // Spaces dashboard (after login)
            if current-screen == "spaces": SpacesDashboard {
                width: 100%;
                height: 100%;
                spaces: spaces;
                request-spaces => { request-spaces(); }
                create-space(name) => {
                    create-space(name);
                }
                select-space(space-id) => {
                    current-space-id = space-id;
                    select-space(space-id);
                    current-screen = "space-view";
                }
            }

            // Space view (inside a space)
            if current-screen == "space-view": SpaceView {
                width: 100%;
                height: 100%;
                space-id: current-space-id;
                space-name: current-space-name;
                apps: apps;
                go-back => { current-screen = "spaces"; }
                request-apps(space-id) => { request-apps(space-id); }
                select-app(app-id) => { select-app(app-id); }
                upload-app-clicked => { upload-app-clicked(); }
            }

            // App content placeholder (when authenticated and in app mode)
            if current-screen == "app": Rectangle {
                // App runtime will inject content here
                Text {
                    text: tabs.length > 0 ? "App content for: " + active-tab-id : "No tabs open. Click + to open a new tab.";
                    color: Theme.text-passive;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
