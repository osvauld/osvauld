            }
            Text {
                text: "New Space";
                color: area.has-hover ? Theme.livnote-lavender : Theme.text-passive;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        area := TouchArea {
            clicked => { clicked(); }
        }

        animate border-color { duration: 150ms; }
        animate background { duration: 150ms; }
    }
}

// Spaces Dashboard screen
component SpacesDashboard {
    in property<[SpaceInfo]> spaces: [];
    in-out property<string> new-space-name: "";
    in-out property<bool> show-create-form: false;

    callback request-spaces();          // Called to load/refresh spaces
    callback create-space(string);
    callback select-space(string);

    // Responsive grid properties
    property<length> card-width: 200px;
    property<length> card-spacing: 16px;
    property<length> padding-horizontal: 64px;  // Left + right padding (32px * 2)
    property<length> available-width: root.width - padding-horizontal;
    property<int> columns: max(1, floor(available-width / (card-width + card-spacing)));

    // Request spaces when component is shown
    init => { request-spaces(); }

    VerticalLayout {
        padding: 32px;
        spacing: 24px;

        // Header
        HorizontalLayout {
            spacing: 16px;

            Text {
                text: "Your Spaces";
                color: Theme.quarzo-white;
                font-size: 28px;
                font-weight: 600;
            }
        }

        // Create form (shown when show-create-form is true)
        if show-create-form: Rectangle {
            height: 60px;
            border-radius: 8px;
            background: Theme.frame-black;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                Rectangle {
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: name-input.has-focus ? Theme.livnote-lavender : Theme.default-border;
                    background: Theme.ninja-black;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        name-input := TextInput {
                            text <=> new-space-name;
                            color: Theme.quarzo-white;
                            font-size: 14px;
                            accepted => {
                                if new-space-name != "" {
                                    create-space(new-space-name);
                                    new-space-name = "";
                                    show-create-form = false;
                                }
                            }
                        }
                    }

                    animate border-color { duration: 150ms; }
                }

                // Create button
                Rectangle {
                    width: 80px;
                    border-radius: 6px;
                    background: new-space-name != "" ? Theme.livnote-lavender : Theme.cancel-background;

                    Text {
                        text: "Create";
                        color: new-space-name != "" ? Theme.ninja-black : Theme.text-passive;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        enabled: new-space-name != "";
                        clicked => {
                            create-space(new-space-name);
                            new-space-name = "";
                            show-create-form = false;
                        }
                    }
                }

                // Cancel button
                Rectangle {
                    width: 80px;
                    border-radius: 6px;
                    background: cancel-area.has-hover ? Theme.cancel-background : transparent;

                    Text {
                        text: "Cancel";
                        color: Theme.text-passive;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-area := TouchArea {
                        clicked => {
                            new-space-name = "";
                            show-create-form = false;
                        }
                    }
                }
            }
        }

        // Space grid (responsive layout)
        Flickable {
            VerticalLayout {
                spacing: card-spacing;
                padding: 4px;

                // Row 0
                HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces: SpaceCard {
                        visible: idx < columns;
                        max-width: idx < columns ? 200px : 0px;
                        space-id: space.id;
                        name: space.name;
                        app-count: space.app-count;
                        clicked => { select-space(space.id); }
                    }
                    if spaces.length < columns: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 1 (conditional - only if needed)
                if spaces.length > columns: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns: if idx < columns * 2: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns: if spaces.length < columns * 2: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 2
                if spaces.length > columns * 2: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 2: if idx < columns * 3: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 2: if spaces.length < columns * 3: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 3
                if spaces.length > columns * 3: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 3: if idx < columns * 4: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 3: if spaces.length < columns * 4: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 4
                if spaces.length > columns * 4: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 4: if idx < columns * 5: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 4: if spaces.length < columns * 5: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 5
                if spaces.length > columns * 5: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 5: if idx < columns * 6: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 5: if spaces.length < columns * 6: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 6
                if spaces.length > columns * 6: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 6: if idx < columns * 7: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 6: if spaces.length < columns * 7: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 7
                if spaces.length > columns * 7: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 7: if idx < columns * 8: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 7: if spaces.length < columns * 8: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 8
                if spaces.length > columns * 8: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 8: if idx < columns * 9: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 8: if spaces.length < columns * 9: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }

                // Row 9
                if spaces.length > columns * 9: HorizontalLayout {
                    spacing: card-spacing;
                    for space[idx] in spaces:
                        if idx >= columns * 9: if idx < columns * 10: SpaceCard {
                            space-id: space.id;
                            name: space.name;
                            app-count: space.app-count;
                            clicked => { select-space(space.id); }
                        }
                    if spaces.length >= columns * 9: if spaces.length < columns * 10: CreateSpaceCard {
                        clicked => { show-create-form = true; }
                    }
                }
            }
        }

        // Empty state message
        if spaces.length == 0 && !show-create-form: VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "No spaces yet";
                color: Theme.text-passive;
                font-size: 18px;
                horizontal-alignment: center;
            }
            Text {
                text: "Create a space to organize your apps";
                color: Theme.text-active;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }
}

