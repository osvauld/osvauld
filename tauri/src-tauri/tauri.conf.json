{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "osvauld",
  "version": "0.1.0",
  "identifier": "com.osvauld.app",
  "build": {
    "beforeDevCommand": "cd ../frontends/packages/password-manager/desktop && pnpm dev",
    "beforeBuildCommand": "cd ../frontends/packages/password-manager/desktop && pnpm build",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "osvauld",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
