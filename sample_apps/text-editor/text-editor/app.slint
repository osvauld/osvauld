// Text Editor — block-based editor.
//
// Each tree node from the `blocks` model renders as a row containing one
// `RichTextEdit`. Hierarchy is reconstructed from `block.depth` (indent).
// Key intercept lets us turn Enter into "split block" and Backspace at
// position 0 into "delete empty block & focus previous" — see app.lua.

import { RichTextEdit } from "@osvauld/widgets.slint";
import { ScrollView } from "std-widgets.slint";

struct BlockProps {
    kind: string,
    text: string,
}

struct BlockData {
    id: string,
    parent: string,
    depth: int,
    index: int,
    props: BlockProps,
}

export global AppAPI {
    // Bound by `scribe:bind_tree("blocks", DOC)`.
    in-out property <[BlockData]> blocks;
    // Lua sets this after creating a new block to land the cursor there.
    // The matching row reacts to the change and calls editor.focus().
    in-out property <string> focus_block_id;
    // Last block to gain focus. The toolbar reads this so clicks on
    // P/H1/H2/Code mutate the right block. Pure Slint-side state — never
    // round-trips through Lua, so it stays responsive even mid-keystroke.
    in-out property <string> active_block_id;

    // The renderer only auto-wires a small set of generic AppAPI callbacks
    // (`on_field_changed`, `on_submit`, etc.) to Lua — see
    // `renderer_slint/src/slint_runtime.rs::setup_global_callbacks`. App-
    // specific callback names declared here would fire in Slint but never
    // reach Lua. So we multiplex all editor events through `on_field_changed`
    // using an action-prefixed `field` argument:
    //   "text:<node_id>"      → block text edited (value = new text)
    //   "enter:<node_id>"     → plain Enter pressed (split block)
    //   "backspace:<node_id>" → Backspace at offset 0 (delete-empty)
    //   "kind:<node_id>"      → toolbar set kind (value = "p"|"h1"|"h2"|"code")
    // The Lua side parses the prefix and dispatches.
    callback on_field_changed(string /* field */, string /* value */);
}

export component App inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    title: "Text Editor";

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "Text Editor (block-based)";
            font-size: 18px;
            font-weight: 700;
        }

        // Toolbar — set the kind on the active block. Buttons are disabled
        // when no block is active (i.e., nothing is focused yet). We don't
        // refocus the editor after a click; for the MVP the click steals
        // focus and the user re-clicks the editor to keep typing.
        HorizontalLayout {
            spacing: 4px;
            for kind in ["p", "h1", "h2", "code", "list_item"]: Rectangle {
                width: 48px;
                height: 28px;
                border-width: 1px;
                border-color: #cccccc;
                border-radius: 4px;
                background: ta.has-hover ? #eeeeee : white;
                opacity: AppAPI.active_block_id == "" ? 0.4 : 1.0;
                Text {
                    text: kind;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ta := TouchArea {
                    enabled: AppAPI.active_block_id != "";
                    clicked => {
                        AppAPI.on_field_changed("kind:" + AppAPI.active_block_id, kind);
                    }
                }
            }
            // Spacer so buttons don't stretch.
            Rectangle { horizontal-stretch: 1; }
        }

        ScrollView {
            VerticalLayout {
                spacing: 4px;
                // Stack rows from the top and let each one hug its content.
                // Without this, the layout distributes ScrollView's full
                // height across rows and every block balloons to ~150px tall.
                alignment: start;

                for block[i] in AppAPI.blocks: HorizontalLayout {
                    spacing: 4px;
                    // Hug content vertically — never absorb leftover space.
                    vertical-stretch: 0;
                    // Tracks whether *this* row currently owns focus per AppAPI.
                    // Slint's `changed <prop>` callback fires each time the
                    // bound expression's value flips, so when Lua sets
                    // focus_block_id to this row's id we run editor.focus().
                    property <bool> wants-focus: block.id == AppAPI.focus_block_id && AppAPI.focus_block_id != "";
                    changed wants-focus => {
                        if (self.wants-focus) {
                            editor.focus();
                        }
                    }

                    // Indent column — `block.depth * 24px`. Drives nesting
                    // for list_items via Tab / Shift-Tab.
                    Rectangle {
                        width: block.depth * 24px;
                    }

                    // Bullet glyph for list_items. Other kinds get no prefix.
                    // Width is fixed regardless of kind so columns line up.
                    Rectangle {
                        width: 16px;
                        Text {
                            text: block.props.kind == "list_item" ? "•" : "";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 16px;
                        }
                    }

                    Rectangle {
                        border-width: 1px;
                        border-color: editor.has-focus ? #6699ff : #cccccc;
                        border-radius: 4px;
                        background: white;
                        horizontal-stretch: 1;
                        // `external-text` mirrors block.props.text from the
                        // model. The `changed` callback below pushes external
                        // updates *into* the TextInput only when they don't
                        // already match — that way local typing isn't fighting
                        // a reactive binding (which Slint would otherwise
                        // discard the keystroke for) and remote updates from
                        // bob still land in alice's view.
                        // While *this* editor has focus, the user owns the
                        // text. Echoes of their own keystrokes round-trip
                        // back through the CRDT slower than they can type,
                        // so applying them would clobber typed-ahead chars.
                        // Remote edits to a focused block are deferred until
                        // focus leaves — acceptable for MVP (live remote-cursor
                        // co-editing is a Loro Awareness story, see roadmap).
                        property <string> external-text: block.props.text;
                        changed external-text => {
                            if (self.external-text != editor.text && !editor.has-focus) {
                                editor.text = self.external-text;
                            }
                        }

                        HorizontalLayout {
                            padding: 8px;

                            editor := RichTextEdit {
                                init => {
                                    self.text = block.props.text;
                                }
                                // Track which block last had focus so the
                                // toolbar knows what to mutate. We only set
                                // (never clear) on focus loss, so clicking a
                                // toolbar button — which steals focus — still
                                // remembers the previously-focused block.
                                changed has-focus => {
                                    if (self.has-focus) {
                                        AppAPI.active_block_id = block.id;
                                    }
                                }
                                // Variable type sizing — heading kinds render bigger.
                                font-size: block.props.kind == "h1" ? 24px
                                         : block.props.kind == "h2" ? 18px
                                         : 14px;
                                edited(t) => {
                                    AppAPI.on_field_changed("text:" + block.id, t);
                                }
                                key-pressed(event) => {
                                    // Plain Enter (without Shift) → split block.
                                    // Shift+Enter falls through to TextInput's
                                    // default newline-insert so the user can
                                    // still create soft breaks within a block.
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        AppAPI.on_field_changed("enter:" + block.id, "");
                                        return EventResult.accept;
                                    }
                                    // Backspace at offset 0 with no selection →
                                    // hand off to Lua. Lua deletes if the block
                                    // is empty, otherwise returns silently and
                                    // we still preventDefault — the editor MVP
                                    // chooses to never auto-merge text yet.
                                    // (Step B will implement the merge path.)
                                    if (event.text == Key.Backspace
                                        && self.cursor-position == 0
                                        && self.anchor-position == 0) {
                                        AppAPI.on_field_changed("backspace:" + block.id, "");
                                        return EventResult.accept;
                                    }
                                    // Tab / Shift-Tab on list_items adjust
                                    // nesting via tree:move on the Lua side.
                                    // Lua silently no-ops on non-list blocks
                                    // and at edges (no prev sibling for indent,
                                    // already-root for outdent), so we can
                                    // unconditionally accept here without
                                    // teaching Slint about kind/depth.
                                    if (event.text == Key.Tab && !event.modifiers.shift) {
                                        AppAPI.on_field_changed("indent:" + block.id, "");
                                        return EventResult.accept;
                                    }
                                    if (event.text == Key.Tab && event.modifiers.shift) {
                                        AppAPI.on_field_changed("outdent:" + block.id, "");
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
