{
    "owner_template": {
        "operations": {
            "own": "allow",
            "read": "allow",
            "write": "allow",
            "share": "allow",
            "share_page": "allow"
        },
        "layers": {
            "products": {
                "type": "list",
                "sync": true,
                "capability": "owner"
            },
            "*:order": {
                "type": "map",
                "sync": true,
                "capability": "viewer"
            }
        },
        "delegation": {
            "node": {
                "token_type": "page_share",
                "operations": {
                    "share_page": "allow"
                },
                "layers": {
                    "products": {
                        "type": "list",
                        "sync": true,
                        "capability": "viewer"
                    }
                },
                "auth_capabilities": {
                    "can_connect": true,
                    "persist_share": true,
                    "can_delegate": true,
                    "sync_enabled": true
                },
                "relationship": "node"
            },
            "customer": {
                "token_type": "page_viewer",
                "operations": {
                    "read": "allow",
                    "write": "allow"
                },
                "layers": {
                    "products": {
                        "type": "list",
                        "sync": true,
                        "capability": "viewer"
                    }
                },
                "layer_patterns": {
                    "{aud}:order": {
                        "create": true,
                        "sync": true
                    }
                },
                "auth_capabilities": {
                    "can_connect": true,
                    "sync_enabled": true
                },
                "relationship": "viewer"
            }
        }
    },
    "consent_template": {
        "token_type": "sync_page_consent",
        "operations": {
            "receive_layer_updates": "allow",
            "send_layer_updates": "allow"
        },
        "layers": {
            "products": {
                "sync": true,
                "capability": "viewer"
            }
        },
        "auth_capabilities": {
            "accept_sync": true,
            "can_send": true
        },
        "relationship": "sync_consent"
    }
}
