{
    "owner_template": {
        "operations": {
            "own": "allow",
            "read": "allow",
            "write": "allow",
            "share": "allow",
            "share_page": "allow"
        },
        "peer_capabilities": {
            "relay": false,
            "share": true,
            "accept_publish": true
        },
        "layers": {
            "{page_id}/products": {
                "type": "list",
                "sync": true,
                "write": true
            },
            "{page_id}/derived/orders_summary": {
                "type": "map",
                "sync": true,
                "write": false
            },
            "{page_id}/drafts": {
                "type": "map",
                "sync": false,
                "create": true
            },
            "app:Shop Owner": {
                "type": "map",
                "sync": true,
                "write": true
            },
            "app:Shop Customer": {
                "type": "map",
                "sync": true,
                "write": true
            },
            "app:shared": {
                "type": "map",
                "sync": true,
                "write": true
            }
        },
        "layer_patterns": {
            "{page_id}/orders/*": {
                "sync": true,
                "write": true
            }
        },
        "issue_on": {
            "node": {
                "token_type": "page_share",
                "peer_capabilities": {
                    "relay": true,
                    "share": true,
                    "accept_publish": true
                },
                "operations": {
                    "share_page": "allow",
                    "add_pages": "allow"
                },
                "layers": {
                    "{page_id}/products": {
                        "type": "list",
                        "sync": true,
                        "write": false
                    },
                    "{page_id}/derived/orders_summary": {
                        "type": "map",
                        "sync": true,
                        "write": true
                    },
                    "app:Shop Customer": {
                        "type": "map",
                        "sync": true,
                        "write": false
                    },
                    "app:shared": {
                        "type": "map",
                        "sync": true,
                        "write": false
                    }
                },
                "layer_patterns": {
                    "{page_id}/orders/*": {
                        "sync": true,
                        "create": true
                    }
                },
                "auth_capabilities": {
                    "can_connect": true,
                    "persist_share": true,
                    "can_delegate": true,
                    "sync_enabled": true
                },
                "relationship": "node",
                "issue_on": {
                    "viewer": {
                        "token_type": "page_viewer",
                        "peer_capabilities": {
                            "relay": false,
                            "share": false,
                            "accept_publish": false
                        },
                        "operations": {
                            "read": "allow",
                            "write": "allow"
                        },
                        "layers": {
                            "{page_id}/products": {
                                "type": "list",
                                "sync": true,
                                "write": false
                            },
                            "{page_id}/drafts": {
                                "type": "map",
                                "sync": false,
                                "create": true
                            },
                            "app:Shop Customer": {
                                "type": "map",
                                "sync": true,
                                "write": false
                            }
                        },
                        "layer_patterns": {
                            "{page_id}/orders/{aud}": {
                                "write": true,
                                "sync": true
                            }
                        },
                        "auth_capabilities": {
                            "can_connect": true,
                            "sync_enabled": true
                        },
                        "relationship": "customer"
                    }
                }
            },
            "customer": {
                "token_type": "page_viewer",
                "peer_capabilities": {
                    "relay": false,
                    "share": false,
                    "accept_publish": false
                },
                "operations": {
                    "read": "allow",
                    "write": "allow"
                },
                "layers": {
                    "{page_id}/products": {
                        "type": "list",
                        "sync": true,
                        "write": false
                    },
                    "{page_id}/drafts": {
                        "type": "map",
                        "sync": false,
                        "create": true
                    },
                    "app:Shop Customer": {
                        "type": "map",
                        "sync": true,
                        "write": false
                    }
                },
                "layer_patterns": {
                    "{page_id}/orders/{aud}": {
                        "write": true,
                        "sync": true
                    }
                },
                "auth_capabilities": {
                    "can_connect": true,
                    "sync_enabled": true
                },
                "relationship": "customer"
            },
            "admin": {
                "token_type": "page_admin",
                "peer_capabilities": {
                    "relay": false,
                    "share": false,
                    "accept_publish": false
                },
                "operations": {
                    "read": "allow",
                    "write": "allow"
                },
                "layers": {
                    "{page_id}/products": {
                        "type": "list",
                        "sync": true,
                        "write": true
                    }
                },
                "layer_patterns": {
                    "{page_id}/orders/*": {
                        "sync": true
                    }
                },
                "auth_capabilities": {
                    "can_connect": true,
                    "sync_enabled": true
                },
                "relationship": "admin"
            }
        }
    },
    "consent_template": {
        "token_type": "sync_page_consent",
        "peer_capabilities": {
            "relay": false,
            "share": false,
            "accept_publish": false
        },
        "operations": {
            "receive_layer_updates": "allow",
            "send_layer_updates": "allow"
        },
        "layers": {
            "{page_id}/products": {
                "sync": true,
                "write": false
            },
            "app:Shop Customer": {
                "sync": true,
                "write": false
            },
            "app:shared": {
                "sync": true,
                "write": false
            }
        },
        "layer_patterns": {
            "{page_id}/orders/*": {
                "sync": true
            }
        },
        "auth_capabilities": {
            "accept_sync": true,
            "can_send": true
        },
        "relationship": "sync_consent"
    }
}
