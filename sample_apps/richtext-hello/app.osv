app "richtext-hello" version "0.1.0" {
  role owner can share, delegate, accept_publish, manage_access;
  role node can relay, share, accept_publish, manage_access;
  role collaborator can manage_access;

  layer doc as map {
    path doc;
    namespace shared;
    allow owner, collaborator to read, write, sync;
    allow node to read, sync;
  }

  ui_app "RichText Hello" {
    allow owner, collaborator;
  }
}
