// RichText Hello — minimal smoke test for @osvauld/widgets RichTextEdit

import { RichTextEdit } from "@osvauld/widgets.slint";

export global AppAPI {
    in-out property <string> doc_text: "";

    // Generic Event Bus callback wired to Lua on_field_changed(field, value)
    callback on_field_changed(string, string);
}

export component App inherits Window {
    preferred-width: 600px;
    preferred-height: 400px;
    title: "RichText Hello";

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "RichTextEdit smoke test";
            font-size: 18px;
            font-weight: 700;
        }

        Rectangle {
            border-width: 1px;
            border-color: #cccccc;
            border-radius: 4px;

            editor := RichTextEdit {
                width: 100%;
                height: 100%;
                text <=> AppAPI.doc_text;
                font-size: 14px;
                edited(t) => {
                    AppAPI.on_field_changed("body", t);
                }
            }
        }
    }
}
