import { Button, VerticalBox, HorizontalBox, ListView, ScrollView } from "std-widgets.slint";

// Entry data model
export struct EntryInfo {
    id: string,
    name: string,
    email: string,
    timestamp: string,
}

// App is a component (not Window) - browser provides the window
export component App inherits Rectangle {
    background: #1a1a2e;

    // Callbacks to Lua
    callback remove_entry(string);
    callback refresh_entries();

    // Data from Lua
    in property <[EntryInfo]> entries: [];
    in property <int> entry_count: 0;

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        HorizontalBox {
            spacing: 16px;

            Text {
                text: "Waitlist Entries";
                font-size: 24px;
                font-weight: 700;
                color: #eee;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "\{entry_count} entries";
                font-size: 14px;
                color: #888;
                vertical-alignment: center;
            }

            Button {
                text: "Refresh";
                clicked => { refresh_entries(); }
            }
        }

        Rectangle {
            height: 1px;
            background: #333;
        }

        // Header row
        HorizontalBox {
            height: 32px;
            spacing: 8px;
            padding-left: 12px;
            padding-right: 12px;

            Text {
                width: 150px;
                text: "Name";
                font-size: 12px;
                font-weight: 600;
                color: #888;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: "Email";
                font-size: 12px;
                font-weight: 600;
                color: #888;
                vertical-alignment: center;
            }

            Text {
                width: 120px;
                text: "Signed Up";
                font-size: 12px;
                font-weight: 600;
                color: #888;
                vertical-alignment: center;
            }

            Text {
                width: 60px;
                text: "";
                vertical-alignment: center;
            }
        }

        // Entries list
        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 4px;

                for entry in entries: Rectangle {
                    height: 48px;
                    background: #252538;
                    border-radius: 8px;

                    HorizontalBox {
                        spacing: 8px;
                        padding: 12px;

                        Text {
                            width: 150px;
                            text: entry.name;
                            font-size: 14px;
                            color: #eee;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: entry.email;
                            font-size: 14px;
                            color: #aaa;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            width: 120px;
                            text: entry.timestamp;
                            font-size: 12px;
                            color: #666;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 60px;
                            clicked => { remove_entry(entry.id); }

                            Rectangle {
                                background: parent.has-hover ? #f8717133 : transparent;
                                border-radius: 4px;

                                Text {
                                    text: "Remove";
                                    font-size: 11px;
                                    color: #f87171;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Empty state
        if entry_count == 0: Rectangle {
            vertical-stretch: 1;

            Text {
                text: "No entries yet";
                font-size: 16px;
                color: #666;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
