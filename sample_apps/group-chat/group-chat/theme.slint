// Slack-like dark theme colors

export global Theme {
    // Backgrounds
    out property<color> bg-workspace: #1a1d21;
    out property<color> bg-channel: #222529;
    out property<color> bg-hover: #2c2d30;
    out property<color> bg-active: #1264a3;
    out property<color> bg-input: #22252a;
    out property<color> bg-message-hover: #27282b;

    // Text
    out property<color> text-primary: #d1d2d3;
    out property<color> text-secondary: #ababad;
    out property<color> text-bright: #f8f8f8;

    // Accents
    out property<color> accent: #1264a3;
    out property<color> green-online: #2bac76;
    out property<color> red-danger: #e74c4c;

    // Borders
    out property<color> border: #3a3b3d;
    out property<color> border-light: #49494d;

    // Misc
    out property<color> reaction-bg: #2c2d30;
    out property<color> reaction-mine: #1d4f7a;
    out property<color> unread-badge: #e74c4c;
    out property<color> mention-badge: #e74c4c;
}
