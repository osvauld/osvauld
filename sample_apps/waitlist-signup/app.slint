import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

// App is a component (not Window) - browser provides the window
export component App inherits Rectangle {
    background: #1a1a2e;

    // Callbacks to Lua
    callback submit_entry(string, string);

    // Entry count from Lua
    in property <int> entry_count: 0;

    // Status message
    in property <string> status_message: "";

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Join the Waitlist";
            font-size: 24px;
            font-weight: 700;
            color: #eee;
            horizontal-alignment: center;
        }

        Text {
            text: entry_count > 0 ? "\{entry_count} people already signed up!" : "Be the first to join!";
            font-size: 14px;
            color: #888;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: #333;
        }

        name_input := LineEdit {
            placeholder-text: "Your name";
            font-size: 14px;
        }

        email_input := LineEdit {
            placeholder-text: "your@email.com";
            font-size: 14px;
        }

        Button {
            text: "Join Waitlist";
            primary: true;
            clicked => {
                if name_input.text != "" && email_input.text != "" {
                    submit_entry(name_input.text, email_input.text);
                    name_input.text = "";
                    email_input.text = "";
                }
            }
        }

        Text {
            text: status_message;
            font-size: 12px;
            color: status_message == "Added to waitlist!" ? #4ade80 : #f87171;
            horizontal-alignment: center;
        }
    }
}
