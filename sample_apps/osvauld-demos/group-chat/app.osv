app "group-chat" version "2.0.0" {
  role owner can share, delegate, accept_publish, manage_access;
  role node can relay, share, accept_publish, manage_access;
  role collaborator can manage_access;
  role layer_authority can manage_access;

  // Static app layer — owner can write, others read-only
  layer app_data as map {
    path app_data;
    namespace shared;
    allow owner to read, write, sync;
    allow node, collaborator, layer_authority to read, sync;
  }

  // Presence layer — all roles can read/write/sync
  layer presence as map {
    path presence;
    namespace shared;
    allow owner, node, collaborator, layer_authority to read, write, sync;
  }

  // Dynamic per-channel messages (shared — no DID prefix)
  layer channel_messages as map {
    path channels / {id} / messages;
    namespace shared;
    dynamic by id;
    create allow owner, collaborator, node;
    discover on sync;
    allow owner, node, collaborator, layer_authority to read, write, sync;
  }

  // Dynamic DM messages — explicit grant, page-scoped
  layer dm_messages as map {
    path dms / {id} / messages;
    namespace page;
    dynamic by id;
    create allow owner, collaborator;
    discover on grant;
    grant explicit;
    allow owner, node, collaborator, layer_authority to read, write, sync;
    allow owner, layer_authority to grant, revoke;
  }

  // Time-sharded channel messages (shared namespace)
  layer channel_messages_sharded as map {
    path channels / {channel} / messages / {period};
    namespace shared;
    dynamic by channel;
    create allow owner, collaborator, node;
    discover on sync;
    shard by day;
    allow owner, node, collaborator, layer_authority to read, write, sync;
  }

  ui_app "Group Chat" {
    allow owner, collaborator, node;
  }
}
