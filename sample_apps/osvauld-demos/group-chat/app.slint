// Group Chat App UI
// Real-time messaging with emoji support and typing indicators
// Supports Unicode including Malayalam (മലയാളം)

// Reaction data structure
export struct Reaction {
    emoji: string,
    count: int,
    has_my_reaction: bool,
}

// Message data structure
export struct Message {
    id: string,
    sender: string,
    sender_short: string,
    text: string,
    timestamp: string,
    is_mine: bool,
    deleted: bool,
    reply_to: string,
    reply_preview: string,
    reactions: [Reaction],
}

// Emoji entry for picker
export struct EmojiEntry {
    name: string,
    char: string,
}

// Theme colors
global Theme {
    out property<color> bg-primary: #0f172a;
    out property<color> bg-secondary: #1e293b;
    out property<color> bg-card: #334155;
    out property<color> border: #475569;
    out property<color> text-primary: #f1f5f9;
    out property<color> text-secondary: #94a3b8;
    out property<color> accent: #3b82f6;
    out property<color> mine-bg: #1e40af;
    out property<color> other-bg: #374151;
}

// App API
export global AppAPI {
    // Messages
    in-out property<[Message]> messages: [];

    // Input state
    in-out property<string> draft_text: "";
    in-out property<bool> show_emoji_picker: false;

    // Typing indicator
    in-out property<string> typing_text: "";

    // Online users
    in-out property<int> online_count: 1;

    // Context menu state
    in-out property<bool> context_menu_visible: false;
    in-out property<string> selected_message_id: "";

    // Reply state
    in-out property<string> replying_to_id: "";
    in-out property<string> replying_to_text: "";

    callback on_click(string);
    callback on_text_input(string);
    callback on_submit();
}

export component App inherits Rectangle {
    background: Theme.bg-primary;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Header
        Rectangle {
            height: 60px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Chat icon
                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: Theme.accent;
                    border-radius: 20px;

                    Text {
                        text: "Chat";
                        font-size: 12px;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: "Group Chat";
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: AppAPI.online_count + " online";
                        font-size: 12px;
                        color: #22c55e;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: AppAPI.messages.length + " messages";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        // Messages area
        Flickable {
            vertical-stretch: 1;
            viewport-height: messages-content.preferred-height;

            messages-content := VerticalLayout {
                padding: 16px;
                spacing: 8px;

                if AppAPI.messages.length == 0: Rectangle {
                    height: 200px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "No messages yet";
                            font-size: 16px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Start the conversation!";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                for msg in AppAPI.messages: HorizontalLayout {
                    spacing: 8px;

                    if msg.is_mine: Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 0;

                        // Sender name
                        Text {
                            text: msg.sender_short;
                            font-size: 10px;
                            color: msg.is_mine ? Theme.accent : Theme.text-secondary;
                            horizontal-alignment: msg.is_mine ? right : left;
                        }

                        // Message bubble with dropdown menu
                        HorizontalLayout {
                            spacing: 4px;

                            // Dropdown button (left side for my messages)
                            if msg.is_mine: msg-menu-btn-left := Rectangle {
                                width: 32px;
                                height: 32px;
                                background: msg-menu-area-left.has-hover ? Theme.bg-secondary.transparentize(0.3) : transparent;
                                border-radius: 6px;

                                Text {
                                    text: "▼";
                                    font-size: 12px;
                                    color: msg-menu-area-left.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                msg-menu-area-left := TouchArea {
                                    clicked => {
                                        AppAPI.on_click("toggle_menu:" + msg.id);
                                    }
                                }
                            }

                            Rectangle {
                                min-width: 200px;
                                max-width: 600px;
                                background: msg.is_mine ? Theme.mine-bg : Theme.other-bg;
                                border-radius: 12px;

                                VerticalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 4px;

                                    // Reply indicator
                                    if msg.reply_to != "": Rectangle {
                                        background: Theme.bg-secondary.transparentize(0.5);
                                        border-radius: 4px;
                                        height: 40px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;

                                            Text {
                                                text: "↩️ " + msg.reply_preview;
                                                color: Theme.text-secondary;
                                                font-size: 14px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Message text
                                    Text {
                                        text: msg.deleted ? "[Message deleted]" : msg.text;
                                        font-size: 14px;
                                        color: msg.deleted ? Theme.text-secondary : Theme.text-primary;
                                        font-italic: msg.deleted;
                                        wrap: word-wrap;
                                    }

                                    // Reactions
                                    if msg.reactions.length > 0: HorizontalLayout {
                                        spacing: 4px;
                                        padding-top: 4px;

                                        for reaction in msg.reactions: Rectangle {
                                            background: reaction.has_my_reaction ? Theme.accent.transparentize(0.7) : Theme.bg-secondary;
                                            border-radius: 12px;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 2px;

                                                Text {
                                                    text: reaction.emoji + " " + reaction.count;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                clicked => { AppAPI.on_click("toggle_reaction:" + msg.id + ":" + reaction.emoji); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Dropdown button (right side for other messages)
                            if !msg.is_mine: msg-menu-btn-right := Rectangle {
                                width: 32px;
                                height: 32px;
                                background: msg-menu-area-right.has-hover ? Theme.bg-secondary.transparentize(0.3) : transparent;
                                border-radius: 6px;

                                Text {
                                    text: "▼";
                                    font-size: 12px;
                                    color: msg-menu-area-right.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                msg-menu-area-right := TouchArea {
                                    clicked => {
                                        AppAPI.on_click("toggle_menu:" + msg.id);
                                    }
                                }
                            }
                        }

                        // Timestamp
                        Text {
                            text: msg.timestamp;
                            font-size: 10px;
                            color: Theme.text-secondary;
                            horizontal-alignment: msg.is_mine ? right : left;
                        }

                        // Local context menu for this message
                        if AppAPI.context_menu_visible && AppAPI.selected_message_id == msg.id: Rectangle {
                            width: 200px;
                            height: 132px;
                            background: Theme.bg-card;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border.transparentize(0.3);
                            drop-shadow-color: #00000060;
                            drop-shadow-blur: 16px;
                            drop-shadow-offset-y: 6px;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;

                                // React option
                                menu-item-react := Rectangle {
                                    height: 38px;
                                    background: touch-react.has-hover ? Theme.bg-secondary : transparent;
                                    border-radius: 6px;

                                    touch-react := TouchArea {
                                        clicked => { AppAPI.on_click("context_menu:react"); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Text {
                                            text: "😊";
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "React";
                                            color: Theme.text-primary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Separator
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border.transparentize(0.7);
                                }

                                // Reply option
                                menu-item-reply := Rectangle {
                                    height: 38px;
                                    background: touch-reply.has-hover ? Theme.bg-secondary : transparent;
                                    border-radius: 6px;

                                    touch-reply := TouchArea {
                                        clicked => { AppAPI.on_click("context_menu:reply"); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Text {
                                            text: "↩️";
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Reply";
                                            color: Theme.text-primary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Separator
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border.transparentize(0.7);
                                }

                                // Delete option
                                menu-item-delete := Rectangle {
                                    height: 38px;
                                    background: touch-delete.has-hover ? #ef444420 : transparent;
                                    border-radius: 6px;

                                    touch-delete := TouchArea {
                                        clicked => { AppAPI.on_click("context_menu:delete"); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Text {
                                            text: "🗑️";
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Delete";
                                            color: #ef4444;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if !msg.is_mine: Rectangle { horizontal-stretch: 1; }
                }

                // Typing indicator
                if AppAPI.typing_text != "": HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        width: 60px;
                        height: 24px;
                        background: Theme.other-bg;
                        border-radius: 12px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Rectangle { width: 6px; height: 6px; background: Theme.text-secondary; border-radius: 3px; }
                            Rectangle { width: 6px; height: 6px; background: Theme.text-secondary; border-radius: 3px; }
                            Rectangle { width: 6px; height: 6px; background: Theme.text-secondary; border-radius: 3px; }
                        }
                    }

                    Text {
                        text: AppAPI.typing_text;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // Emoji picker (overlay)
        if AppAPI.show_emoji_picker: Rectangle {
            height: 200px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: "Emoji";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: Theme.bg-card;
                        border-radius: 4px;

                        Text {
                            text: "x";
                            font-size: 14px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { AppAPI.on_click("emoji_picker:close"); }
                        }
                    }
                }

                // Emoji grid - row 1
                HorizontalLayout {
                    spacing: 4px;

                    for emoji in [
                        { name: "Smile", char: "😀" },
                        { name: "Laugh", char: "😂" },
                        { name: "Heart", char: "❤️" },
                        { name: "Thumbs", char: "👍" },
                        { name: "Fire", char: "🔥" },
                        { name: "Party", char: "🎉" },
                        { name: "Rocket", char: "🚀" },
                        { name: "Star", char: "⭐" },
                        { name: "Check", char: "✅" },
                        { name: "Wave", char: "👋" },
                    ]: Rectangle {
                        width: 40px;
                        height: 40px;
                        background: emoji-area.has-hover ? Theme.bg-card : transparent;
                        border-radius: 8px;

                        Text {
                            text: emoji.char;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        emoji-area := TouchArea {
                            clicked => { AppAPI.on_click("emoji:" + emoji.name); }
                        }
                    }
                }

                // Emoji grid - row 2
                HorizontalLayout {
                    spacing: 4px;

                    for emoji in [
                        { name: "Eyes", char: "👀" },
                        { name: "Think", char: "🤔" },
                        { name: "Clap", char: "👏" },
                        { name: "100", char: "💯" },
                        { name: "Sad", char: "😢" },
                        { name: "Angry", char: "😠" },
                        { name: "Cool", char: "😎" },
                        { name: "Wink", char: "😉" },
                        { name: "LOL", char: "🤣" },
                        { name: "Love", char: "😍" },
                    ]: Rectangle {
                        width: 40px;
                        height: 40px;
                        background: emoji-area2.has-hover ? Theme.bg-card : transparent;
                        border-radius: 8px;

                        Text {
                            text: emoji.char;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        emoji-area2 := TouchArea {
                            clicked => { AppAPI.on_click("emoji:" + emoji.name); }
                        }
                    }
                }
            }
        }

        // Reply indicator above input
        if AppAPI.replying_to_id != "": Rectangle {
            height: 50px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding: 12px;
                spacing: 8px;

                // Empty space for emoji button alignment
                Rectangle {
                    width: 44px;
                }

                // Reply preview (same width as text input)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 44px;
                    background: Theme.bg-card.transparentize(0.3);
                    border-radius: 22px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "↩️ Replying to: " + AppAPI.replying_to_text;
                            color: Theme.text-secondary;
                            font-size: 14px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        TouchArea {
                            width: 24px;
                            height: 24px;
                            clicked => { AppAPI.on_click("cancel_reply"); }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: touch-cancel.has-hover ? Theme.bg-secondary : transparent;
                                border-radius: 12px;

                                Text {
                                    text: "✕";
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                touch-cancel := TouchArea {
                                    clicked => { AppAPI.on_click("cancel_reply"); }
                                }
                            }
                        }
                    }
                }

                // Empty space for send button alignment
                Rectangle {
                    width: 44px;
                }
            }
        }

        // Input area
        Rectangle {
            height: 70px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding: 12px;
                spacing: 8px;

                // Emoji button
                Rectangle {
                    width: 44px;
                    height: 44px;
                    background: AppAPI.show_emoji_picker ? Theme.accent : Theme.bg-card;
                    border-radius: 22px;

                    Text {
                        text: ":)";
                        font-size: 18px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { AppAPI.on_click("emoji_picker:toggle"); }
                    }
                }

                // Text input
                Rectangle {
                    horizontal-stretch: 1;
                    height: 44px;
                    background: Theme.bg-card;
                    border-radius: 22px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;

                        input := TextInput {
                            text <=> AppAPI.draft_text;
                            font-size: 14px;
                            color: Theme.text-primary;
                            vertical-alignment: center;

                            edited => { AppAPI.on_text_input(self.text); }
                            accepted => { AppAPI.on_submit(); }
                        }
                    }

                    if AppAPI.draft_text == "": Text {
                        text: "Type a message...";
                        font-size: 14px;
                        color: Theme.text-secondary;
                        x: 16px;
                        vertical-alignment: center;
                    }
                }

                // Send button
                Rectangle {
                    width: 44px;
                    height: 44px;
                    background: AppAPI.draft_text != "" ? Theme.accent : Theme.bg-card;
                    border-radius: 22px;

                    Text {
                        text: ">";
                        font-size: 20px;
                        font-weight: 700;
                        color: AppAPI.draft_text != "" ? white : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            if AppAPI.draft_text != "" {
                                AppAPI.on_submit();
                            }
                        }
                    }
                }
            }
        }
    }
}
