{
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"composite": true,
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"checkJs": true,
		"types": [
			"svelte"
		],
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"declaration": true,
		"declarationMap": true,
		"allowJs": true,
		"isolatedModules": true
	},
	"include": [
		"utils/**/*.ts",
		"dtos/**/*.ts",
		"icons/**/*.svelte",
		"components/**/*.svelte",
		"i18n/**/*.ts",
		"*.ts"
	],
	"exclude": [
		"node_modules/*",
		"*.wasm"
	]
}