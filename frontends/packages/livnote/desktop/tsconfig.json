{
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"composite": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"checkJs": true,
		"types": [
			"svelte"
		],
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
    "paths": {
			"@osvauld/password-manager-common": [
				"../common"
			],
			"@osvauld/password-manager-common/*": [
				"../common/*"
			],
			"@osvauld/password-manager-common/utils/*": [
				"../common/utils/*"
			],
			"@osvauld/password-manager-common/components/*": [
				"../common/components/*"
			],
			"@osvauld/password-manager-common/icons/*": [
				"../common/icons/*"
			],
			"@osvauld/password-manager-common/i18n/*": [
				"../common/i18n/*"
			],
			"@osvauld/password-manager-common/dtos/*": [
				"../common/dtos/*"
			]
		},
		"allowJs": true,
		"isolatedModules": true
	},
	"include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "components/**/*.ts",
    "components/**/*.js",
    "components/**/*.svelte",
    "types/**/*.ts",
		 "store/**/*.ts"
  ],
	"exclude": [
		"node_modules/*"
	],
	"references": [
		{
			"path": "../../common"
		}
	]
}
