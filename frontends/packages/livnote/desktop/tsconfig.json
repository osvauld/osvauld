{
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"composite": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"checkJs": true,
		"types": [
			"svelte"
		],
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@osvauld/password-manager-common": [
				"../common"
			],
			"@osvauld/password-manager-common/*": [
				"../common/*"
			]
		},
		"allowJs": true,
		"isolatedModules": true
	},
	"include": [
    "lib/**/*.ts",
    "lib/*.ts",
    "lib/**/*.svelte",
    "lib/*.svelte",
	],
	"exclude": [
		"node_modules/*",
	],
	"references": [
		{
			"path": "../../common"
		}
	]
}
